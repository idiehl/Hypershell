{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hypershell:schema:extension-manifest:1",
  "title": "Hypershell extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "publisher",
    "version",
    "runtime",
    "requestedCapabilities",
    "contributions"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string", "maxLength": 500 },
    "runtime": {
      "enum": ["ContentOnly", "WebView", "NativeDotNet"]
    },
    "entryPoint": { "$ref": "#/$defs/relativePath" },
    "requestedCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "contributions": { "$ref": "#/$defs/contributions" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": { "enum": ["WebView", "NativeDotNet"] }
        }
      },
      "then": { "required": ["entryPoint"] }
    }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "contributionId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]+$"
    },
    "capability": {
      "enum": [
        "LibraryContent",
        "WorkspacePanel",
        "DocumentProvider",
        "Commands",
        "AiTool",
        "WorkspaceMetadata",
        "FileRead",
        "FileWrite",
        "TerminalExecute",
        "Network",
        "Secrets"
      ]
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "libraries": {
          "type": "array",
          "items": { "$ref": "#/$defs/library" }
        },
        "panels": {
          "type": "array",
          "items": { "$ref": "#/$defs/panel" }
        },
        "documentFormats": {
          "type": "array",
          "items": { "$ref": "#/$defs/documentFormat" }
        },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        },
        "aiTools": {
          "type": "array",
          "items": { "$ref": "#/$defs/aiTool" }
        }
      }
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "contentPath",
        "languageIds",
        "contentOrigin",
        "reviewState",
        "provenance"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "contentPath": { "$ref": "#/$defs/relativePath" },
        "languageIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "contentOrigin": {
          "enum": ["HumanAuthored", "AiAssisted", "AiGenerated", "Imported"]
        },
        "reviewState": { "enum": ["Draft", "Reviewed"] },
        "provenance": { "type": "string", "minLength": 1, "maxLength": 500 },
        "reviewedBy": { "type": "string", "maxLength": 120 },
        "sourceUrl": { "type": "string", "format": "uri", "maxLength": 500 }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "viewResource", "placement"],
      "properties": {
          "id": { "$ref": "#/$defs/contributionId" },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
          "viewResource": { "$ref": "#/$defs/relativePath" },
          "messageApiVersion": { "type": "integer", "minimum": 1, "maximum": 1 },
          "placement": { "$ref": "#/$defs/panelPlacement" }
        }
      },
    "panelPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferredSlot",
        "allowedSlots",
        "minimumWidth",
        "preferredWidth",
        "maximumWidth",
        "allowUserMove",
        "allowUserResize",
        "allowFloating"
      ],
      "properties": {
        "preferredSlot": { "$ref": "#/$defs/panelSlot" },
        "allowedSlots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/panelSlot" }
        },
        "mayReplace": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["FileExplorer", "CommandBuilder"] }
        },
        "minimumWidth": { "type": "number", "minimum": 160, "maximum": 1200 },
        "preferredWidth": { "type": "number", "minimum": 160, "maximum": 1200 },
        "maximumWidth": { "type": "number", "minimum": 160, "maximum": 1600 },
        "minimumHeight": { "type": "number", "minimum": 120, "maximum": 900 },
        "preferredHeight": { "type": "number", "minimum": 120, "maximum": 1000 },
        "maximumHeight": { "type": "number", "minimum": 120, "maximum": 1200 },
        "allowUserMove": { "type": "boolean" },
        "allowUserResize": { "type": "boolean" },
        "allowFloating": { "type": "boolean" }
      }
    },
    "panelSlot": {
      "enum": ["Left", "Right", "Bottom", "Center", "Floating"]
    },
    "documentFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "kind", "fileExtensions", "languageId"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": { "enum": ["TextEditor", "WebViewer", "NativeViewer"] },
        "fileExtensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.[A-Za-z0-9.+_-]+$"
          }
        },
        "languageId": { "type": "string", "minLength": 1 },
        "viewResource": { "$ref": "#/$defs/relativePath" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "handler"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "handler": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "aiTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "description",
        "handler",
        "requiresUserConfirmation"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "handler": { "type": "string", "minLength": 1, "maxLength": 160 },
        "inputSchemaPath": { "$ref": "#/$defs/relativePath" },
        "requiresUserConfirmation": { "type": "boolean" }
      }
    }
  }
}
