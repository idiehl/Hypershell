      "id": "wave-intro",
      "type": "text",
      "region": "main",
      "values": {
        "text": "A wave describes a repeating disturbance. Amplitude controls the size of the variation; frequency describes how often it repeats. This simplified experiment lets you change both and inspect the shape. It is a visual model, not an audio synthesizer."
      }
    },
    {
      "id": "wave-experiment",
      "type": "wave",
      "region": "main",
      "values": {
        "frequency": 2,
        "amplitude": 0.7
      }
    },
    {
      "id": "wave-note",
      "type": "callout",
      "region": "main",
      "values": {
        "title": "Change one thing at a time",
        "text": "Keep amplitude fixed and increase frequency. Then restore frequency and change amplitude. Describe the difference in your own words."
      }
    },
