@namespace HyperLib.Work
@using System.Globalization
<section class="catalog-module module-worked-example">
<header><h2>@Context.Text("title")</h2><p>@Context.Text("text")</p></header><ol class="worked-example">@foreach(var row in Rows){<li><strong>@Cell(row,0)</strong><p>@Cell(row,1)</p></li>}</ol><aside class="notice success">Result: each part can be checked independently.</aside>
</section>
@code {
 [Parameter, EditorRequired] public BlockContext Context { get; set; } = new();
 private string[] Rows => Context.Text("items").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
 private static string Cell(string row, int index) => row.Split('|').ElementAtOrDefault(index)?.Trim() ?? "";

}
