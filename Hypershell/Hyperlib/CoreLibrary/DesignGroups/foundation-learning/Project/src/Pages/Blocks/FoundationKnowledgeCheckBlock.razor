@namespace HyperLib.Work
@using System.Globalization
<section class="catalog-module module-knowledge-check">
<header><h2>@Context.Text("title")</h2><p>@Context.Text("text")</p></header><fieldset><legend>Which step comes before publishing?</legend><div class="pills"><button @onclick="Correct">Review</button><button @onclick="Retry">Gather</button></div></fieldset><output aria-live="polite">@answer</output>
</section>
@code {
 [Parameter, EditorRequired] public BlockContext Context { get; set; } = new();
 private string[] Rows => Context.Text("items").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
 private static string Cell(string row, int index) => row.Split('|').ElementAtOrDefault(index)?.Trim() ?? "";
private string answer="Choose an answer."; private void Correct()=>answer="Correct — review the result first."; private void Retry()=>answer="Try again. Gather material before composing.";
}
