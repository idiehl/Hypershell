@namespace HyperLib.Work
@using System.Globalization
<section class="catalog-module module-flashcard">
<article class="flashcard panel"><p class="kicker">@Context.Text("title")</p><h3>@Cell(Rows.FirstOrDefault() ?? "What is a design system?|A shared vocabulary for building interfaces.",0)</h3><details><summary>Reveal answer</summary><p>@Cell(Rows.FirstOrDefault() ?? "Question|Answer",1)</p></details></article>
</section>
@code {
 [Parameter, EditorRequired] public BlockContext Context { get; set; } = new();
 private string[] Rows => Context.Text("items").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
 private static string Cell(string row, int index) => row.Split('|').ElementAtOrDefault(index)?.Trim() ?? "";

}
