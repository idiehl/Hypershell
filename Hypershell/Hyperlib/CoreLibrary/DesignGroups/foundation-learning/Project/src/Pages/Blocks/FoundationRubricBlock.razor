@namespace HyperLib.Work
@using System.Globalization
<section class="catalog-module module-rubric">
<header><h2>@Context.Text("title")</h2><p>@Context.Text("text")</p></header><div class="table-scroll"><table><thead><tr><th>Criterion</th><th>Developing</th><th>Confident</th></tr></thead><tbody>@foreach(var row in Rows){<tr><th scope="row">@Cell(row,0)</th><td>@Cell(row,1)</td><td>@Cell(row,2)</td></tr>}</tbody></table></div>
</section>
@code {
 [Parameter, EditorRequired] public BlockContext Context { get; set; } = new();
 private string[] Rows => Context.Text("items").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
 private static string Cell(string row, int index) => row.Split('|').ElementAtOrDefault(index)?.Trim() ?? "";

}
