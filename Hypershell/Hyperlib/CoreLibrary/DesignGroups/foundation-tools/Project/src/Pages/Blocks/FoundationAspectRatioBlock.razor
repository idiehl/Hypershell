@namespace HyperLib.Work
@using System.Globalization
<section class="catalog-module module-aspect-ratio">
<header><h2>@Context.Text("title")</h2><p>@Context.Text("text")</p></header><div class="parallel"><label>Width<input type="number" min="1" @bind="width" /></label><label>Ratio<select @bind="ratio"><option value="1">1:1</option><option value="1.333333333">4:3</option><option value="1.777777778">16:9</option></select></label></div><output class="tool-result">@width × @Math.Round(width/Math.Max(ratio,0.01m))</output>
</section>
@code {
 [Parameter, EditorRequired] public BlockContext Context { get; set; } = new();
 private string[] Rows => Context.Text("items").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
 private static string Cell(string row, int index) => row.Split('|').ElementAtOrDefault(index)?.Trim() ?? "";
private decimal width=1200, ratio=1.777777778m;
}
