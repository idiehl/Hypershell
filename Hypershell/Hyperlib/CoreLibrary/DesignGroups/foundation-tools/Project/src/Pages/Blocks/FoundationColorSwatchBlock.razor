@namespace HyperLib.Work
@using System.Globalization
<section class="catalog-module module-color-swatch">
<header><h2>@Context.Text("title")</h2><p>@Context.Text("text")</p></header><label>Color<input type="color" @bind="color" @bind:event="oninput" /></label><div class="color-preview" style="background:@color"></div><output>@color</output>
</section>
@code {
 [Parameter, EditorRequired] public BlockContext Context { get; set; } = new();
 private string[] Rows => Context.Text("items").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
 private static string Cell(string row, int index) => row.Split('|').ElementAtOrDefault(index)?.Trim() ?? "";
private string color="#53766a";
}
