@namespace HyperLib.Work
@using System.Globalization
<section class="catalog-module module-tally">
<header><h2>@Context.Text("title")</h2><p>@Context.Text("text")</p></header><output class="tool-result" aria-live="polite">@count</output><div class="pills"><button aria-label="Subtract one" @onclick="()=>count--">−</button><button aria-label="Add one" @onclick="()=>count++">+</button><button @onclick="()=>count=0">Reset</button></div>
</section>
@code {
 [Parameter, EditorRequired] public BlockContext Context { get; set; } = new();
 private string[] Rows => Context.Text("items").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
 private static string Cell(string row, int index) => row.Split('|').ElementAtOrDefault(index)?.Trim() ?? "";
private int count;
}
