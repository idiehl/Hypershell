@namespace HyperLib.Work
@using System.Globalization
<section class="catalog-module module-donation-options">
<header><h2>@Context.Text("title")</h2><p>@Context.Text("text")</p></header><div class="pills" role="group" aria-label="Suggested contribution">@foreach(var value in new[]{5,15,30,50}){<button aria-pressed="@(amount==value)" @onclick="()=>amount=value">$@value</button>}</div><output aria-live="polite">Selected: $@amount. No payment is collected by this module.</output>
</section>
@code {
 [Parameter, EditorRequired] public BlockContext Context { get; set; } = new();
 private string[] Rows => Context.Text("items").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
 private static string Cell(string row, int index) => row.Split('|').ElementAtOrDefault(index)?.Trim() ?? "";
private int amount=15;
}
