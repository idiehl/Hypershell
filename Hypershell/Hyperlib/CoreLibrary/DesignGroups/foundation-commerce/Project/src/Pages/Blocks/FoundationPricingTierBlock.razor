@namespace HyperLib.Work
@using System.Globalization
<section class="catalog-module module-pricing-tier">
<article class="pricing panel"><p class="kicker">@Context.Text("title")</p><p class="price">$19 <small>/ month</small></p><p>@Context.Text("text")</p><ul>@foreach(var row in Rows){<li>✓ @Cell(row,0)</li>}</ul><a class="action" href="@Context.Text("url")">@Context.Text("label") <span aria-hidden="true">↗</span></a></article>
</section>
@code {
 [Parameter, EditorRequired] public BlockContext Context { get; set; } = new();
 private string[] Rows => Context.Text("items").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
 private static string Cell(string row, int index) => row.Split('|').ElementAtOrDefault(index)?.Trim() ?? "";

}
