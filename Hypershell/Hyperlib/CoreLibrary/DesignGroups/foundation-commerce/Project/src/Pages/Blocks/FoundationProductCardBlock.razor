@namespace HyperLib.Work
@using System.Globalization
<section class="catalog-module module-product-card">
<article class="product"><div class="product-art" aria-hidden="true">✧</div><span class="badge">@Cell(Rows.FirstOrDefault() ?? "Edition 01",0)</span><h2>@Context.Text("title")</h2><p>@Context.Text("text")</p><strong class="price">@Cell(Rows.FirstOrDefault() ?? "Edition 01|$24",1)</strong><a class="action" href="@Context.Text("url")">@Context.Text("label") <span aria-hidden="true">↗</span></a></article>
</section>
@code {
 [Parameter, EditorRequired] public BlockContext Context { get; set; } = new();
 private string[] Rows => Context.Text("items").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
 private static string Cell(string row, int index) => row.Split('|').ElementAtOrDefault(index)?.Trim() ?? "";

}
