@namespace HyperLib.Work
@using System.Globalization
<section class="catalog-module module-search-directory">
<header><h2>@Context.Text("title")</h2><p>@Context.Text("text")</p></header><label>Find an entry <input type="search" @bind="query" @bind:event="oninput" placeholder="Search this directory" /></label><ul>@foreach(var row in Rows.Where(r=>r.Contains(query,StringComparison.OrdinalIgnoreCase))){<li>@Cell(row,0)<small>@Cell(row,1)</small></li>}</ul>
</section>
@code {
 [Parameter, EditorRequired] public BlockContext Context { get; set; } = new();
 private string[] Rows => Context.Text("items").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
 private static string Cell(string row, int index) => row.Split('|').ElementAtOrDefault(index)?.Trim() ?? "";
private string query = "";
}
