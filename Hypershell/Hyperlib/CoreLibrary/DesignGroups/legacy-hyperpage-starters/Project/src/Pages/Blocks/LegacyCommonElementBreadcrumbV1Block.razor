@* Source: common.element.breadcrumb.v1 (Hyperpage starters). Editable fields preserve the original Hyperpage design. *@
@namespace HyperLib.Work.Blocks

<main class="vp-aeed46d9b16b" data-vp-id="aeed46d9b16b743c5c73f942c2fa9e52">
    <nav aria-label="Breadcrumb" class="vp-762202708470" data-vp-id="762202708470343ed3a16f2842d527bb">
        <a class="vp-8d30c0df426b" data-field="text-2" data-vp-id="8d30c0df426b36cc2dc6d6379e15ed60" href="@(Link(Context.Text("href-2")))">
            @(Context.Text("text-2"))
        </a>
        <span class="vp-d2d681ac51ac" data-field="text-3" data-vp-id="d2d681ac51ac0f8ec8f9f9afc91b5dbd">
            @(Context.Text("text-3"))
