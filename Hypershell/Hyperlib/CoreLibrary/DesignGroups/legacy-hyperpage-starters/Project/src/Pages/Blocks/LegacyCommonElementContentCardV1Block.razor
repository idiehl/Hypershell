@namespace HyperLib.Work.Blocks

<main class="vp-bfd22a9c057f" data-vp-id="bfd22a9c057f06a355241effbcc08686">
    <div class="vp-522b995f898c" data-vp-id="522b995f898ce692bc50e2aa237e9e11">
        <div class="vp-0b5c713b6dac" data-vp-id="0b5c713b6dac534d8d06c9d997fa8c92">
            <span class="vp-afcb34533439" data-field="text-3" data-vp-id="afcb34533439b93bc2101f707c033c6d">
                @(Context.Text("text-3"))
            </span>
            <span class="vp-b343d4968127" data-field="text-4" data-vp-id="b343d4968127fecf7082a59f53ca4d7a">
                @(Context.Text("text-4"))
            </span>
            <span class="vp-63e75a09f982" data-field="text-5" data-vp-id="63e75a09f982a0757af96b16d60d8d07">
