@namespace HyperLib.Work
@using System.Globalization
<section class="catalog-module module-kanban">
<header><h2>@Context.Text("title")</h2><p>@Context.Text("text")</p></header><div class="three-columns">@foreach(var stage in new[]{"Planned","In progress","Complete"}){<section class="panel"><h3>@stage</h3>@foreach(var row in Rows.Where(r=>Cell(r,0)==stage)){<article class="task">@Cell(row,1)</article>}</section>}</div>
</section>
@code {
 [Parameter, EditorRequired] public BlockContext Context { get; set; } = new();
 private string[] Rows => Context.Text("items").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
 private static string Cell(string row, int index) => row.Split('|').ElementAtOrDefault(index)?.Trim() ?? "";

}
