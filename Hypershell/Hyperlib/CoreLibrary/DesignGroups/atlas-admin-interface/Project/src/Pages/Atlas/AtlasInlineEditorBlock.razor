@namespace HyperLib.Work.Atlas
<AtlasSurface>
<details class="inline-editor"><summary data-field="title">@T("title")</summary><label>Local note<textarea @bind="_note" placeholder="@T("placeholder")"></textarea></label><button class="secondary" type="button" @onclick="() => _saved = _note">Preview change</button>@if(_saved.Length > 0) { <p class="notice" role="status">@_saved</p> }</details>
</AtlasSurface>
@code {
[Parameter, EditorRequired] public BlockContext Context { get; set; } = new();
private string T(string name, string fallback = "") => Context.Text(name, fallback);
private string[] Lines(string name) => T(name).Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(100).ToArray();
private static string Part(string value, int index) { var parts = value.Split('|', StringSplitOptions.TrimEntries); return parts.Length > index ? parts[index] : string.Empty; }
private static string Link(string value) => value.StartsWith('#') || value.StartsWith("./", StringComparison.Ordinal) || (value.StartsWith('/') && !value.StartsWith("//", StringComparison.Ordinal)) || (Uri.TryCreate(value, UriKind.Absolute, out var uri) && uri.Scheme is "http" or "https" or "mailto") ? value : "#";
private string _note = "", _saved = "";
}
