@namespace HyperLib.Work
@using System.Globalization
<section class="catalog-module module-profile-card">
<article class="profile panel"><span class="avatar large" aria-hidden="true">✦</span><h2>@Context.Text("title")</h2><p>@Context.Text("text")</p><ul class="pills">@foreach(var row in Rows){<li><a href="@Context.Text("url")">@Cell(row,0)</a></li>}</ul></article>
</section>
@code {
 [Parameter, EditorRequired] public BlockContext Context { get; set; } = new();
 private string[] Rows => Context.Text("items").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
 private static string Cell(string row, int index) => row.Split('|').ElementAtOrDefault(index)?.Trim() ?? "";

}
