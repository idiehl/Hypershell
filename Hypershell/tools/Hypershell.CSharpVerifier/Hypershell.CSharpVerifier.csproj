<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hypershell\Hypershell.csproj" />
    <ProjectReference Include="..\..\src\Hypershell.ProfileServer\Hypershell.ProfileServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\Hypershell\Assets\CommandLibraries\*.json"
             Link="Assets\CommandLibraries\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
