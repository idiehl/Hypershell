@page
@model CredentialReleaseModel
@{
    ViewData["Title"] = "Release SSH credential";
}

<section class="page-heading compact">
    <a class="back-link" href="/">← Overview</a>
    <p class="eyebrow">LINKED HOST CREDENTIAL</p>
    <h1>Authorize credential release</h1>
    <p class="muted">This one-time approval sends the selected SSH key only to the named Hypershell installation.</p>
</section>

@if (Model.Approved)
{
    <section class="authorization-card result-card">
        <span class="result-icon success">✓</span>
        <h2>Credential release approved</h2>
        <p class="muted">Return to Hypershell. The request can be consumed once, then it expires permanently.</p>
    </section>
}
else if (Model.Denied)
{
    <section class="authorization-card result-card">
        <span class="result-icon denied">×</span>
        <h2>Credential release denied</h2>
        <p class="muted">No SSH key material was released.</p>
    </section>
}
else
{
    <section class="authorization-card">
        <form method="post" asp-page-handler="Lookup">
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <label asp-for="UserCode">Code shown in Hypershell</label>
            <div class="code-entry-row">
                <input asp-for="UserCode" autocomplete="one-time-code" placeholder="ABCD-EFGH" autofocus />
                <button class="secondary" type="submit">Continue</button>
            </div>
            <span asp-validation-for="UserCode" class="validation"></span>
        </form>

        @if (Model.Pending is not null)
        {
            <div class="device-request">
                <span class="device-glyph">⌘</span>
                <div>
                    <h2>@Model.Pending.CredentialLabel</h2>
                    <p>@Model.Pending.PublicKeyFingerprint · key version @Model.Pending.KeyVersion</p>
                    <small>Requested by @Model.Pending.ClientDeviceName (@Model.Pending.ClientPlatform)</small>
                </div>
            </div>
            <p class="risk-note">Re-enter your password and authenticator code. Approval exposes this credential to the requesting Windows account, where Hypershell protects it with DPAPI.</p>
            <form method="post" asp-page-handler="Approve" class="stacked-form">
                <input asp-for="UserCode" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="validation"></div>
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="validation"></span>
                <label asp-for="Input.SecondFactor">Authenticator or recovery code</label>
                <input asp-for="Input.SecondFactor" autocomplete="one-time-code" />
                <span asp-validation-for="Input.SecondFactor" class="validation"></span>
                <div class="authorization-actions">
                    <button class="primary compact-button" type="submit">Approve once</button>
                </div>
            </form>
            <form method="post" asp-page-handler="Deny">
                <input asp-for="UserCode" type="hidden" />
                <button class="danger" type="submit">Deny</button>
            </form>
        }
    </section>
}
