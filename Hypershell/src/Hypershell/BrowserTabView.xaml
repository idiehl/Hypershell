<UserControl x:Class="Hypershell.BrowserTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#FF0D1117"
             PreviewKeyDown="BrowserTabPreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition x:Name="LoadingIndicatorRow" Height="2" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border x:Name="NavigationToolbar"
            Grid.Row="0"
            Height="44"
            Visibility="{Binding ShowNavigationToolbar, Converter={StaticResource BooleanToVisibilityConverter}}"
            Background="#FF161B22"
            BorderBrush="#FF30363D"
            BorderThickness="0,0,0,1">
      <Grid Margin="8,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="34" />
          <ColumnDefinition Width="34" />
          <ColumnDefinition Width="34" />
          <ColumnDefinition Width="34" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0"
                Click="BackClick"
                IsEnabled="{Binding CanGoBack}"
                Style="{StaticResource HeaderIconButtonStyle}"
                ToolTip="Back (Alt+Left)">
          <TextBlock Text="&#xE72B;"
                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     FontSize="15" />
        </Button>
        <Button Grid.Column="1"
                Click="ForwardClick"
                IsEnabled="{Binding CanGoForward}"
                Style="{StaticResource HeaderIconButtonStyle}"
                ToolTip="Forward (Alt+Right)">
          <TextBlock Text="&#xE72A;"
                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     FontSize="15" />
        </Button>
        <Button Grid.Column="2"
                Click="HomeClick"
                Style="{StaticResource HeaderIconButtonStyle}"
                ToolTip="Home">
          <TextBlock Text="&#xE80F;"
                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     FontSize="15" />
        </Button>
        <Button Grid.Column="3"
                Click="RefreshOrStopClick"
                Style="{StaticResource HeaderIconButtonStyle}"
                ToolTip="Refresh or stop (Ctrl+R / Esc)">
          <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     FontSize="15">
            <TextBlock.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Text" Value="&#xE72C;" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter Property="Text" Value="&#xE711;" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Button>

        <TextBox x:Name="AddressTextBox"
                 Grid.Column="4"
                 Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="AddressTextBoxKeyDown"
                 GotKeyboardFocus="AddressTextBoxGotKeyboardFocus"
                 PreviewMouseLeftButtonDown="AddressTextBoxPreviewMouseLeftButtonDown"
                 FontFamily="{StaticResource CodeFontFamily}"
                 FontSize="12"
                 VerticalContentAlignment="Center"
                 Margin="5,0"
                 Padding="9,3"
                 ToolTip="Enter an address or search" />

        <Button Grid.Column="5"
                Click="GoClick"
                Style="{StaticResource HeaderIconButtonStyle}"
                ToolTip="Go">
          <TextBlock Text="&#xE72A;"
                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     FontSize="15"
                     Foreground="{StaticResource SecondaryBrush}" />
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Background="{StaticResource SecondaryBrush}"
            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

    <Grid Grid.Row="2">
      <wv2:WebView2 x:Name="Browser"
                    DefaultBackgroundColor="#0D1117" />
      <Border Background="#F20D1117"
              Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="620"
                    Margin="30">
          <TextBlock Text="Page unavailable"
                     Foreground="{StaticResource ForegroundBrush}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding ErrorMessage}"
                     Foreground="{StaticResource MutedForegroundBrush}"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
