<UserControl x:Class="Hypershell.Controls.AtlasMyNetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Hypershell.Models"
             MinWidth="250"
             Background="{StaticResource PanelBrush}">
  <UserControl.Resources>
    <Style x:Key="MyNetSectionLabelStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style x:Key="MyNetSmallButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="FontSize" Value="10" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Padding="10,8"
            Background="#FF111820"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
          <TextBlock Text="ATLAS MYNET"
                     Style="{StaticResource MyNetSectionLabelStyle}"
                     VerticalAlignment="Center" />
          <TextBlock DockPanel.Dock="Right"
                     Text="{Binding LastUpdatedText}"
                     Foreground="{StaticResource MutedForegroundBrush}"
                     FontSize="9"
                     VerticalAlignment="Center" />
        </DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,7,0,0">
          <Button Content="Open MyNet"
                  Style="{StaticResource MyNetSmallButtonStyle}"
                  Click="OpenDesktopClick"
                  AutomationProperties.Name="Open MyNet"
                  ToolTip="Open MyNet · runs in the system tray" />
          <Button Content="Add"
                  Style="{StaticResource MyNetSmallButtonStyle}"
                  Click="AddAppClick"
                  ToolTip="Register a local web app" />
          <Button Content="Import"
                  Style="{StaticResource MyNetSmallButtonStyle}"
                  Click="ImportAppsClick"
                  ToolTip="Import Atlas MyNet schema v1 JSON; commands remain untrusted" />
          <Button Content="Export"
                  Style="{StaticResource MyNetSmallButtonStyle}"
                  Click="ExportAppsClick"
                  ToolTip="Export registered app definitions without trust decisions" />
          <Button Content="Refresh"
                  Style="{StaticResource MyNetSmallButtonStyle}"
                  Click="RefreshClick"
                  ToolTip="Refresh apps, listeners, and socket rows now" />
        </WrapPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
      <StackPanel Margin="8,8,8,10">
        <Button Click="OpenDesktopClick" Padding="14,18" HorizontalContentAlignment="Stretch"
                ToolTip="MyNet keeps running when Hypershell closes" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="MyNet" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Your apps, in the system tray." TextWrapping="Wrap" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,5,0,0" />
            <TextBlock Text="Open MyNet ↗" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,0" />
          </StackPanel>
        </Button>
        <Expander Header="App details" IsExpanded="False" Margin="0,0,0,8">
        <StackPanel Margin="0,8,0,0">
        <DockPanel Margin="2,0,2,5">
          <TextBlock Text="REGISTERED APPS"
                     Style="{StaticResource MyNetSectionLabelStyle}" />
          <TextBlock DockPanel.Dock="Right"
                     Text="{Binding Apps.Count, StringFormat={}{0} apps}"
                     Foreground="{StaticResource MutedForegroundBrush}"
                     FontSize="9" />
        </DockPanel>

        <ItemsControl ItemsSource="{Binding Apps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,7"
                      Padding="9"
                      Background="#FF161D25"
                      BorderBrush="#FF303A46"
                      BorderThickness="1"
                      CornerRadius="5">
                <StackPanel>
                  <DockPanel LastChildFill="True">
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{StaticResource ForegroundBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding StatusText}"
                               Foreground="{StaticResource SecondaryBrush}"
                               FontSize="9"
                               Margin="8,0,0,0" />
                  </DockPanel>
                  <TextBlock Text="{Binding UrlText}"
                             Foreground="{StaticResource MutedForegroundBrush}"
                             FontFamily="JetBrains Mono"
                             FontSize="9"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding UrlText}"
                             Margin="0,3,0,0" />
                  <TextBlock Text="{Binding CommandTrustText}"
                             Foreground="#FF8B949E"
                             FontSize="9"
                             Margin="0,3,0,0" />
                  <TextBlock Text="{Binding ErrorMessage}"
                             Foreground="#FFFF7B72"
                             FontSize="9"
                             TextWrapping="Wrap"
                             Margin="0,3,0,0"
                             Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <WrapPanel Margin="0,7,0,0">
                    <Button Content="Open"
                            Style="{StaticResource MyNetSmallButtonStyle}"
                            IsEnabled="{Binding CanOpen}"
                            Click="OpenAppClick" />
                    <Button Content="Start"
                            Style="{StaticResource MyNetSmallButtonStyle}"
                            IsEnabled="{Binding CanStart}"
                            Click="StartAppClick" />
                    <Button Content="Stop"
                            Style="{StaticResource MyNetSmallButtonStyle}"
                            IsEnabled="{Binding CanStop}"
                            Click="StopAppClick" />
                    <Button Content="Trust…"
                            Style="{StaticResource MyNetSmallButtonStyle}"
                            Click="TrustAppClick"
                            Visibility="{Binding NeedsTrust, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="Edit"
                            Style="{StaticResource MyNetSmallButtonStyle}"
                            Click="EditAppClick" />
                    <Button Content="Remove"
                            Style="{StaticResource MyNetSmallButtonStyle}"
                            IsEnabled="{Binding CanRemove}"
                            Click="RemoveAppClick" />
                  </WrapPanel>
                  <CheckBox Content="Allow this app to load public web resources"
                            IsChecked="{Binding Definition.AllowExternalResources}"
                            Click="ExternalResourcesClick"
                            Foreground="{StaticResource MutedForegroundBrush}"
                            FontSize="9"
                            Margin="1,5,0,0"
                            ToolTip="Top-level public links still ask before opening in the system browser" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        </StackPanel>
        </Expander>

        <Expander Header="DISCOVERED LOCAL WEB LISTENERS"
                  IsExpanded="True"
                  Margin="0,5,0,0">
          <ItemsControl ItemsSource="{Binding DiscoveredWebApps}"
                        Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type models:AtlasMyNetDiscoveredWebApp}">
                <Button Padding="8,6"
                        Margin="0,0,0,5"
                        HorizontalContentAlignment="Stretch"
                        Click="OpenDiscoveredAppClick">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding DisplayName}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Url}"
                                 Foreground="{StaticResource MutedForegroundBrush}"
                                 FontFamily="JetBrains Mono"
                                 FontSize="9"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProcessId, StringFormat=PID {0}}"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               FontSize="9"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>

        <Expander Header="NETWORK SOCKETS"
                  IsExpanded="True"
                  Margin="0,8,0,0">
          <StackPanel Margin="0,6,0,0">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filter protocol, endpoints, state, process, PID, or owner"
                     Padding="7,4" />
            <WrapPanel Margin="0,6,0,5">
              <CheckBox Content="TCP"
                        IsChecked="{Binding ShowTcp}"
                        Margin="0,0,10,0" />
              <CheckBox Content="UDP"
                        IsChecked="{Binding ShowUdp}"
                        Margin="0,0,10,0" />
              <CheckBox Content="TCP listeners only"
                        IsChecked="{Binding ListenersOnly}" />
            </WrapPanel>
            <TextBlock Text="{Binding NetworkSummary}"
                       Foreground="{StaticResource MutedForegroundBrush}"
                       FontSize="9"
                       Margin="1,0,0,5" />
            <ListBox x:Name="NetworkSocketList"
                     ItemsSource="{Binding NetworkSockets}"
                     MaxHeight="540"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="NetworkSocketDoubleClick">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:NetworkSocketSnapshot}">
                  <Border Padding="7"
                          BorderBrush="#FF303A46"
                          BorderThickness="0,0,0,1">
                    <StackPanel>
                      <DockPanel LastChildFill="True">
                        <TextBlock Text="{Binding ProtocolText}"
                                   Foreground="{StaticResource SecondaryBrush}"
                                   FontSize="9"
                                   FontWeight="Bold" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding State}"
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   FontSize="9" />
                      </DockPanel>
                      <TextBlock Text="{Binding LocalEndpoint, StringFormat=Local  {0}}"
                                 FontFamily="JetBrains Mono"
                                 FontSize="9"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding RemoteEndpoint, StringFormat=Remote {0}}"
                                 FontFamily="JetBrains Mono"
                                 FontSize="9"
                                 Foreground="{StaticResource MutedForegroundBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProcessSummary}"
                                   FontSize="9"
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   ToolTip="{Binding ExecutablePath}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                          <Button Content="Client"
                                  Style="{StaticResource MyNetSmallButtonStyle}"
                                  Click="OpenSocketClientClick"
                                  ToolTip="Create a new connection; this does not attach to the existing socket" />
                          <Button Content="Stop…"
                                  Style="{StaticResource MyNetSmallButtonStyle}"
                                  IsEnabled="{Binding CanRequestProcessStop}"
                                  Click="StopSocketProcessClick"
                                  ToolTip="Request a safe stop of this same-user process" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Padding="9,6"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Background="#FF111820">
      <StackPanel>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{StaticResource MutedForegroundBrush}"
                   FontSize="9"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding AppsPath}"
                   ToolTip="Atlas MyNet schema v1 app registry"
                   Foreground="#FF66717D"
                   FontFamily="JetBrains Mono"
                   FontSize="8"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,3,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
