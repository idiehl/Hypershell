<UserControl x:Class="Hypershell.Controls.NetworkObservatoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Hypershell.Models"
             MinWidth="300">
  <UserControl.Resources>
    <Style x:Key="ObservatorySectionLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="1,10,0,5" />
    </Style>
    <Style x:Key="ObservatoryMetaLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ObservatoryCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="9" />
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <Style x:Key="ObservatorySmallButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style x:Key="ObservatoryTabControlStyle"
           TargetType="{x:Type TabControl}"
           BasedOn="{StaticResource {x:Type TabControl}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabControl}">
            <Grid KeyboardNavigation.TabNavigation="Local"
                  SnapsToDevicePixels="True">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="Transparent"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="0,0,0,1">
                <TabPanel x:Name="HeaderPanel"
                          IsItemsHost="True"
                          Margin="0,6,0,0" />
              </Border>
              <ContentPresenter x:Name="PART_SelectedContentHost"
                                Grid.Row="1"
                                Content="{TemplateBinding SelectedContent}"
                                ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Keyed styles must explicitly inherit Hypershell's dark TabItem theme. -->
    <Style x:Key="ObservatoryTabStyle"
           TargetType="{x:Type TabItem}"
           BasedOn="{StaticResource {x:Type TabItem}}">
      <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
      <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="ATLAS NETWORK OBSERVATORY"
                   Foreground="{StaticResource AccentBrush}"
                   FontSize="11"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding LastUpdatedText}"
                   Style="{StaticResource ObservatoryMetaLabelStyle}"
                   Margin="0,2,0,0" />
      </StackPanel>
      <Button Grid.Column="1"
              Content="Refresh"
              Command="{Binding RefreshCommand}"
              Style="{StaticResource ObservatorySmallButtonStyle}"
              ToolTip="Refresh local state and advertised LAN services" />
    </Grid>

    <Border Grid.Row="1"
            Background="#181F27"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Padding="7"
            Margin="0,0,0,7">
      <TextBlock Text="{Binding RouterBoundaryText}"
                 Foreground="{StaticResource MutedForegroundBrush}"
                 FontSize="9"
                 TextWrapping="Wrap" />
    </Border>

    <TabControl Grid.Row="2"
                Style="{StaticResource ObservatoryTabControlStyle}">
      <TabItem Header="Overview" Style="{StaticResource ObservatoryTabStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,5,4,0">
          <StackPanel>
            <Border Style="{StaticResource ObservatoryCardStyle}">
              <StackPanel>
                <TextBlock Text="{Binding HostSummary}"
                           Foreground="{StaticResource ForegroundBrush}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding NetworkProfileSummary}"
                           Foreground="{StaticResource SecondaryBrush}"
                           FontSize="10"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding FirewallSummary}"
                           Style="{StaticResource ObservatoryMetaLabelStyle}"
                           Margin="0,4,0,0" />
                <TextBlock Text="{Binding NetworkSummary}"
                           Style="{StaticResource ObservatoryMetaLabelStyle}"
                           Margin="0,4,0,0" />
              </StackPanel>
            </Border>

            <TextBlock Text="INTERFACES &amp; SUBNETS"
                       Style="{StaticResource ObservatorySectionLabelStyle}" />
            <ItemsControl ItemsSource="{Binding Interfaces}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:NetworkInterfaceSnapshot}">
                  <Border Style="{StaticResource ObservatoryCardStyle}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Foreground="{StaticResource SecondaryBrush}"
                                   FontSize="9"
                                   Margin="8,0,0,0" />
                      </Grid>
                      <TextBlock Text="{Binding Description}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}"
                                 Margin="0,2,0,0" />
                      <TextBlock Text="{Binding KindText}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}"
                                 Margin="0,2,0,0" />
                      <TextBlock Text="{Binding ProfileText}"
                                 Foreground="{StaticResource SecondaryBrush}"
                                 FontSize="9"
                                 Margin="0,4,0,0"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding AddressesText, StringFormat=Addresses: {0}}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}"
                                 Margin="0,4,0,0" />
                      <TextBlock Text="{Binding SubnetsText, StringFormat=Subnets: {0}}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}" />
                      <TextBlock Text="{Binding GatewaysText, StringFormat=Gateway: {0}}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}" />
                      <TextBlock Text="{Binding DnsText, StringFormat=DNS: {0}}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}" />
                      <TextBlock Text="{Binding DhcpText, StringFormat=DHCP: {0}}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="ROUTES"
                       Style="{StaticResource ObservatorySectionLabelStyle}" />
            <ItemsControl ItemsSource="{Binding Routes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:NetworkRouteSnapshot}">
                  <Border Style="{StaticResource ObservatoryCardStyle}"
                          Padding="7"
                          Margin="0,0,0,4">
                    <StackPanel>
                      <TextBlock Text="{Binding Summary}"
                                 Foreground="{StaticResource ForegroundBrush}"
                                 FontFamily="{StaticResource CodeFontFamily}"
                                 FontSize="9"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Protocol}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="USEFUL SERVICES"
                       Style="{StaticResource ObservatorySectionLabelStyle}" />
            <TextBlock Text="Status is read-only. This panel never enables a service or changes a firewall rule."
                       Style="{StaticResource ObservatoryMetaLabelStyle}"
                       Margin="1,0,0,6" />
            <ItemsControl ItemsSource="{Binding ServiceCandidates}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:NetworkServiceCandidateSnapshot}">
                  <Border Style="{StaticResource ObservatoryCardStyle}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Status}"
                                   FontSize="9"
                                   Margin="8,0,0,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                  <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                      <TextBlock Text="{Binding Purpose}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}"
                                 Margin="0,3,0,0" />
                      <TextBlock Text="{Binding Endpoint, StringFormat=Endpoint: {0}}"
                                 Foreground="{StaticResource SecondaryBrush}"
                                 FontFamily="{StaticResource CodeFontFamily}"
                                 FontSize="9"
                                 Margin="0,3,0,0"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Guidance}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}"
                                 Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Nearby" Style="{StaticResource ObservatoryTabStyle}">
        <Grid Margin="0,5,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding NearbySummary}"
                       Foreground="{StaticResource SecondaryBrush}"
                       FontSize="10"
                       TextWrapping="Wrap" />
            <TextBlock Text="Correlated from the Windows neighbor cache, mDNS/DNS-SD, SSDP and WS-Discovery. Roles are labeled as inferences unless confirmed by routing."
                       Style="{StaticResource ObservatoryMetaLabelStyle}"
                       Margin="0,4,0,7" />
          </StackPanel>
          <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="0,0,4,0">
            <ItemsControl ItemsSource="{Binding NearbyDevices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:NearbyNetworkDeviceSnapshot}">
                  <Border Style="{StaticResource ObservatoryCardStyle}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Role}"
                                   Foreground="{StaticResource SecondaryBrush}"
                                   FontSize="9"
                                   Margin="8,0,0,0"
                                   TextWrapping="Wrap" />
                      </Grid>
                      <TextBlock Text="{Binding Confidence}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}"
                                 Margin="0,2,0,0" />
                      <TextBlock Text="{Binding IdentityText}"
                                 FontFamily="{StaticResource CodeFontFamily}"
                                 Foreground="{StaticResource SecondaryBrush}"
                                 FontSize="9"
                                 Margin="0,5,0,0"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding InterfaceAlias, StringFormat=Interface: {0}}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}" />
                      <TextBlock Text="{Binding ServicesText}"
                                 Foreground="{StaticResource ForegroundBrush}"
                                 FontSize="9"
                                 Margin="0,4,0,0"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SourcesText, StringFormat=Sources: {0}}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}"
                                 Margin="0,3,0,0" />
                      <TextBlock Text="{Binding LastSeenText}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Exposure" Style="{StaticResource ObservatoryTabStyle}">
        <Grid Margin="0,5,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding ExposureSummary}"
                       Foreground="{StaticResource SecondaryBrush}"
                       FontSize="10"
                       TextWrapping="Wrap" />
            <TextBlock Text="Classification combines listener binding, active Windows network profiles and effective inbound firewall-rule signals. Router/NAT forwarding is not inspected."
                       Style="{StaticResource ObservatoryMetaLabelStyle}"
                       Margin="0,4,0,7" />
          </StackPanel>
          <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="0,0,4,0">
            <ItemsControl ItemsSource="{Binding Exposures}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:NetworkExposureSnapshot}">
                  <Border Style="{StaticResource ObservatoryCardStyle}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Endpoint}"
                                   FontFamily="{StaticResource CodeFontFamily}"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Classification}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Risk}" Value="{x:Static models:NetworkExposureRisk.Elevated}">
                                  <Setter Property="Foreground" Value="{StaticResource AttentionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Risk}" Value="{x:Static models:NetworkExposureRisk.Local}">
                                  <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                      <TextBlock Text="{Binding ProcessText}"
                                 Foreground="{StaticResource SecondaryBrush}"
                                 FontSize="9"
                                 Margin="0,3,0,0"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ProtocolText, StringFormat=Protocol: {0}}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}" />
                      <TextBlock Text="{Binding FirewallText, StringFormat=Firewall: {0}}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}" />
                      <TextBlock Text="{Binding ActiveProfiles, StringFormat=Profiles: {0}}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}" />
                      <TextBlock Text="{Binding CertificateText}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}"
                                 Margin="0,3,0,0" />
                      <TextBlock Text="{Binding Explanation}"
                                 Foreground="{StaticResource MutedForegroundBrush}"
                                 FontSize="9"
                                 TextWrapping="Wrap"
                                 Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Census" Style="{StaticResource ObservatoryTabStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,5,4,0">
          <StackPanel>
            <Border Background="#2A2119"
                    BorderBrush="{StaticResource SecondaryBrush}"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,0,0,8">
              <TextBlock Text="The census sends ICMP and TCP connection probes. Run it only on a network you own or administer. The range is always taken from an active physical interface and capped at 256 addresses."
                         Foreground="{StaticResource SecondaryBrush}"
                         FontSize="9"
                         TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="CONNECTED SUBNET"
                       Style="{StaticResource ObservatorySectionLabelStyle}"
                       Margin="1,0,0,4" />
            <ComboBox ItemsSource="{Binding CensusSubnets}"
                      SelectedItem="{Binding SelectedCensusSubnet, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      MinHeight="30" />

            <TextBlock Text="SELECTED TCP PORTS"
                       Style="{StaticResource ObservatorySectionLabelStyle}" />
            <TextBox Text="{Binding CensusPortsText, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource CodeFontFamily}"
                     TextWrapping="Wrap"
                     MinHeight="52"
                     AcceptsReturn="True"
                     ToolTip="Comma or space separated; maximum 16 ports" />
            <TextBlock Text="Maximum 16 explicit ports; ranges are intentionally not accepted."
                       Style="{StaticResource ObservatoryMetaLabelStyle}"
                       Margin="1,3,0,0" />

            <CheckBox IsChecked="{Binding IsCensusAuthorized, Mode=TwoWay}"
                      Margin="1,10,0,0"
                      Foreground="{StaticResource ForegroundBrush}"
                      Content="I own or administer this selected network" />

            <WrapPanel Margin="0,9,0,0">
              <Button Content="Start bounded census"
                      Command="{Binding StartCensusCommand}"
                      Style="{StaticResource ObservatorySmallButtonStyle}"
                      Margin="0,0,7,0" />
              <Button Content="Cancel"
                      Command="{Binding CancelCensusCommand}"
                      Style="{StaticResource ObservatorySmallButtonStyle}" />
            </WrapPanel>

            <Border Style="{StaticResource ObservatoryCardStyle}"
                    Margin="0,9,0,7">
              <StackPanel>
                <TextBlock Text="{Binding CensusStatusText}"
                           Foreground="{StaticResource ForegroundBrush}"
                           FontSize="10"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding CensusProgressText}"
                           Style="{StaticResource ObservatoryMetaLabelStyle}"
                           Margin="0,3,0,0" />
              </StackPanel>
            </Border>

            <TextBlock Text="RESPONDING HOSTS"
                       Style="{StaticResource ObservatorySectionLabelStyle}" />
            <ItemsControl ItemsSource="{Binding CensusHosts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:NetworkCensusHostSnapshot}">
                  <Border Style="{StaticResource ObservatoryCardStyle}">
                    <StackPanel>
                      <TextBlock Text="{Binding DisplayName}"
                                 Foreground="{StaticResource ForegroundBrush}"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{Binding IdentityText}"
                                 Foreground="{StaticResource SecondaryBrush}"
                                 FontFamily="{StaticResource CodeFontFamily}"
                                 FontSize="9"
                                 Margin="0,3,0,0"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ReachabilityText}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}" />
                      <TextBlock Text="{Binding OpenPortsText}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Changes" Style="{StaticResource ObservatoryTabStyle}">
        <Grid Margin="0,5,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding ChangeSummary}"
                       Foreground="{StaticResource SecondaryBrush}"
                       FontSize="10"
                       TextWrapping="Wrap" />
            <TextBlock Text="Tracks devices, listening endpoints, gateway/DNS/default-route fingerprints and local TLS certificate changes between observations."
                       Style="{StaticResource ObservatoryMetaLabelStyle}"
                       Margin="0,4,0,7" />
          </StackPanel>
          <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="0,0,4,0">
            <ItemsControl ItemsSource="{Binding Changes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:NetworkChangeSnapshot}">
                  <Border Style="{StaticResource ObservatoryCardStyle}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SeverityText}"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   Margin="0,0,7,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:NetworkChangeSeverity.Notice}">
                                  <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:NetworkChangeSeverity.Warning}">
                                  <Setter Property="Foreground" Value="{StaticResource AttentionBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Category}"
                                   Foreground="{StaticResource SecondaryBrush}"
                                   FontSize="9" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding TimestampText}"
                                   Style="{StaticResource ObservatoryMetaLabelStyle}"
                                   Margin="8,0,0,0" />
                      </Grid>
                      <TextBlock Text="{Binding Summary}"
                                 Foreground="{StaticResource ForegroundBrush}"
                                 FontWeight="SemiBold"
                                 Margin="0,5,0,0"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Detail}"
                                 Style="{StaticResource ObservatoryMetaLabelStyle}"
                                 Margin="0,3,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="3" Margin="0,6,0,0">
      <ProgressBar Height="2"
                   Margin="0,0,0,5"
                   IsIndeterminate="True"
                   Foreground="{StaticResource AccentBrush}"
                   Background="{StaticResource PanelRaisedBrush}"
                   Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <TextBlock Text="{Binding DataSourceText}"
                 Foreground="{StaticResource MutedForegroundBrush}"
                 FontSize="8"
                 TextWrapping="Wrap" />
      <TextBlock Text="{Binding DiscoveryDiagnostics}"
                 Foreground="{StaticResource AttentionBrush}"
                 FontSize="8"
                 TextWrapping="Wrap"
                 Margin="0,2,0,0" />
      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="{StaticResource MutedForegroundBrush}"
                 FontSize="9"
                 TextWrapping="Wrap"
                 Margin="0,2,0,0" />
    </StackPanel>
  </Grid>
</UserControl>
