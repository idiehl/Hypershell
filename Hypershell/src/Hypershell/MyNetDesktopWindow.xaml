<Window x:Class="Hypershell.MyNetDesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="MyNet"
        Width="360" Height="720" MinWidth="240" MinHeight="300"
        WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        Loaded="WindowLoaded" Closing="WindowClosing" StateChanged="WindowStateChanged"
        LocationChanged="WindowPlacementChanged" SizeChanged="WindowSizeChanged"
        PreviewKeyDown="WindowPreviewKeyDown">
  <Window.Resources>
    <Style x:Key="DesktopControl" TargetType="Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#F0F4FB" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ControlBackground" Background="{TemplateBinding Background}" CornerRadius="5">
              <TextBlock Text="{TemplateBinding Content}"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{TemplateBinding FontSize}"
                         Foreground="{TemplateBinding Foreground}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ControlBackground" Property="Background" Value="#385A789B" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ControlBackground" Property="Background" Value="#506784A4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DesktopIcon" TargetType="Button">
      <Setter Property="Width" Value="88" />
      <Setter Property="Height" Value="104" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Tile" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="#244F719D" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Tile" Property="BorderBrush" Value="#AA9EC8FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ResizeHandle" TargetType="primitives:Thumb">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="primitives:Thumb">
            <Border Background="#01000000" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="DesktopSurface" BorderBrush="#28374A" BorderThickness="1" CornerRadius="0">
    <Grid>
      <ScrollViewer x:Name="IconScroll" Margin="8,43,8,30"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                    CanContentScroll="False" SizeChanged="IconViewportSizeChanged">
        <Canvas x:Name="IconCanvas" Background="#01000000" ClipToBounds="True"
                MouseLeftButtonDown="DesktopMouseLeftButtonDown">
          <Canvas.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Add app…" Click="AddAppClick" />
              <Separator />
              <MenuItem Header="Background image…" Click="ChooseBackgroundClick" />
              <MenuItem x:Name="TransparentBackgroundItem" Header="Transparent background" IsCheckable="True" Click="TransparentBackgroundClick" />
              <MenuItem x:Name="DefaultBackgroundItem" Header="Default background" IsCheckable="True" Click="DefaultBackgroundClick" />
              <Separator />
              <MenuItem Header="Arrange icons" Click="ArrangeIconsClick" />
              <MenuItem Header="Refresh" InputGestureText="F5" Click="RefreshClick" />
              <Separator />
              <MenuItem Header="Close MyNet desktop" Click="CloseClick" />
            </ContextMenu>
          </Canvas.ContextMenu>
        </Canvas>
      </ScrollViewer>

      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="24" Visibility="Collapsed" IsHitTestVisible="False">
        <TextBlock Text="Your local apps, at home." FontSize="15" FontWeight="SemiBold"
                   Foreground="#EEF3FC" TextAlignment="Center" />
        <TextBlock Text="Right-click anywhere to add an app.&#x0a;Double-click an icon to open it."
                   FontSize="11" Foreground="#BCC8DA" Margin="0,8,0,0" TextAlignment="Center" />
      </StackPanel>

      <TextBlock x:Name="CollectionLabel" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="18,0,18,11" FontSize="10" Foreground="#BFCBDC" Opacity="0.65"
                 IsHitTestVisible="False" Text="MyNet" />

      <Border x:Name="StatusToast" Margin="12,0,12,36" Padding="10,8" CornerRadius="7"
              Background="#EE182230" BorderBrush="#3F526D" BorderThickness="1"
              VerticalAlignment="Bottom" Visibility="Collapsed">
        <TextBlock x:Name="StatusText" FontSize="11" Foreground="#EDF3FC" TextWrapping="Wrap" />
      </Border>

      <Border x:Name="WindowControls" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,7,8,0" Padding="4,2" CornerRadius="7" Background="#ED16202E"
              ToolTip="Drag the grip to move MyNet. Drag an edge to resize.">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#9EB1CB"
                     Width="25" VerticalAlignment="Center" TextAlignment="Center" Cursor="SizeAll"
                     ToolTip="Move MyNet" MouseLeftButtonDown="MoveGripMouseLeftButtonDown" />
          <Button Style="{StaticResource DesktopControl}" Content="&#xE710;" ToolTip="Add app"
                  AutomationProperties.Name="Add app" Click="AddAppClick" />
          <Button Style="{StaticResource DesktopControl}" Content="&#xE921;" ToolTip="Minimize"
                  AutomationProperties.Name="Minimize MyNet" Click="MinimizeClick" />
          <Button x:Name="MaximizeButton" Style="{StaticResource DesktopControl}" Content="&#xE922;" ToolTip="Maximize MyNet"
                  AutomationProperties.Name="Maximize MyNet" Click="MaximizeClick" />
          <Button Style="{StaticResource DesktopControl}" Content="&#xE8BB;" ToolTip="Close MyNet desktop"
                  AutomationProperties.Name="Close MyNet desktop" Click="CloseClick" />
        </StackPanel>
      </Border>

      <primitives:Thumb Style="{StaticResource ResizeHandle}" Tag="Left" Cursor="SizeWE" Width="5" HorizontalAlignment="Left" Margin="0,12" DragDelta="ResizeHandleDragDelta" />
      <primitives:Thumb Style="{StaticResource ResizeHandle}" Tag="Right" Cursor="SizeWE" Width="5" HorizontalAlignment="Right" Margin="0,12" DragDelta="ResizeHandleDragDelta" />
      <primitives:Thumb Style="{StaticResource ResizeHandle}" Tag="Top" Cursor="SizeNS" Height="5" VerticalAlignment="Top" Margin="12,0" DragDelta="ResizeHandleDragDelta" />
      <primitives:Thumb Style="{StaticResource ResizeHandle}" Tag="Bottom" Cursor="SizeNS" Height="5" VerticalAlignment="Bottom" Margin="12,0" DragDelta="ResizeHandleDragDelta" />
      <primitives:Thumb Style="{StaticResource ResizeHandle}" Tag="TopLeft" Cursor="SizeNWSE" Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top" DragDelta="ResizeHandleDragDelta" />
      <primitives:Thumb Style="{StaticResource ResizeHandle}" Tag="TopRight" Cursor="SizeNESW" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Top" DragDelta="ResizeHandleDragDelta" />
      <primitives:Thumb Style="{StaticResource ResizeHandle}" Tag="BottomLeft" Cursor="SizeNESW" Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" DragDelta="ResizeHandleDragDelta" />
      <primitives:Thumb Style="{StaticResource ResizeHandle}" Tag="BottomRight" Cursor="SizeNWSE" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" DragDelta="ResizeHandleDragDelta" />
    </Grid>
  </Border>
</Window>
