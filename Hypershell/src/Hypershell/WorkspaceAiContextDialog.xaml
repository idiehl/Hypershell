<Window x:Class="Hypershell.WorkspaceAiContextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Context"
        Width="720"
        Height="760"
        MaxHeight="880"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <Style x:Key="ContextLabelStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PermissionLocationStyle" TargetType="{x:Type TextBox}">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource PanelBrush}"
          BorderBrush="#2E5D86"
          BorderThickness="1"
          CornerRadius="10"
          ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24"
                        ShadowDepth="8"
                        Opacity="0.58"
                        Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Background="#10151B"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
        <Grid Margin="16,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="DialogTitleText"
                     Text="New Context"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource ForegroundBrush}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Click="CancelClick"
                  Style="{StaticResource HeaderIconButtonStyle}"
                  Width="34"
                  Height="34"
                  ToolTip="Cancel">
            <Path Data="M 3 3 L 13 13 M 13 3 L 3 13"
                  Stroke="{StaticResource ForegroundBrush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,20">
          <TextBlock Text="CONTEXT NAME" Style="{StaticResource ContextLabelStyle}" />
          <TextBox x:Name="ContextNameTextBox" Margin="0,4,0,0" />

          <TextBlock Text="PERMISSIONS"
                     Style="{StaticResource ContextLabelStyle}"
                     Margin="0,17,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Read" Style="{StaticResource ContextLabelStyle}" />
            <ComboBox x:Name="ReadModeComboBox" Grid.Column="1" Margin="0,3,7,3"
                      SelectionChanged="PermissionModeChanged" />
            <TextBox x:Name="ReadLocationTextBox" Grid.Column="2" Margin="0,3"
                     Style="{StaticResource PermissionLocationStyle}" />
            <Button x:Name="ReadBrowseButton" Grid.Column="3" Content="Choose Location"
                    Tag="Read" Click="BrowsePermissionClick" Margin="7,3,0,3" Padding="9,5" />

            <TextBlock Grid.Row="1" Text="Create" Style="{StaticResource ContextLabelStyle}" />
            <ComboBox x:Name="CreateModeComboBox" Grid.Row="1" Grid.Column="1" Margin="0,3,7,3"
                      SelectionChanged="PermissionModeChanged" />
            <TextBox x:Name="CreateLocationTextBox" Grid.Row="1" Grid.Column="2" Margin="0,3"
                     Style="{StaticResource PermissionLocationStyle}" />
            <Button x:Name="CreateBrowseButton" Grid.Row="1" Grid.Column="3" Content="Choose Location"
                    Tag="Create" Click="BrowsePermissionClick" Margin="7,3,0,3" Padding="9,5" />

            <TextBlock Grid.Row="2" Text="Edit" Style="{StaticResource ContextLabelStyle}" />
            <ComboBox x:Name="EditModeComboBox" Grid.Row="2" Grid.Column="1" Margin="0,3,7,3"
                      SelectionChanged="PermissionModeChanged" />
            <TextBox x:Name="EditLocationTextBox" Grid.Row="2" Grid.Column="2" Margin="0,3"
                     Style="{StaticResource PermissionLocationStyle}" />
            <Button x:Name="EditBrowseButton" Grid.Row="2" Grid.Column="3" Content="Choose Location"
                    Tag="Edit" Click="BrowsePermissionClick" Margin="7,3,0,3" Padding="9,5" />

            <TextBlock Grid.Row="3" Text="Delete" Style="{StaticResource ContextLabelStyle}" />
            <ComboBox x:Name="DeleteModeComboBox" Grid.Row="3" Grid.Column="1" Margin="0,3,7,3"
                      SelectionChanged="PermissionModeChanged" />
            <TextBox x:Name="DeleteLocationTextBox" Grid.Row="3" Grid.Column="2" Margin="0,3"
                     Style="{StaticResource PermissionLocationStyle}" />
            <Button x:Name="DeleteBrowseButton" Grid.Row="3" Grid.Column="3" Content="Choose Location"
                    Tag="Delete" Click="BrowsePermissionClick" Margin="7,3,0,3" Padding="9,5" />

            <TextBlock Grid.Row="4" Text="Terminal" Style="{StaticResource ContextLabelStyle}" />
            <ComboBox x:Name="TerminalModeComboBox" Grid.Row="4" Grid.Column="1" Margin="0,3,7,3"
                      SelectionChanged="PermissionModeChanged" />
            <TextBox x:Name="TerminalLocationTextBox" Grid.Row="4" Grid.Column="2" Margin="0,3"
                     Style="{StaticResource PermissionLocationStyle}" />
            <Button x:Name="TerminalBrowseButton" Grid.Row="4" Grid.Column="3" Content="Choose Location"
                    Tag="Terminal" Click="BrowsePermissionClick" Margin="7,3,0,3" Padding="9,5" />
          </Grid>

          <Grid Margin="0,17,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="EFFORT" Style="{StaticResource ContextLabelStyle}" />
              <ComboBox x:Name="EffortComboBox" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="VERBOSITY" Style="{StaticResource ContextLabelStyle}" />
              <ComboBox x:Name="VerbosityComboBox" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>

          <CheckBox x:Name="AskPermissionCheckBox"
                    Content="Review permitted file/editor changes and terminal commands before they run"
                    ToolTip="Turn this off to let the model apply permitted changes and execute commands automatically. Context scopes and the global Stop control still apply."
                    Margin="1,17,0,3" />
          <CheckBox x:Name="InternetAccessCheckBox"
                    Content="Allow internet access"
                    Margin="1,4,0,3" />
          <CheckBox x:Name="LiveAssistanceCheckBox"
                    Content="Allow ongoing live assistance"
                    Margin="1,4,0,3" />

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="COMPUTER CONTROL"
                       Style="{StaticResource ContextLabelStyle}" />
            <ComboBox x:Name="ComputerControlComboBox"
                      Grid.Column="1"
                      ToolTip="Choose whether AI can use the mouse and keyboard in Hypershell or across the full Windows desktop." />
          </Grid>

          <TextBlock x:Name="ValidationText"
                     Foreground="{StaticResource AttentionBrush}"
                     TextWrapping="Wrap"
                     MinHeight="18"
                     Margin="0,10,0,0" />

          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="CANCEL"
                    Click="CancelClick"
                    Padding="12,8"
                    Margin="0,0,5,0"
                    IsCancel="True" />
            <Button Grid.Column="1"
                    Content="Save Context"
                    Click="SaveClick"
                    Padding="12,8"
                    Margin="5,0,0,0"
                    Background="{StaticResource SecondaryHoverBrush}"
                    IsDefault="True" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
