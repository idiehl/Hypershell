<Window x:Class="Hypershell.MyNetAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Title}"
        Width="1120"
        Height="800"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="WindowPreviewKeyDown"
        Closed="WindowClosed"
        StateChanged="WindowStateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="8"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Assets/Brand/hyperlib-shell-pages.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Border BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          Background="{StaticResource AppBackgroundBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Background="{StaticResource PanelBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="PrivacyColumn" Width="30" />
          <ColumnDefinition Width="34" />
          <ColumnDefinition Width="34" />
          <ColumnDefinition Width="34" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="AppIdentity" Margin="8,0,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                 Width="18" Height="18" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{Binding Title}"
                     VerticalAlignment="Center"
                     Margin="5,0,0,0"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis" />
        </Grid>
        <StackPanel x:Name="MeridianNavigation"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="4,0,0,0"
                    Visibility="Collapsed">
          <Button x:Name="CanvasBackButton"
                  Width="34"
                  Focusable="True"
                  Style="{StaticResource HeaderIconButtonStyle}"
                  IsEnabled="{Binding CanGoBack}"
                  Click="CanvasBackClick"
                  ToolTip="Back"
                  AutomationProperties.Name="Back"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
          </Button>
          <Button x:Name="CanvasForwardButton"
                  Width="34"
                  Focusable="True"
                  Style="{StaticResource HeaderIconButtonStyle}"
                  IsEnabled="{Binding CanGoForward}"
                  Click="CanvasForwardClick"
                  ToolTip="Forward"
                  AutomationProperties.Name="Forward"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
          </Button>
          <Button x:Name="FileMenuButton"
                  Width="48"
                  Focusable="True"
                  Click="FileMenuClick"
                  AutomationProperties.Name="File"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource HeaderIconButtonStyle}">
                <Style.Triggers>
                  <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
                  </Trigger>
                  <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <AccessText Text="_File" FontSize="12" Foreground="White" />
            <Button.ContextMenu>
              <ContextMenu x:Name="CanvasFileMenu" Placement="Bottom">
                <MenuItem Header="_Save" Tag="save" Click="FileCommandClick" />
                <MenuItem Header="Save _as" Tag="save-as" Click="FileCommandClick" />
                <MenuItem Header="Create _checkpoint" Tag="checkpoint" Click="FileCommandClick" />
                <MenuItem Header="_Duplicate" Tag="duplicate" Click="FileCommandClick" />
                <Separator />
                <MenuItem Header="_Import" Tag="import" Click="FileCommandClick" />
                <MenuItem Header="_History" Tag="history" Click="FileCommandClick" />
                <MenuItem Header="Pre_view" Tag="preview" Click="FileCommandClick" />
                <MenuItem Header="_Publish" Tag="publish" Click="FileCommandClick" />
                <MenuItem Header="_Export Work" Tag="export" Click="FileCommandClick" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="ToolsMenuButton"
                  Width="52"
                  Focusable="True"
                  Click="ToolsMenuClick"
                  AutomationProperties.Name="Tools"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource HeaderIconButtonStyle}">
                <Style.Triggers>
                  <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
                  </Trigger>
                  <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <AccessText Text="_Tools" FontSize="12" Foreground="White" />
            <Button.ContextMenu>
              <ContextMenu x:Name="CanvasToolsMenu" Placement="Bottom">
                <MenuItem Header="_Modules" Tag="modules" Click="ToolCommandClick" />
                <MenuItem Header="_Composition tools" Tag="composition" Click="ToolCommandClick" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <StackPanel x:Name="HyperlibIdentity"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Margin="10,0,0,0"
                      Visibility="Collapsed"
                      ToolTip="HyperLib">
            <Image Source="{StaticResource HyperlibLogo}" Width="24" Height="24"
                   AutomationProperties.Name="HyperLib" />
          </StackPanel>
          <ToggleButton x:Name="HyperlibEditToggle"
                        Visibility="Collapsed"
                        IsEnabled="False"
                        Height="28" Margin="12,0,0,0"
                        Padding="6,0"
                        VerticalAlignment="Center"
                        Click="HyperlibEditClick"
                        ToolTip="Edit Mode"
                        AutomationProperties.Name="Edit Mode"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="ToggleSurface" Background="Transparent" CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Edit Mode" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedForegroundBrush}" />
                    <Border x:Name="ToggleTrack" Width="26" Height="14" Margin="8,0,0,0"
                            Background="{StaticResource PanelRaisedBrush}" CornerRadius="7"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                      <Ellipse x:Name="ToggleThumb" Width="8" Height="8" Margin="2,0"
                               Fill="{StaticResource MutedForegroundBrush}" HorizontalAlignment="Left" />
                    </Border>
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="ToggleTrack" Property="Background" Value="#A3C7BD" />
                    <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#A3C7BD" />
                    <Setter TargetName="ToggleThumb" Property="Fill" Value="#131A1D" />
                    <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ToggleSurface" Property="Background" Value="{StaticResource PanelRaisedBrush}" />
                  </Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="#A3C7BD" />
                    <Setter TargetName="ToggleSurface" Property="BorderThickness" Value="1" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ToggleSurface" Property="Opacity" Value="0.5" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>
        </StackPanel>
        <TextBlock x:Name="PrivacyIndicator" Grid.Column="1"
                   Text="&#xE72E;"
                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                   FontSize="13"
                   Foreground="{StaticResource MutedForegroundBrush}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   ToolTip="Private MyNet window"
                   shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        <Button Grid.Column="2"
                Width="34"
                Style="{StaticResource HeaderIconButtonStyle}"
                Click="MinimizeClick"
                ToolTip="Minimize"
                AutomationProperties.Name="Minimize"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
        </Button>
        <Button Grid.Column="3"
                Width="34"
                x:Name="MaximizeButton"
                Style="{StaticResource HeaderIconButtonStyle}"
                Click="MaximizeClick"
                ToolTip="Maximize"
                AutomationProperties.Name="Maximize or restore"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock x:Name="MaximizeGlyph"
                     Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
        </Button>
        <Button Grid.Column="4"
                Width="34"
                Style="{StaticResource HeaderIconButtonStyle}"
                Click="CloseClick"
                ToolTip="Close"
                AutomationProperties.Name="Close"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" />
        </Button>
      </Grid>

      <ContentControl x:Name="BrowserHost" Grid.Row="1" />
    </Grid>
  </Border>
</Window>
