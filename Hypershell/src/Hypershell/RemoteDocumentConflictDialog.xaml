<Window x:Class="Hypershell.RemoteDocumentConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote document changed"
        Width="650"
        Height="330"
        MinWidth="560"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Border Background="{StaticResource PanelBrush}"
          BorderBrush="#2E5D86"
          BorderThickness="1"
          CornerRadius="10"
          ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24"
                        ShadowDepth="8"
                        Opacity="0.58"
                        Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="56" />
        <RowDefinition Height="*" />
        <RowDefinition Height="66" />
      </Grid.RowDefinitions>

      <Border Background="#10151B"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
        <Grid Margin="16,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Remote document changed"
                       FontSize="17"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="DocumentNameText"
                       FontSize="9.5"
                       Foreground="{StaticResource MutedForegroundBrush}" />
          </StackPanel>
          <Button Grid.Column="1"
                  Click="CancelClick"
                  Style="{StaticResource HeaderIconButtonStyle}"
                  Width="34"
                  Height="34"
                  ToolTip="Cancel">
            <Path Data="M 3 3 L 13 13 M 13 3 L 3 13"
                  Stroke="{StaticResource ForegroundBrush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="24,22">
        <TextBlock Text="The file on the linked device no longer matches the version you opened. Hypershell did not overwrite it."
                   TextWrapping="Wrap"
                   FontSize="13" />
        <TextBlock x:Name="LocationText"
                   Margin="0,14,0,0"
                   FontFamily="{StaticResource CodeFontFamily}"
                   Foreground="{StaticResource SecondaryBrush}"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="DetailText"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource MutedForegroundBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Border Grid.Row="2"
              Background="#10151B"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,1,0,0">
        <Grid Margin="18,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="1"
                  Content="Reload"
                  Click="ReloadClick"
                  Padding="14,7"
                  ToolTip="Discard local edits and load the current remote file." />
          <Button Grid.Column="2"
                  Content="Save Copy"
                  Click="SaveCopyClick"
                  Padding="14,7"
                  Margin="8,0,0,0"
                  ToolTip="Keep these edits by saving them as a local file." />
          <Button Grid.Column="3"
                  Content="Overwrite"
                  Click="OverwriteClick"
                  Padding="14,7"
                  Margin="8,0,0,0"
                  ToolTip="Replace the newer remote file with this document." />
          <Button Grid.Column="4"
                  Content="Cancel"
                  Click="CancelClick"
                  Padding="14,7"
                  Margin="8,0,0,0" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
