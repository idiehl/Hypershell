          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "type",
          "displayName": "Element type",
          "placeholder": "type",
          "description": "The compile-time list element type.",
          "typeName": "Java type",
          "defaultValue": "String",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "first",
          "displayName": "First value",
          "placeholder": "first",
          "description": "The first compatible value.",
          "typeName": "Java expression",
          "defaultValue": "\"alpha\"",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "second",
          "displayName": "Second value",
          "placeholder": "second",
          "description": "The second compatible value.",
          "typeName": "Java expression",
          "defaultValue": "\"beta\"",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        }
      ],
      "examples": [
        {
          "title": "Collect two labels",
          "code": "var items = new ArrayList<String>();\nitems.add(\"alpha\");\nitems.add(\"beta\");\nSystem.out.println(items);",
          "explanation": "The mutable list accepts two strings and prints them in insertion order."
        }
      ]
    },
    {
      "entryId": "java.map-of",
      "definition": "Map.of returns an unmodifiable map that rejects null keys and values and duplicate keys.",
      "parameters": [
        {
          "name": "name",
          "displayName": "Variable",
          "placeholder": "name",
          "description": "The map variable name.",
          "typeName": "Java identifier",
          "defaultValue": "status",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "firstKey",
          "displayName": "First key",
          "placeholder": "firstKey",
          "description": "The first non-null key.",
          "typeName": "Java expression",
          "defaultValue": "\"ready\"",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "firstValue",
          "displayName": "First value",
          "placeholder": "firstValue",
          "description": "The first non-null value.",
          "typeName": "Java expression",
          "defaultValue": "true",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "secondKey",
          "displayName": "Second key",
          "placeholder": "secondKey",
          "description": "The second unique key.",
          "typeName": "Java expression",
          "defaultValue": "\"count\"",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "secondValue",
          "displayName": "Second value",
          "placeholder": "secondValue",
          "description": "The second value.",
          "typeName": "Java expression",
          "defaultValue": "42",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "lookupKey",
          "displayName": "Lookup key",
          "placeholder": "lookupKey",
          "description": "The key whose value is printed.",
          "typeName": "Java expression",
          "defaultValue": "\"count\"",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        }
      ],
      "examples": [
        {
          "title": "Read a map value",
          "code": "var status = Map.of(\"ready\", true, \"count\", 42);\nSystem.out.println(status.get(\"count\"));",
          "explanation": "The immutable map returns 42 for the count key."
        }
      ]
    },
    {
      "entryId": "java.lambda-function",
      "definition": "A lambda supplies the implementation of a functional interface. Function<T,R> accepts one value and returns one result through apply.",
      "parameters": [
        {
          "name": "inputType",
          "displayName": "Input type",
          "placeholder": "inputType",
          "description": "The function input reference type.",
