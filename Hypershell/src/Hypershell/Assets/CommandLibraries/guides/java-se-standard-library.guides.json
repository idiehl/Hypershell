          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "outputType",
          "displayName": "Output type",
          "placeholder": "outputType",
          "description": "The function result reference type.",
          "typeName": "Java type",
          "defaultValue": "Integer",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "name",
          "displayName": "Function variable",
