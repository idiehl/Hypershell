        },
        {
          "name": "parameterName",
          "displayName": "Lambda parameter",
          "placeholder": "parameterName",
          "description": "The lambda input name.",
          "typeName": "Java identifier",
          "defaultValue": "value",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "expression",
          "displayName": "Expression",
          "placeholder": "expression",
          "description": "The result expression.",
          "typeName": "Java expression",
          "defaultValue": "value * 2",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "sample",
          "displayName": "Sample input",
          "placeholder": "sample",
          "description": "The value passed to apply.",
          "typeName": "Java expression",
          "defaultValue": "21",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        }
      ],
      "examples": [
        {
          "title": "Double an integer",
          "code": "Function<Integer, Integer> doubleValue = value -> value * 2;\nSystem.out.println(doubleValue.apply(21));",
          "explanation": "The typed lambda returns 42."
        }
      ]
    },
    {
      "entryId": "java.stream-pipeline",
      "definition": "Stream intermediate operations such as filter and map are lazy. A terminal operation such as toList initiates traversal and produces the result.",
      "parameters": [
        {
          "name": "name",
          "displayName": "Result variable",
          "placeholder": "name",
          "description": "The collected result list.",
          "typeName": "Java identifier",
          "defaultValue": "squares",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "values",
          "displayName": "Values",
          "placeholder": "values",
          "description": "Comma-separated stream source values.",
          "typeName": "Java expressions",
          "defaultValue": "1, 2, 3, 4",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "item",
          "displayName": "Item variable",
          "placeholder": "item",
          "description": "The lambda parameter name.",
          "typeName": "Java identifier",
          "defaultValue": "number",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "predicate",
          "displayName": "Predicate",
          "placeholder": "predicate",
          "description": "The Boolean filter expression.",
          "typeName": "Java expression",
          "defaultValue": "number % 2 == 0",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "expression",
          "displayName": "Mapping",
          "placeholder": "expression",
          "description": "The transformed result expression.",
          "typeName": "Java expression",
          "defaultValue": "number * number",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        }
      ],
      "examples": [
        {
          "title": "Square even numbers",
          "code": "var squares = List.of(1, 2, 3, 4).stream()\n    .filter(number -> number % 2 == 0)\n    .map(number -> number * number)\n    .toList();\nSystem.out.println(squares);",
          "explanation": "The terminal toList operation produces [4, 16]."
        }
      ]
    },
    {
      "entryId": "java.optional",
      "definition": "Optional models a value that may be absent. map transforms a present value without a null check, and orElse supplies a fallback.",
      "parameters": [
        {
          "name": "name",
          "displayName": "Result variable",
          "placeholder": "name",
          "description": "The unwrapped result variable.",
          "typeName": "Java identifier",
          "defaultValue": "label",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "value",
          "displayName": "Nullable value",
          "placeholder": "value",
          "description": "The possibly null source expression.",
          "typeName": "Java expression",
          "defaultValue": "\"hypershell\"",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "item",
          "displayName": "Item variable",
          "placeholder": "item",
          "description": "The map lambda parameter.",
          "typeName": "Java identifier",
          "defaultValue": "text",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "expression",
          "displayName": "Mapping",
          "placeholder": "expression",
          "description": "The expression applied when present.",
          "typeName": "Java expression",
          "defaultValue": "text.toUpperCase()",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "fallback",
          "displayName": "Fallback",
          "placeholder": "fallback",
          "description": "The value used when absent.",
          "typeName": "Java expression",
          "defaultValue": "\"UNKNOWN\"",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        }
      ],
      "examples": [
        {
          "title": "Normalize a present label",
          "code": "var label = Optional.ofNullable(\"hypershell\")\n    .map(text -> text.toUpperCase())\n    .orElse(\"UNKNOWN\");\nSystem.out.println(label);",
          "explanation": "The present string is transformed to HYPERSHELL."
        }
      ]
    },
    {
      "entryId": "java.files-read-string",
      "definition": "Files.writeString and Files.readString provide compact text-file operations. Their no-charset overloads use UTF-8.",
      "parameters": [
        {
          "name": "pathName",
          "displayName": "Path variable",
          "placeholder": "pathName",
          "description": "The temporary Path variable.",
          "typeName": "Java identifier",
          "defaultValue": "path",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "prefix",
          "displayName": "File prefix",
          "placeholder": "prefix",
          "description": "At least three filename characters without surrounding quotes.",
          "typeName": "Text",
          "defaultValue": "hypershell",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "text",
          "displayName": "Text",
          "placeholder": "text",
          "description": "The Java string written to the file.",
          "typeName": "Java string expression",
          "defaultValue": "\"ready\"",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        }
      ],
      "examples": [
        {
          "title": "Round-trip temporary text",
          "code": "var path = Files.createTempFile(\"hypershell\", \".txt\");\ntry {\n    Files.writeString(path, \"ready\");\n    System.out.println(Files.readString(path));\n} finally {\n    Files.deleteIfExists(path);\n}",
          "explanation": "The example prints ready and removes its temporary file even if reading fails."
        }
      ]
    },
    {
      "entryId": "java.completable-future",
      "definition": "CompletableFuture represents a value completed later. supplyAsync starts a supplier, thenApply transforms its result, and join waits while rethrowing failure as an unchecked completion exception.",
      "parameters": [
        {
          "name": "name",
          "displayName": "Future variable",
          "placeholder": "name",
          "description": "The CompletableFuture variable.",
          "typeName": "Java identifier",
          "defaultValue": "future",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "source",
          "displayName": "Supplier result",
          "placeholder": "source",
          "description": "The value produced asynchronously.",
          "typeName": "Java expression",
          "defaultValue": "21",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "item",
          "displayName": "Result variable",
          "placeholder": "item",
          "description": "The transformation lambda parameter.",
          "typeName": "Java identifier",
          "defaultValue": "value",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "expression",
          "displayName": "Transformation",
          "placeholder": "expression",
          "description": "The result transformation.",
          "typeName": "Java expression",
          "defaultValue": "value * 2",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        }
      ],
      "examples": [
        {
          "title": "Double an asynchronous value",
          "code": "var future = CompletableFuture.supplyAsync(() -> 21)\n    .thenApply(value -> value * 2);\nSystem.out.println(future.join());",
          "explanation": "The asynchronous pipeline completes with 42 before join returns."
        }
      ]
    }
  ]
}
