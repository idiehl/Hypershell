  "guides": [
    {
      "entryId": "java.println",
      "definition": "System.out is the process standard-output PrintStream. println converts its argument to text, writes it, and terminates the line.",
      "parameters": [
        {
          "name": "value",
          "displayName": "Value",
          "placeholder": "value",
          "description": "A Java expression to display.",
          "typeName": "Java expression",
          "defaultValue": "\"Hello from Hypershell\"",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        }
      ],
      "examples": [
        {
          "title": "Display a greeting",
          "code": "System.out.println(\"Hello from Hypershell\");",
          "explanation": "The string is compiled into the temporary program and written to standard output."
        }
      ]
    },
    {
      "entryId": "java.formatted-string",
      "definition": "String.formatted applies Formatter-style substitutions to the receiving string and returns the resulting text.",
      "parameters": [
        {
          "name": "name",
          "displayName": "Variable",
          "placeholder": "name",
          "description": "The local variable receiving the formatted string.",
          "typeName": "Java identifier",
          "defaultValue": "message",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "format",
          "displayName": "Format",
          "placeholder": "format",
          "description": "A Formatter-compatible string without surrounding quotes.",
          "typeName": "Format text",
          "defaultValue": "Result: %d",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        },
        {
          "name": "arguments",
          "displayName": "Arguments",
          "placeholder": "arguments",
          "description": "One or more comma-separated format arguments.",
          "typeName": "Java expressions",
          "defaultValue": "6 * 7",
          "isRequired": true,
          "isSwitch": false,
          "includeByDefault": true
        }
      ],
      "examples": [
        {
          "title": "Format a calculation",
          "code": "var message = \"Result: %d\".formatted(6 * 7);\nSystem.out.println(message);",
          "explanation": "The integer substitution produces Result: 42."
        }
      ]
    },
    {
      "entryId": "java.array-list",
