<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Hypershell"
           Manufacturer="Atlas Universalis"
           Version="$(var.ProductVersion)"
           UpgradeCode="9D66E404-62B8-48D0-9D48-347DB3E82AE0"
           Scope="perMachine"
           InstallerVersion="500">
    <SummaryInformation Description="Hypershell development workspace" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Hypershell is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Hypershell" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Hypershell" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Hypershell" Level="1">
      <ComponentGroupRef Id="PublishedFiles" />
    </Feature>
  </Package>
</Wix>
