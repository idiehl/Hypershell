{"schemaVersion":2,"libraryId":"alpinejs-popular","entries":[{"id":"alpinejs-popular.toggle-region","name":"toggle-region","displayName":"Toggle a region","description":"Creates local Alpine state and toggles an associated region with accessible button state.","definition":"Creates local Alpine state and toggles an associated region with accessible button state.","moduleName":"alpinejs","commandType":"Popular library recipe","preferredShellKind":"External","action":"Use","object":"Alpine.js","documentationUrl":"https://alpinejs.dev/start-here","keywords":["reactive","html directives","lightweight","frontend","toggle","a","region"],"template":"<section x-data=\"{ {stateName}: {initialValue} }\">\n  <button type=\"button\" @click=\"{stateName} = !{stateName}\" :aria-expanded=\"{stateName}\">\n    {label}\n  </button>\n  <div x-show=\"{stateName}\" x-cloak>{content}</div>\n</section>","compositionMode":"Statement","parameters":[],"examples":[],"symbolKind":"Element","coverageTier":"Guided","browsePath":[{"kind":"Library","name":"Alpine.js","displayName":"Alpine.js"},{"kind":"Recipe","name":"toggle-region","displayName":"Toggle a region"}],"legacyIds":[],"guideFile":"guides/alpinejs-popular.guides.json"},{"id":"alpinejs-popular.tabs","name":"tabs","displayName":"Create simple tabs","description":"Uses Alpine state to select one of two labeled tab panels.","definition":"Uses Alpine state to select one of two labeled tab panels.","moduleName":"alpinejs","commandType":"Popular library recipe","preferredShellKind":"External","action":"Use","object":"Alpine.js","documentationUrl":"https://alpinejs.dev/start-here","keywords":["reactive","html directives","lightweight","frontend","create","simple","tabs"],"template":"<div x-data=\"{ tab: '{firstId}' }\">\n  <div role=\"tablist\">\n    <button role=\"tab\" @click=\"tab = '{firstId}'\" :aria-selected=\"tab === '{firstId}'\">{firstLabel}</button>\n    <button role=\"tab\" @click=\"tab = '{secondId}'\" :aria-selected=\"tab === '{secondId}'\">{secondLabel}</button>\n  </div>\n  <section x-show=\"tab === '{firstId}'\" role=\"tabpanel\">{firstContent}</section>\n  <section x-show=\"tab === '{secondId}'\" role=\"tabpanel\">{secondContent}</section>\n</div>","compositionMode":"Statement","parameters":[],"examples":[],"symbolKind":"Element","coverageTier":"Guided","browsePath":[{"kind":"Library","name":"Alpine.js","displayName":"Alpine.js"},{"kind":"Recipe","name":"tabs","displayName":"Create simple tabs"}],"legacyIds":[],"guideFile":"guides/alpinejs-popular.guides.json"},{"id":"alpinejs-popular.load-data","name":"load-data","displayName":"Load JSON into a component","description":"Defines Alpine component state and loads remote JSON during initialization.","definition":"Defines Alpine component state and loads remote JSON during initialization.","moduleName":"alpinejs","commandType":"Popular library recipe","preferredShellKind":"External","action":"Use","object":"Alpine.js","documentationUrl":"https://alpinejs.dev/start-here","keywords":["reactive","html directives","lightweight","frontend","load","json","into","a","component"],"template":"<section x-data=\"{ items: [], loading: true, async init() { const response = await fetch('{url}'); if (!response.ok) throw new Error(`HTTP ${response.status}`); this.items = await response.json(); this.loading = false; } }\">\n  <p x-show=\"loading\">{loadingText}</p>\n  <template x-for=\"item in items\" :key=\"item.{keyProperty}\">\n    <p x-text=\"item.{labelProperty}\"></p>\n  </template>\n</section>","compositionMode":"Statement","parameters":[],"examples":[],"symbolKind":"Element","coverageTier":"Guided","browsePath":[{"kind":"Library","name":"Alpine.js","displayName":"Alpine.js"},{"kind":"Recipe","name":"load-data","displayName":"Load JSON into a component"}],"legacyIds":[],"guideFile":"guides/alpinejs-popular.guides.json"}]}
