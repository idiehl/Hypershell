{"schemaVersion":2,"libraryId":"bootstrap-html-popular","entries":[{"id":"bootstrap-html-popular.responsive-navbar","name":"responsive-navbar","displayName":"Add a responsive navbar","description":"Creates a Bootstrap navbar that collapses behind a menu button on smaller screens.","definition":"Creates a Bootstrap navbar that collapses behind a menu button on smaller screens.","moduleName":"Bootstrap","commandType":"Popular library recipe","preferredShellKind":"External","action":"Use","object":"Bootstrap","documentationUrl":"https://getbootstrap.com/docs/5.3/getting-started/introduction/","keywords":["responsive","components","layout","css framework","add","a","navbar"],"template":"<nav class=\"navbar navbar-expand-lg bg-body-tertiary\">\n  <div class=\"container-fluid\">\n    <a class=\"navbar-brand\" href={homeUrl}>{brand}</a>\n    <button class=\"navbar-toggler\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#{collapseId}\" aria-controls={collapseId} aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n      <span class=\"navbar-toggler-icon\"></span>\n    </button>\n    <div class=\"collapse navbar-collapse\" id={collapseId}>\n      <div class=\"navbar-nav\"><a class=\"nav-link active\" href={homeUrl}>Home</a></div>\n    </div>\n  </div>\n</nav>","compositionMode":"Statement","parameters":[],"examples":[],"symbolKind":"Element","coverageTier":"Guided","browsePath":[{"kind":"Library","name":"Bootstrap","displayName":"Bootstrap"},{"kind":"Recipe","name":"responsive-navbar","displayName":"Add a responsive navbar"}],"legacyIds":[],"guideFile":"guides/bootstrap-html-popular.guides.json"},{"id":"bootstrap-html-popular.content-card","name":"content-card","displayName":"Add a content card","description":"Creates a Bootstrap card with a title, body, and action.","definition":"Creates a Bootstrap card with a title, body, and action.","moduleName":"Bootstrap","commandType":"Popular library recipe","preferredShellKind":"External","action":"Use","object":"Bootstrap","documentationUrl":"https://getbootstrap.com/docs/5.3/getting-started/introduction/","keywords":["responsive","components","layout","css framework","add","a","content","card"],"template":"<article class=\"card\" style=\"max-width: {maximumWidth};\">\n  <div class=\"card-body\">\n    <h2 class=\"card-title h5\">{title}</h2>\n    <p class=\"card-text\">{body}</p>\n    <a class=\"btn btn-primary\" href={actionUrl}>{actionLabel}</a>\n  </div>\n</article>","compositionMode":"Statement","parameters":[],"examples":[],"symbolKind":"Element","coverageTier":"Guided","browsePath":[{"kind":"Library","name":"Bootstrap","displayName":"Bootstrap"},{"kind":"Recipe","name":"content-card","displayName":"Add a content card"}],"legacyIds":[],"guideFile":"guides/bootstrap-html-popular.guides.json"},{"id":"bootstrap-html-popular.validated-form-field","name":"validated-form-field","displayName":"Add a labeled form field","description":"Creates an accessible Bootstrap input with help text.","definition":"Creates an accessible Bootstrap input with help text.","moduleName":"Bootstrap","commandType":"Popular library recipe","preferredShellKind":"External","action":"Use","object":"Bootstrap","documentationUrl":"https://getbootstrap.com/docs/5.3/getting-started/introduction/","keywords":["responsive","components","layout","css framework","add","a","labeled","form","field"],"template":"<div class=\"mb-3\">\n  <label class=\"form-label\" for={inputId}>{label}</label>\n  <input class=\"form-control\" id={inputId} name={inputName} type={inputType} aria-describedby=\"{inputId}Help\">\n  <div class=\"form-text\" id=\"{inputId}Help\">{helpText}</div>\n</div>","compositionMode":"Statement","parameters":[],"examples":[],"symbolKind":"Element","coverageTier":"Guided","browsePath":[{"kind":"Library","name":"Bootstrap","displayName":"Bootstrap"},{"kind":"Recipe","name":"validated-form-field","displayName":"Add a labeled form field"}],"legacyIds":[],"guideFile":"guides/bootstrap-html-popular.guides.json"}]}
