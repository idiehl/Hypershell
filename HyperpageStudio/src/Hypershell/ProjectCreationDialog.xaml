<Window x:Class="Hypershell.ProjectCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Project"
        Width="610"
        Height="510"
        MinWidth="520"
        MinHeight="430"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Border Background="{StaticResource PanelBrush}"
          BorderBrush="#2E5D86"
          BorderThickness="1"
          CornerRadius="10"
          ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24"
                        ShadowDepth="8"
                        Opacity="0.58"
                        Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="56" />
        <RowDefinition Height="*" />
        <RowDefinition Height="58" />
      </Grid.RowDefinitions>

      <Border Background="#10151B"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
        <Grid Margin="16,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="+"
                     FontSize="28"
                     Foreground="{StaticResource SecondaryBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,11,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Create Project"
                       FontSize="17"
                       FontWeight="SemiBold" />
            <TextBlock Text="Project folders"
                       FontSize="9.5"
                       Foreground="{StaticResource MutedForegroundBrush}" />
          </StackPanel>
          <Button Grid.Column="2"
                  Click="CancelClick"
                  Style="{StaticResource HeaderIconButtonStyle}"
                  Width="34"
                  Height="34"
                  ToolTip="Cancel">
            <Path Data="M 3 3 L 13 13 M 13 3 L 3 13"
                  Stroke="{StaticResource ForegroundBrush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="22,18,22,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="PROJECT NAME"
                   FontSize="10"
                   FontWeight="Bold"
                   Foreground="{StaticResource SecondaryBrush}"
                   Margin="0,0,0,4" />
        <TextBox x:Name="ProjectNameTextBox"
                 Grid.Row="1"
                 MinHeight="34" />

        <Grid Grid.Row="2" Margin="0,17,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="PROJECT DIRECTORIES"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{StaticResource SecondaryBrush}" />
            <TextBlock Text="Expandable roots"
                       FontSize="9.5"
                       Foreground="{StaticResource MutedForegroundBrush}" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="Add"
                  Click="AddFolderClick"
                  Padding="10,4" />
        </Grid>

        <ListBox x:Name="ProjectDirectoriesList"
                 Grid.Row="3"
                 MinHeight="145">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}"
                         FontFamily="{StaticResource CodeFontFamily}"
                         FontSize="10"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4" Margin="0,7,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Profile only"
                     Foreground="{StaticResource MutedForegroundBrush}"
                     FontSize="9.5"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="Remove"
                  Click="RemoveFolderClick"
                  Margin="10,0,0,0"
                  Padding="9,3" />
        </Grid>
      </Grid>

      <Border Grid.Row="2"
              Background="#10151B"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,1,0,0">
        <Grid Margin="18,9">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText"
                     Foreground="{StaticResource MutedForegroundBrush}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="Cancel"
                  Click="CancelClick"
                  Padding="16,7"
                  Margin="8,0" />
          <Button Grid.Column="2"
                  Content="Create"
                  Click="CreateClick"
                  Padding="18,7"
                  Background="{StaticResource AccentHoverBrush}"
                  IsDefault="True" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
