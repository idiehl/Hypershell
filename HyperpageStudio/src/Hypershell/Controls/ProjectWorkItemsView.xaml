<UserControl x:Class="Hypershell.Controls.ProjectWorkItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Hypershell.ViewModels"
             MinWidth="220">
  <UserControl.Resources>
    <Style x:Key="WorkItemIconButtonStyle"
           TargetType="{x:Type Button}">
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="#FF21262D" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>
    <Style x:Key="WorkItemDeleteButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource WorkItemIconButtonStyle}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{StaticResource AttentionBrush}" />
          <Setter Property="Background" Value="#332F1518" />
          <Setter Property="BorderBrush" Value="{StaticResource AttentionBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WorkItemLabelStyle"
           TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="32" />
      </Grid.ColumnDefinitions>
      <ComboBox ItemsSource="{Binding Projects}"
                SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                ToolTip="Choose backlog">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"
                       TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="1"
              Command="{Binding RefreshCommand}"
              Content="↻"
              FontSize="16"
              Margin="5,0,0,0"
              Padding="0"
              ToolTip="Refresh tasks" />
      <Button Grid.Column="2"
              Command="{Binding AddWorkItemCommand}"
              Content="+"
              FontSize="19"
              Margin="5,0,0,0"
              Padding="0"
              ToolTip="Add work item" />
    </Grid>

    <Border Grid.Row="1"
            Margin="0,9,0,8"
            Padding="9"
            Background="#FF161B22"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="8"
            Visibility="{Binding IsCreating, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel>
        <TextBlock Text="Add a Task"
                   FontSize="11"
                   FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0,0,0,8" />
        <TextBlock Text="Topic"
                   Style="{StaticResource WorkItemLabelStyle}" />
        <TextBox Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8" />
        <TextBlock Text="Description"
                   Style="{StaticResource WorkItemLabelStyle}" />
        <TextBox Text="{Binding DraftDescription, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="92"
                 MaxHeight="210"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,8" />
        <Grid Margin="0,0,0,5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="ATTACHMENT"
                     Style="{StaticResource WorkItemLabelStyle}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="+"
                  Click="AddDraftAttachmentsClick"
                  Style="{StaticResource WorkItemIconButtonStyle}"
                  FontSize="17"
                  ToolTip="Add attachment" />
        </Grid>
        <ItemsControl ItemsSource="{Binding DraftAttachments}"
                      Margin="0,0,0,5">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type viewModels:ProjectWorkItemAttachmentViewModel}">
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Button Content="{Binding FileName}"
                        Tag="{Binding}"
                        Click="OpenAttachmentClick"
                        HorizontalContentAlignment="Left"
                        Padding="6,2" />
                <Button Grid.Column="1"
                        Content="×"
                        Command="{Binding DataContext.RemoveDraftAttachmentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource WorkItemIconButtonStyle}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
          <Button Content="×"
                  Command="{Binding CancelWorkItemCommand}"
                  Style="{StaticResource WorkItemIconButtonStyle}"
                  Foreground="{StaticResource AttentionBrush}"
                  FontSize="17"
                  ToolTip="Cancel" />
          <Button Content="Post"
                  Command="{Binding SubmitWorkItemCommand}"
                  Margin="6,0,0,0"
                  Padding="10,3" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2">
      <TextBlock Text="No items"
                 Foreground="{StaticResource MutedForegroundBrush}"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="20"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

      <ListBox x:Name="WorkItemList"
               ItemsSource="{Binding Items}"
               Background="Transparent"
               BorderThickness="0"
               Padding="0"
               AllowDrop="True"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               PreviewMouseLeftButtonDown="WorkItemListPreviewMouseLeftButtonDown"
               PreviewMouseMove="WorkItemListPreviewMouseMove"
               DragOver="WorkItemListDragOver"
               Drop="WorkItemListDrop">
        <ListBox.ItemContainerStyle>
          <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type viewModels:ProjectWorkItemViewModel}">
            <Border Background="#FF161B22"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="7">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="28" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="⋮⋮"
                             Foreground="{StaticResource MutedForegroundBrush}"
                             VerticalAlignment="Center"
                             Cursor="SizeAll" />
                  <Button Grid.Column="1"
                          Content="{Binding StarGlyph}"
                          Command="{Binding ToggleStarCommand}"
                          Foreground="{StaticResource SecondaryBrush}"
                          Style="{StaticResource WorkItemIconButtonStyle}"
                          ToolTip="Prioritize task" />
                  <TextBlock Grid.Column="2"
                             Text="{Binding Title}"
                             TextTrimming="CharacterEllipsis"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Margin="6,0" />
                  <Button Grid.Column="3"
                          Content="≡"
                          Command="{Binding BeginEditCommand}"
                          IsEnabled="{Binding IsNotEditing}"
                          Style="{StaticResource WorkItemIconButtonStyle}"
                          FontSize="17"
                          ToolTip="Edit work item" />
                  <Button Grid.Column="4"
                          Content="×"
                          Command="{Binding DeleteCommand}"
                          Style="{StaticResource WorkItemDeleteButtonStyle}"
                          ToolTip="Delete work item" />
                </Grid>

                <Border Margin="39,8,0,1"
                        Padding="8"
                        Background="#FF0D1117"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <StackPanel>
                    <TextBlock Text="TITLE"
                               Style="{StaticResource WorkItemLabelStyle}" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8" />
                    <TextBlock Text="ITEM"
                               Style="{StaticResource WorkItemLabelStyle}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="80"
                             MaxHeight="210"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="ATTACHMENTS"
                                 Style="{StaticResource WorkItemLabelStyle}"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="1"
                              Content="Add"
                              Tag="{Binding}"
                              Click="AddItemAttachmentsClick"
                              Padding="7,2" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Attachments}"
                                  Margin="0,0,0,6">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <Button Content="{Binding FileName}"
                                    Tag="{Binding}"
                                    Click="OpenAttachmentClick"
                                    HorizontalContentAlignment="Left"
                                    Padding="6,2" />
                            <Button Grid.Column="1"
                                    Content="×"
                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource WorkItemIconButtonStyle}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                      <Button Content="Cancel"
                              Command="{Binding CancelEditCommand}"
                              Padding="9,3" />
                      <Button Content="Save"
                              Command="{Binding SaveEditCommand}"
                              Margin="6,0,0,0"
                              Padding="9,3" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <StackPanel Grid.Row="3"
                Margin="1,8,1,0">
      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="{StaticResource MutedForegroundBrush}"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
