<UserControl x:Class="Hypershell.Controls.MonacoEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:webView="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#0D1117"
             Focusable="False">
  <Grid Background="#0D1117">
    <webView:WebView2 x:Name="EditorWebView"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
    <Border x:Name="EditorStatusOverlay"
            Background="#0D1117"
            Padding="28">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="520">
        <TextBlock Text="&lt;/&gt;"
                   FontFamily="{StaticResource CodeFontFamily}"
                   Foreground="{StaticResource SecondaryBrush}"
                   FontSize="34"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="EditorStatusText"
                   Text="Opening editor…"
                   Foreground="{StaticResource MutedForegroundBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
