<UserControl x:Class="Hypershell.Controls.MarkdownPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:webView="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#FF0D1117"
             Focusable="False">
  <Grid Background="#FF0D1117">
    <webView:WebView2 x:Name="PreviewWebView"
                      DefaultBackgroundColor="#0D1117"
                      Visibility="Collapsed"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
    <Border x:Name="PreviewStatusOverlay"
            Background="#FF0D1117"
            Padding="28">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="520">
        <TextBlock Text="MD"
                   FontFamily="{StaticResource CodeFontFamily}"
                   Foreground="{StaticResource SecondaryBrush}"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="PreviewStatusText"
                   Text="Preparing Markdown preview…"
                   Foreground="{StaticResource MutedForegroundBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
