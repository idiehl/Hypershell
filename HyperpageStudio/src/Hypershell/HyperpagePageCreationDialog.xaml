<Window x:Class="Hypershell.HyperpagePageCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Page"
        Width="640"
        Height="590"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}"
        Foreground="{StaticResource ForegroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Border Background="{StaticResource PanelBrush}"
          BorderBrush="#2E5D86"
          BorderThickness="1"
          CornerRadius="10"
          ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.58" Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="*" />
        <RowDefinition Height="70" />
      </Grid.RowDefinitions>

      <Border Background="#10151B"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
        <Grid Margin="18,0,9,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="8"
                  Background="{StaticResource SecondaryTintBrush}"
                  BorderBrush="{StaticResource SecondaryBrush}"
                  BorderThickness="1"
                  Margin="0,0,12,0">
            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons"
                       FontSize="18" Foreground="{StaticResource SecondaryVividBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="HeadingText" Text="Page" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText" Text="Describe page"
                       FontSize="11" Foreground="{StaticResource MutedForegroundBrush}" />
          </StackPanel>
          <Button x:Name="CloseButton" Grid.Column="2" Click="CancelClick"
                  Style="{StaticResource HeaderIconButtonStyle}"
                  Width="36" Height="36"
                  AutomationProperties.Name="Cancel page creation"
                  ToolTip="Cancel">
            <Path Data="M 3 3 L 13 13 M 13 3 L 3 13"
                  Stroke="{StaticResource ForegroundBrush}" StrokeThickness="1.5" />
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,16">
          <TextBlock x:Name="NameLabel" Text="PAGE NAME" FontSize="10" FontWeight="Bold"
                     Foreground="{StaticResource SecondaryVividBrush}" />
          <TextBox x:Name="PageNameTextBox"
                   MinHeight="36"
                   Margin="0,5,0,14"
                   Text="New Page"
                   ToolTip="Page name" />

          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="TemplateSection">
              <TextBlock Text="PAGE TEMPLATE" FontSize="10" FontWeight="Bold"
                         Foreground="{StaticResource SecondaryVividBrush}" />
              <ComboBox x:Name="TemplateComboBox"
                        Margin="0,5,0,0"
                        MinHeight="34"
                        ItemsSource="{Binding TemplateOptions}"
                        DisplayMemberPath="Name"
                        ToolTip="Page template" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="FILE TYPE" FontSize="10" FontWeight="Bold"
                         Foreground="{StaticResource SecondaryVividBrush}" />
              <ComboBox x:Name="FileTypeComboBox"
                        Margin="0,5,0,0"
                        MinHeight="34"
                        ItemsSource="{Binding FileTypeOptions}"
                        DisplayMemberPath="Name"
                        SelectionChanged="FileTypeSelectionChanged"
                        ToolTip="File type" />
            </StackPanel>
          </Grid>

          <StackPanel x:Name="PageDescriptionSection">
          <TextBlock Text="DESCRIBE THIS PAGE" FontSize="10" FontWeight="Bold"
                     Foreground="{StaticResource SecondaryVividBrush}" />
          <TextBox x:Name="DescriptionTextBox"
                   MinHeight="155"
                   MaxHeight="230"
                   Margin="0,5,0,0"
                   Padding="9"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   AutomationProperties.Name="Describe this page"
                   ToolTip="AI page prompt" />
          <TextBlock Text="AI starts next."
                     Margin="0,7,0,0"
                     FontSize="11"
                     Foreground="{StaticResource MutedForegroundBrush}"
                     TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel x:Name="StylesheetSection" Visibility="Collapsed">
            <CheckBox x:Name="LinkStylesheetCheckBox" Content="Use on this page"
                      IsChecked="True" Margin="0,0,0,10"
                      ToolTip="Add an explicit stylesheet link to the current page only" />
            <TextBlock Text="Plain CSS, ready for the browser. Edit it directly in Studio; no build step or AI prompt is needed."
                       FontSize="11" Foreground="{StaticResource MutedForegroundBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="StylesheetLocationText" Margin="0,8,0,0"
                       FontSize="11" Foreground="{StaticResource MutedForegroundBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2"
              Background="#10151B"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,1,0,0">
        <Grid Margin="18,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText"
                     Foreground="#FFFF7B72"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Margin="0,0,12,0" />
          <Button Grid.Column="1"
                  Content="Cancel"
                  Click="CancelClick"
                  MinWidth="88"
                  Margin="0,0,8,0"
                  ToolTip="Cancel" />
          <Button x:Name="CreateButton" Grid.Column="2"
                  Content="Create"
                  Click="CreateClick"
                  MinWidth="118"
                  Background="{StaticResource AccentHoverBrush}"
                  BorderBrush="{StaticResource AccentBrush}"
                  FontWeight="SemiBold"
                  ToolTip="Create page" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
