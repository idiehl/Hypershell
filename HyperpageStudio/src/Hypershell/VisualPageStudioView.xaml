<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Hypershell.Models"
             xmlns:viewModels="clr-namespace:Hypershell.ViewModels"
             xmlns:controls="clr-namespace:Hypershell.Controls"
             x:Class="Hypershell.VisualPageStudioView"
             Background="{StaticResource AppBackgroundBrush}"
             FontFamily="{StaticResource UiFontFamily}"
             FontSize="13"
             Foreground="{StaticResource ForegroundBrush}"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             Focusable="True"
             PreviewKeyDown="StudioPreviewKeyDown">
  <UserControl.Resources>
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="StudioToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="Auto" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="0,4,6,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StudioPrimaryButtonStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource StudioToolButtonStyle}">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="StudioDestructiveButtonStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource StudioToolButtonStyle}">
      <Setter Property="Foreground" Value="{StaticResource AttentionBrush}" />
    </Style>
    <Style x:Key="StudioIconButtonStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource StudioToolButtonStyle}">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="StudioToolbarIconButtonStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource StudioIconButtonStyle}">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="38" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="220" />
    </Style>
    <Style x:Key="StudioToolbarPrimaryIconButtonStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource StudioToolbarIconButtonStyle}">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style x:Key="StudioToolbarComboBoxStyle" TargetType="{x:Type ComboBox}"
           BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="220" />
    </Style>
    <Style x:Key="StudioToolbarToggleButtonStyle" TargetType="{x:Type ToggleButton}">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="38" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="220" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Border x:Name="ToggleBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleBorder" Property="Background"
                        Value="{StaticResource PanelRaisedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ToggleBorder" Property="Background"
                        Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ToggleBorder" Property="BorderBrush"
                        Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleBorder" Property="Background"
                        Value="{StaticResource SecondaryTintBrush}" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryVividBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StudioToolbarGroupStyle" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style x:Key="StudioDockedToolbarGroupStyle" TargetType="{x:Type Border}"
           BasedOn="{StaticResource StudioToolbarGroupStyle}">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Geometry x:Key="StudioDoubleChevronGeometry">M 9 2 L 2 12 L 9 22 M 20 2 L 13 12 L 20 22</Geometry>
    <Style x:Key="StudioPanelToggleButtonStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource WorkspacePanelToggleButtonStyle}">
      <Setter Property="Height" Value="32" />
    </Style>
    <Style x:Key="StudioPaneCloseButtonStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource StudioIconButtonStyle}">
      <Setter Property="Width" Value="27" />
      <Setter Property="Height" Value="27" />
      <Setter Property="MinWidth" Value="27" />
      <Setter Property="MinHeight" Value="27" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="StudioTabCloseButtonStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource StudioPaneCloseButtonStyle}">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="20" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Margin" Value="5,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Value="True">
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Value="True">
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StudioToolbarLabelStyle" TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource SecondaryVividBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="2,0,6,0" />
    </Style>
    <Style x:Key="StudioTabItemStyle" TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Margin" Value="1,1,1,1" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabItem}">
            <Border x:Name="ToolTabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                    BorderThickness="0,0,0,2"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ToolTabBorder" Property="Background"
                        Value="{StaticResource PanelRaisedBrush}" />
                <Setter TargetName="ToolTabBorder" Property="BorderBrush"
                        Value="{StaticResource SecondaryBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToolTabBorder" Property="Background"
                        Value="{StaticResource PanelRaisedBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ToolTabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StudioTabControlStyle" TargetType="{x:Type TabControl}"
           BasedOn="{StaticResource {x:Type TabControl}}">
      <Setter Property="ItemContainerStyle" Value="{StaticResource StudioTabItemStyle}" />
      <Setter Property="Padding" Value="4,4,4,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabControl}">
            <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="0,0,0,1">
                <WrapPanel x:Name="HeaderPanel" IsItemsHost="True" Margin="{TemplateBinding Padding}" />
              </Border>
              <Border Grid.Row="1" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter x:Name="PART_SelectedContentHost" Content="{TemplateBinding SelectedContent}"
                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                  ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                  ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StudioDockedToolTabControlStyle" TargetType="{x:Type TabControl}"
           BasedOn="{StaticResource StudioTabControlStyle}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabControl}">
            <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
              <WrapPanel x:Name="HeaderPanel" IsItemsHost="True"
                         Visibility="Collapsed" />
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  Content="{TemplateBinding SelectedContent}"
                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                  ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                  ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StudioPanelHeaderOptionStyle" TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="OptionBorder"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="OptionBorder" Property="Background"
                        Value="{StaticResource PanelBrush}" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryVividBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="OptionBorder" Property="Background"
                        Value="{StaticResource SecondaryTintBrush}" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryVividBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StudioPanelHeaderSelectorStyle" TargetType="{x:Type ComboBox}">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="MaxWidth" Value="180" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="8,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource StudioPanelHeaderOptionStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <ToggleButton x:Name="HeaderToggle"
                            Focusable="False"
                            ClickMode="Press"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Padding="{TemplateBinding Padding}"
                            Content="{Binding SelectedItem.Header, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="HeaderSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Margin="{TemplateBinding Padding}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Border x:Name="ArrowSurface"
                                Grid.Column="1"
                                 Width="24"
                                 Background="Transparent"
                                 BorderBrush="Transparent"
                                 BorderThickness="0">
                          <Path Data="M 1 2 L 6 7 L 11 2"
                                Width="12"
                                Height="8"
                                Stretch="Fill"
                                Stroke="{TemplateBinding Foreground}"
                                StrokeThickness="1.8"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="HeaderSurface" Property="Background"
                                Value="{StaticResource PanelBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="HeaderSurface" Property="Background"
                                Value="{StaticResource PanelRaisedBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True"
                     PopupAnimation="Fade"
                     Focusable="False">
                <Border MinWidth="150"
                        MaxHeight="420"
                        Background="{StaticResource PanelRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="2">
                  <ScrollViewer CanContentScroll="True"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StudioCanvasTabControlStyle" TargetType="{x:Type TabControl}"
           BasedOn="{StaticResource StudioTabControlStyle}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabControl}">
            <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="{StaticResource PanelBrush}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="CanvasTabHeaderScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                <StackPanel Orientation="Horizontal"
                            Margin="{TemplateBinding Padding}">
                  <WrapPanel x:Name="HeaderPanel" IsItemsHost="True" />
                  <Button Style="{StaticResource TerminalTabAddButtonStyle}"
                          Focusable="True"
                          Click="NewProjectDocumentClick"
                          AutomationProperties.Name="Create document"
                          ToolTip="New document">
                    <Path Data="M 7 0 L 7 14 M 0 7 L 14 7"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                  </Button>
                </StackPanel>
                </ScrollViewer>
                  <Button Grid.Column="1" Content="?" Click="ActivePaneFileHelpClick" Width="28" Height="28"
                          Margin="8,0,8,0" Padding="0" VerticalAlignment="Center"
                          Style="{StaticResource StudioToolbarIconButtonStyle}"
                          Tag="{Binding SelectedItem.Tag, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"
                          AutomationProperties.Name="Explain active document"
                          ToolTip="{Binding SelectedItem.Header.Children[0].Text, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}, StringFormat=About {0}}" />
                </Grid>
              </Border>
              <Border Grid.Row="1"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  Content="{TemplateBinding SelectedContent}"
                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                  ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                  ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StudioFieldLabelStyle" TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,10,0,5" />
    </Style>
    <Style x:Key="StudioSectionHeadingStyle" TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="StudioHelpTextStyle" TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontFamily" Value="{StaticResource TerminalTabChromeFontFamily}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,3,0,6" />
    </Style>
    <Style x:Key="StudioCodeTextStyle" TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource StudioHelpTextStyle}">
      <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style x:Key="StudioSectionStyle" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="StudioCalloutStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource StudioSectionStyle}">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style x:Key="StudioWarningStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource StudioCalloutStyle}">
      <Setter Property="Background" Value="{StaticResource SecondaryTintBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
    </Style>
    <Style x:Key="StudioDescriptorBadgeStyle" TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <DataTemplate x:Key="StudioActionTextTemplate">
      <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
    </DataTemplate>
    <DataTemplate x:Key="StudioPropertyEntryTemplate">
      <StackPanel Margin="5,5">
        <TextBlock Text="{Binding Name}" Style="{StaticResource StudioCodeTextStyle}" Margin="0,0,0,3" />
        <TextBlock Text="{Binding Value}" Style="{StaticResource StudioHelpTextStyle}"
                   Foreground="{StaticResource ForegroundBrush}"
                   Margin="0" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="StudioDiagnosticTemplate">
      <StackPanel Margin="5,6">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0">
            <TextBlock.Style>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Severity}"
                               Value="{x:Static models:VisualPageDiagnosticSeverity.Error}">
                    <Setter Property="Foreground" Value="{StaticResource AttentionBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Severity}"
                               Value="{x:Static models:VisualPageDiagnosticSeverity.Warning}">
                    <Setter Property="Foreground" Value="{StaticResource SecondaryVividBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Code}" Style="{StaticResource StudioCodeTextStyle}" FontSize="11" Margin="0" />
        </StackPanel>
        <TextBlock Text="{Binding Message}" Style="{StaticResource StudioHelpTextStyle}" Margin="0,4,0,0" />
      </StackPanel>
    </DataTemplate>
    <Style x:Key="StudioTreeItemStyle" TargetType="{x:Type TreeViewItem}">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TreeViewItem}">
            <StackPanel>
              <Border x:Name="TreeHeader" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                      CornerRadius="3"
                      Padding="0,2"
                      Margin="0,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ToggleButton x:Name="TreeExpander" Width="24" Height="30" Focusable="False"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="Transparent">
                          <Path x:Name="TreeChevron" Data="M 3 1 L 8 6 L 3 11" Width="12" Height="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stroke="{StaticResource SecondaryVividBrush}"
                                StrokeThickness="1.6"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TreeChevron" Property="Data" Value="M 1 3 L 6 8 L 11 3" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                  <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ItemsPresenter x:Name="TreeChildren" Margin="24,0,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="TreeChildren" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="TreeExpander" Property="Visibility" Value="Hidden" />
              </Trigger>
              <Trigger SourceName="TreeHeader" Property="IsMouseOver" Value="True">
                <Setter TargetName="TreeHeader" Property="Background" Value="{StaticResource PanelBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TreeHeader" Property="Background" Value="{StaticResource PanelRaisedBrush}" />
                <Setter TargetName="TreeHeader" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <HierarchicalDataTemplate DataType="{x:Type viewModels:VisualPageTreeNodeViewModel}"
                              ItemsSource="{Binding Children}"
                              ItemContainerStyle="{StaticResource StudioTreeItemStyle}">
      <StackPanel Margin="2,4">
        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                   Foreground="{StaticResource ForegroundBrush}" />
        <TextBlock Text="{Binding DescriptorId}" Style="{StaticResource StudioCodeTextStyle}" FontSize="11"
                   Margin="0,2,0,0" />
      </StackPanel>
    </HierarchicalDataTemplate>
    <Style x:Key="StudioProjectTreeItemStyle"
           TargetType="{x:Type TreeViewItem}"
           BasedOn="{StaticResource StudioTreeItemStyle}">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    </Style>
    <HierarchicalDataTemplate DataType="{x:Type viewModels:HyperpageProjectTreeNodeViewModel}"
                              ItemsSource="{Binding Children}"
                              ItemContainerStyle="{StaticResource StudioProjectTreeItemStyle}">
      <Grid Margin="2,3" ToolTip="{Binding ToolTip}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Glyph}"
                   FontFamily="Segoe Fluent Icons"
                   FontSize="13"
                   Foreground="{StaticResource SecondaryVividBrush}"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding Name}"
                   Margin="5,0,8,0"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource ForegroundBrush}"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   Text="{Binding Badge}"
                   Style="{StaticResource StudioDescriptorBadgeStyle}"
                   VerticalAlignment="Center" />
      </Grid>
    </HierarchicalDataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition>
        <RowDefinition.Style>
          <Style TargetType="{x:Type RowDefinition}">
            <Setter Property="Height" Value="50" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasHyperlibAuthoring}" Value="True">
                <Setter Property="Height" Value="0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </RowDefinition.Style>
      </RowDefinition>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0"
            Background="{x:Null}"
            BorderThickness="0"
            Panel.ZIndex="20">
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{Binding ActualWidth, ElementName=LeftToolPanelHost}" />
          <ColumnDefinition Width="{Binding ActualWidth, ElementName=LeftToolPanelSplitter}" />
          <ColumnDefinition Width="*" MinWidth="360" />
          <ColumnDefinition Width="{Binding ActualWidth, ElementName=RightToolPanelSplitter}" />
          <ColumnDefinition Width="{Binding ActualWidth, ElementName=RightToolPanelHost}" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="AlignedToolbarHost"
              Grid.Column="2"
              Margin="8,0"
              Visibility="{Binding IsStandardStudioProject, Converter={StaticResource BooleanToVisibilityConverter}}"
              SnapsToDevicePixels="True">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Style="{StaticResource StudioDockedToolbarGroupStyle}"
                  ToolTip="Project pages">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Viewbox Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center"
                       HorizontalAlignment="Center">
                <Path Data="M 4 2 H 12 L 16 6 V 16 H 4 Z M 12 2 V 6 H 16"
                      Fill="Transparent"
                      Stroke="{StaticResource SecondaryVividBrush}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
              </Viewbox>
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding ProjectPages}"
                        SelectedItem="{Binding SelectedProjectPage, Mode=TwoWay}"
                        SelectionChanged="ProjectPageSelectionChanged"
                        Style="{StaticResource StudioToolbarComboBoxStyle}"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        AutomationProperties.Name="Current project page"
                        ToolTip="Choose page">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name, Mode=OneWay}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="2"
                      Click="NewProjectDocumentClick"
                      Style="{StaticResource StudioToolbarIconButtonStyle}"
                      Width="Auto"
                      MinWidth="0"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Create document"
                      ToolTip="New document">
                <Path Data="M 8 2 L 8 14 M 2 8 L 14 8"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
              </Button>
              <Button Grid.Column="3" Command="{Binding SaveCommand}"
                      Style="{StaticResource StudioToolbarIconButtonStyle}"
                      Width="Auto"
                      MinWidth="0"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Save project"
                      ToolTip="Save project">
                <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="15" />
              </Button>
              <Button Grid.Column="4" Command="{Binding BuildCommand}"
                      Style="{StaticResource StudioToolbarPrimaryIconButtonStyle}"
                      Width="Auto"
                      MinWidth="0"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Build app preview"
                      ToolTip="Build App Preview">
                <Viewbox Width="18" Height="18">
                  <Path Data="M 4 2 L 15 9 L 4 16 Z"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeLineJoin="Round" />
                </Viewbox>
              </Button>
            </Grid>
          </Border>

          <Border Grid.Column="2"
                  Style="{StaticResource StudioDockedToolbarGroupStyle}"
                  ToolTip="Responsive canvas">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Viewbox Grid.Column="0" Width="20" Height="18" Margin="4,0,3,0" VerticalAlignment="Center"
                       ToolTip="Edit breakpoint">
                <Path Data="M 2 3 H 13 V 13 H 2 Z M 5 16 H 10 M 15 7 H 19 V 15 H 15 Z"
                      Fill="Transparent"
                      Stroke="{StaticResource SecondaryVividBrush}"
                      StrokeThickness="1.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
              </Viewbox>
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding Breakpoints}"
                        SelectedItem="{Binding ActiveBreakpoint, Mode=TwoWay}"
                        Style="{StaticResource StudioToolbarComboBoxStyle}"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Editing breakpoint"
                        ToolTip="Edit breakpoint" />
              <Border Grid.Column="2" Width="1" Height="22" Background="{StaticResource BorderBrush}"
                      Margin="4,0" VerticalAlignment="Center" />
              <Viewbox Grid.Column="3" Width="19" Height="18" Margin="3,0" VerticalAlignment="Center"
                       ToolTip="Canvas width">
                <Path Data="M 2 9 H 18 M 2 9 L 5 6 M 2 9 L 5 12 M 18 9 L 15 6 M 18 9 L 15 12"
                      Fill="Transparent"
                      Stroke="{StaticResource SecondaryVividBrush}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
              </Viewbox>
              <ComboBox Grid.Column="4"
                        ItemsSource="{Binding CanvasViewportWidths}"
                        SelectedItem="{Binding CanvasViewportWidth, Mode=TwoWay}"
                        Style="{StaticResource StudioToolbarComboBoxStyle}"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Canvas viewport width"
                        ToolTip="Canvas width" />
              <Border Grid.Column="5" Width="1" Height="22" Background="{StaticResource BorderBrush}"
                      Margin="4,0" VerticalAlignment="Center" />
              <Viewbox Grid.Column="6" Width="18" Height="18" Margin="3,0" VerticalAlignment="Center"
                       ToolTip="Canvas zoom">
                <Path Data="M 8 2 A 6 6 0 1 1 7.99 14 A 6 6 0 1 1 8 2 M 12.3 12.3 L 18 18"
                      Fill="Transparent"
                      Stroke="{StaticResource SecondaryVividBrush}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
              </Viewbox>
              <ComboBox Grid.Column="7"
                        ItemsSource="{Binding CanvasZoomChoices}"
                        SelectedItem="{Binding CanvasZoomPercent, Mode=TwoWay}"
                        Style="{StaticResource StudioToolbarComboBoxStyle}"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Canvas zoom"
                        ToolTip="Canvas zoom">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat={}{0:0}%}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Border Grid.Column="8" Width="1" Height="22" Background="{StaticResource BorderBrush}"
                      Margin="4,0" VerticalAlignment="Center" />
              <Button Grid.Column="9"
                      Command="{Binding DetachCommand}"
                      Style="{StaticResource StudioToolbarIconButtonStyle}"
                      Width="Auto"
                      MinWidth="0"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Open Studio in separate window"
                      ToolTip="Separate window">
                <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="15" />
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
    <Grid x:Name="StudioPanelGrid"
          Grid.Row="0"
          Grid.RowSpan="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding LeftToolPanelWidth}" MinWidth="0" />
        <ColumnDefinition Width="{Binding LeftToolPanelSplitterWidth}" />
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="{Binding RightToolPanelSplitterWidth}" />
        <ColumnDefinition Width="{Binding RightToolPanelWidth}" MinWidth="0" />
      </Grid.ColumnDefinitions>
      <Border x:Name="LeftToolPanelHost"
              Grid.Column="0" Background="{StaticResource AppBackgroundBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,1,0">
        <Grid>
          <Grid Visibility="{Binding IsLeftToolPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="46" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="LeftToolSelector"
                        Grid.Column="0"
                        Style="{StaticResource StudioPanelHeaderSelectorStyle}"
                        ItemsSource="{Binding ElementName=LeftToolTabs, Path=Items}"
                        SelectedItem="{Binding ElementName=LeftToolTabs, Path=SelectedItem, Mode=TwoWay}"
                        DisplayMemberPath="Header"
                        Margin="4"
                        AutomationProperties.Name="Add and organize tool"
                        ToolTip="Choose tool">
                <ComboBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Float" Click="FloatToolTabClick" />
                    <MenuItem Header="Left" Click="DockToolLeftClick" />
                    <MenuItem Header="Right" Click="DockToolRightClick" />
                  </ContextMenu>
                </ComboBox.ContextMenu>
              </ComboBox>
            </Grid>
            <TabControl x:Name="LeftToolTabs" Grid.Row="1" Style="{StaticResource StudioDockedToolTabControlStyle}"
                        Background="Transparent"
                        BorderThickness="0">
              <TabItem Header="Project" Tag="project" ToolTip="Project files">
                <Grid Margin="10,10,10,8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="Files" Style="{StaticResource StudioSectionHeadingStyle}" VerticalAlignment="Center" />
                      <Button Content="?" Width="22" Height="22" MinWidth="22" MinHeight="22" Padding="0" Margin="6,0,0,0"
                              Click="SelectedProjectFileHelpClick" Style="{StaticResource StudioToolButtonStyle}"
                              AutomationProperties.Name="Explain selected project file" ToolTip="About this file" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Click="NewProjectDocumentClick"
                            Style="{StaticResource StudioToolButtonStyle}"
                            Content="&#xE710;"
                            FontFamily="Segoe Fluent Icons"
                            Width="32"
                            Padding="0"
                            AutomationProperties.Name="Create project document"
                            ToolTip="New document" />
                    <Button Grid.Column="2"
                            Click="NewProjectFolderClick"
                            Style="{StaticResource StudioToolButtonStyle}"
                            Content="&#xE8F4;"
                            FontFamily="Segoe Fluent Icons"
                            Width="32"
                            Padding="0"
                            AutomationProperties.Name="Create project folder"
                            ToolTip="New folder" />
                    <Button Grid.Column="3"
                            Click="RenameProjectNodeClick"
                            IsEnabled="{Binding CanRenameSelectedProjectNode}"
                            Style="{StaticResource StudioToolButtonStyle}"
                            Content="&#xE8AC;"
                            FontFamily="Segoe Fluent Icons"
                            Width="32"
                            Padding="0"
                            AutomationProperties.Name="Rename selected project item"
                            ToolTip="Rename" />
                    <Button Grid.Column="4"
                            Command="{Binding RefreshProjectTreeCommand}"
                            Style="{StaticResource StudioToolButtonStyle}"
                            Content="&#xE72C;"
                            FontFamily="Segoe Fluent Icons"
                            Width="32"
                            Padding="0"
                            AutomationProperties.Name="Refresh project files"
                            ToolTip="Refresh" />
                  </Grid>
                  <TreeView Grid.Row="1"
                            ItemsSource="{Binding ProjectTree}"
                            SelectedItemChanged="ProjectTreeSelectedItemChanged"
                            MouseDoubleClick="ProjectTreeMouseDoubleClick"
                            ItemContainerStyle="{StaticResource StudioProjectTreeItemStyle}"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <TreeView.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Open" Click="OpenProjectNodeClick" />
                        <MenuItem Header="About this file" Click="SelectedProjectFileHelpClick" />
                        <Separator />
                        <MenuItem Header="New document" Click="NewProjectDocumentClick" />
                        <MenuItem Header="New folder" Click="NewProjectFolderClick" />
                        <MenuItem Header="Rename" Click="RenameProjectNodeClick" />
                        <Separator />
                        <MenuItem Header="Refresh" Click="RefreshProjectTreeClick" />
                      </ContextMenu>
                    </TreeView.ContextMenu>
                  </TreeView>
                  <TextBlock Grid.Row="2"
                             Text="{Binding SelectedProjectNodeSummary}"
                             Style="{StaticResource StudioCodeTextStyle}"
                             FontSize="11"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis"
                             Margin="2,8,2,0"
                             ToolTip="{Binding SelectedProjectNodeSummary}" />
                </Grid>
              </TabItem>
              <TabItem Header="Elements" Tag="elements"
                       ToolTip="Element library">
                <Grid x:Name="CatalogElementPanel" Margin="10,10,10,8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Search" Style="{StaticResource StudioFieldLabelStyle}"
                               Margin="0,0,0,5" />
                    <TextBox Text="{Binding ElementSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search every Studio element"
                             ToolTip="Search elements" />
                    <UniformGrid Columns="2">
                      <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Library" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding ElementScopes}"
                                  SelectedItem="{Binding SelectedElementScope, Mode=TwoWay}"
                                  AutomationProperties.Name="Element library"
                                  ToolTip="Element scope" />
                      </StackPanel>
                      <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="Category" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding ElementCategories}"
                                  SelectedItem="{Binding SelectedElementCategory, Mode=TwoWay}"
                                  ToolTip="Element category" />
                      </StackPanel>
                    </UniformGrid>
                  </StackPanel>
                  <ListBox x:Name="CatalogElementList" Grid.Row="1" ItemsSource="{Binding FilteredElementDescriptors}"
                           SelectedItem="{Binding SelectedDescriptor, Mode=TwoWay}"
                           HorizontalContentAlignment="Stretch"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="5,7">
                          <TextBlock Text="{Binding MarkupName, StringFormat=&lt;{0}&gt;}"
                                     Style="{StaticResource StudioCodeTextStyle}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     Margin="0,0,8,0" />
                          <TextBlock Text="{Binding DisplayName}"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                        </DockPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                Margin="0,10,0,0">
                    <Border Style="{StaticResource StudioSectionStyle}" Margin="0" Padding="10">
                      <StackPanel>
                        <DockPanel>
                          <TextBlock Text="{Binding SelectedDescriptor.MarkupName, StringFormat=&lt;{0}&gt;}"
                                     Style="{StaticResource StudioCodeTextStyle}"
                                     FontWeight="SemiBold"
                                     Margin="0,0,8,0" />
                          <TextBlock Text="{Binding SelectedDescriptor.DisplayName}"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedDescriptorCategorySummary}"
                                   Style="{StaticResource StudioDescriptorBadgeStyle}"
                                   HorizontalAlignment="Left"
                                   Margin="0,6,0,3" />
                        <Expander Header="Info" IsExpanded="False" Margin="0,5,0,0">
                          <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="Placement" Style="{StaticResource StudioFieldLabelStyle}" />
                            <TextBlock Text="{Binding SelectedDescriptorPlacement}"
                                       Style="{StaticResource StudioHelpTextStyle}" />
                            <TextBlock Text="Children" Style="{StaticResource StudioFieldLabelStyle}" />
                            <TextBlock Text="{Binding SelectedDescriptorChildren}"
                                       Style="{StaticResource StudioHelpTextStyle}" />
                            <TextBlock Text="Canvas" Style="{StaticResource StudioFieldLabelStyle}" />
                            <TextBlock Text="{Binding SelectedDescriptorCanvas}"
                                       Style="{StaticResource StudioHelpTextStyle}" />
                            <TextBlock Text="{Binding SelectedDescriptorStarterSummary}"
                                       Style="{StaticResource StudioHelpTextStyle}"
                                       FontStyle="Italic" />
                            <TextBlock Text="Properties"
                                       Style="{StaticResource StudioFieldLabelStyle}" />
                            <ListBox ItemsSource="{Binding SelectedDescriptorAttributes, Mode=OneWay}"
                                     MaxHeight="150"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                              <ListBox.ItemTemplate>
                                <DataTemplate>
                                  <Grid Margin="5,4">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource StudioCodeTextStyle}"
                                               Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="Property" />
                                    <TextBlock Grid.Column="2"
                                               Margin="6,0,0,0">
                                      <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource StudioDescriptorBadgeStyle}">
                                          <Setter Property="Text" Value="ELEMENT" />
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGlobal}" Value="True">
                                              <Setter Property="Text" Value="GLOBAL" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </TextBlock>
                                  </Grid>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </StackPanel>
                        </Expander>
                        <Border Style="{StaticResource StudioWarningStyle}" Margin="0,8,0,0"
                                Visibility="{Binding HasSelectedDescriptorWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                          <TextBlock Text="{Binding SelectedDescriptorWarning}"
                                     Style="{StaticResource StudioHelpTextStyle}" />
                        </Border>
                      </StackPanel>
                    </Border>
                  </ScrollViewer>
                  <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <Button x:Name="CatalogElementCommitButton" Command="{Binding AddElementCommand}"
                            Style="{StaticResource StudioPrimaryButtonStyle}"
                            Content="{Binding AddElementButtonText}"
                            ContentTemplate="{StaticResource StudioActionTextTemplate}"
                            HorizontalAlignment="Stretch"
                            Margin="0,4,0,0"
                            ToolTip="Add element"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button Click="ImportMarkupClick" Style="{StaticResource StudioToolButtonStyle}"
                            Content="Import"
                            HorizontalAlignment="Stretch"
                            Margin="0,6,0,0"
                            ToolTip="Import local markup" />
                  </StackPanel>
                </Grid>
              </TabItem>
              <TabItem Header="Library" Tag="language-library"
                       ToolTip="Language library">
                <Grid Margin="10,10,10,8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                  </Grid.RowDefinitions>
                  <Border Style="{StaticResource StudioSectionStyle}"
                          Margin="0,0,0,8">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock Text="{Binding ActiveAuthoringLanguageName}"
                                   Style="{StaticResource StudioSectionHeadingStyle}" />
                        <TextBlock Text="{Binding ActiveAuthoringDocumentName}"
                                   Style="{StaticResource StudioCodeTextStyle}"
                                   HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <TextBlock Text="{Binding AuthoringRelationshipSummary}"
                                 Style="{StaticResource StudioHelpTextStyle}"
                                 TextWrapping="Wrap"
                                 Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="Search"
                               Style="{StaticResource StudioFieldLabelStyle}" />
                    <TextBox Text="{Binding AuthoringSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search language library"
                             ToolTip="Search library" />
                    <TextBlock Text="Category"
                               Style="{StaticResource StudioFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding AuthoringCategories}"
                              SelectedItem="{Binding SelectedAuthoringCategory, Mode=TwoWay}"
                              AutomationProperties.Name="Language library category" />
                    <TextBlock Text="{Binding AuthoringLibrarySummary}"
                               Style="{StaticResource StudioHelpTextStyle}"
                               FontSize="11"
                               Margin="1,5,0,0" />
                  </StackPanel>
                  <ListBox Grid.Row="2"
                           ItemsSource="{Binding FilteredAuthoringRecipes}"
                           SelectedItem="{Binding SelectedAuthoringRecipe, Mode=TwoWay}"
                           HorizontalContentAlignment="Stretch"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           VirtualizingPanel.IsVirtualizing="True"
                           VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="5,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Category}"
                                       Style="{StaticResource StudioHelpTextStyle}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0" />
                          </StackPanel>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding KindLabel}"
                                     Style="{StaticResource StudioDescriptorBadgeStyle}"
                                     Margin="8,0,0,0" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <ScrollViewer Grid.Row="3"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                Margin="0,8,0,0">
                    <Border Style="{StaticResource StudioSectionStyle}" Margin="0">
                      <StackPanel>
                        <TextBlock Text="{Binding SelectedAuthoringRecipe.Signature}"
                                   Style="{StaticResource StudioCodeTextStyle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedAuthoringRecipe.Summary}"
                                   Style="{StaticResource StudioHelpTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />
                        <TextBlock Text="Usage"
                                   Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBlock Text="{Binding SelectedAuthoringRecipe.Usage}"
                                   Style="{StaticResource StudioHelpTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Example"
                                   Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding SelectedAuthoringRecipe.Example, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="{StaticResource CodeFontFamily}"
                                 FontSize="11"
                                 MinHeight="70"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                        <TextBlock Text="{Binding SelectedAuthoringRecipe.Source}"
                                   Style="{StaticResource StudioHelpTextStyle}"
                                   FontSize="10"
                                   Margin="0,6,0,0" />
                        <TextBox Text="{Binding SelectedAuthoringRecipe.DocumentationUrl, Mode=OneWay}"
                                 IsReadOnly="True"
                                 MinHeight="0"
                                 Padding="0"
                                 Margin="0,3,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource SecondaryVividBrush}"
                                 FontSize="10"
                                 TextWrapping="Wrap"
                                 ToolTip="Reference documentation"
                                 Visibility="{Binding SelectedAuthoringRecipe.HasDocumentationUrl, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </StackPanel>
                    </Border>
                  </ScrollViewer>
                </Grid>
              </TabItem>
              <TabItem Header="Structure" Tag="page-tree"
                       ToolTip="Page structure">
                <TreeView x:Name="PageTree" ItemsSource="{Binding RootTree}"
                          ItemContainerStyle="{StaticResource StudioTreeItemStyle}"
                          SelectedItemChanged="PageTreeSelectedItemChanged"
                          Background="{StaticResource AppBackgroundBrush}"
                          Foreground="{StaticResource ForegroundBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          FontFamily="{StaticResource UiFontFamily}"
                          FontSize="13"
                          Margin="6">
                  <TreeView.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                      <MenuItem Header="Edit" Command="{Binding OpenInspectorCommand}" />
                      <Separator />
                      <MenuItem Header="Cut" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
                      <MenuItem Header="Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
                      <MenuItem Header="{Binding PasteActionText}" Command="{Binding PasteCommand}"
                                InputGestureText="Ctrl+V" />
                      <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}"
                                InputGestureText="Ctrl+D" />
                      <Separator />
                      <MenuItem Header="Wrap" Command="{Binding WrapCommand}" />
                      <MenuItem Header="Unwrap" Command="{Binding UnwrapCommand}" />
                      <MenuItem Header="Parent" Command="{Binding SelectParentCommand}"
                                InputGestureText="Esc" />
                      <MenuItem Header="Up" Command="{Binding MoveUpCommand}" InputGestureText="Alt+Up" />
                      <MenuItem Header="Down" Command="{Binding MoveDownCommand}"
                                InputGestureText="Alt+Down" />
                      <MenuItem Header="Lock" Command="{Binding ToggleLockCommand}" />
                      <MenuItem Header="Hide" Command="{Binding ToggleHiddenCommand}" />
                      <MenuItem Header="Bind" Command="{Binding QuickAddBindingCommand}"
                                Visibility="{Binding SelectedElementSupportsBindings, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <MenuItem Header="Event" Command="{Binding AddEventCommand}"
                                Visibility="{Binding SelectedElementSupportsEvents, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <MenuItem Header="Template"
                                Click="CreateTemplateFromSelectionClick" />
                      <MenuItem Header="Source" Command="{Binding OpenSourceCommand}" />
                      <Separator />
                      <MenuItem Header="Delete" Command="{Binding DeleteCommand}" InputGestureText="Delete" />
                    </ContextMenu>
                  </TreeView.ContextMenu>
                </TreeView>
              </TabItem>
              <TabItem Header="Templates" Tag="templates"
                       ToolTip="Template library">
                <Grid Margin="10,8,10,10">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Margin="0,0,0,8">
                    <UniformGrid Columns="2">
                      <StackPanel Margin="0,0,3,0">
                        <TextBlock Text="Type" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding TemplateScopeFilters}"
                                  SelectedItem="{Binding SelectedTemplateScopeFilter, Mode=TwoWay}" />
                      </StackPanel>
                      <StackPanel Margin="3,0,0,0">
                        <TextBlock Text="Library" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding TemplateLibraryFilters}"
                                  SelectedItem="{Binding SelectedTemplateLibraryFilter, Mode=TwoWay}" />
                      </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="Category" Style="{StaticResource StudioFieldLabelStyle}"
                               Margin="0,5,0,0" />
                    <ComboBox ItemsSource="{Binding TemplateCategoryFilters}"
                              SelectedItem="{Binding SelectedTemplateCategoryFilter, Mode=TwoWay}" />
                  </StackPanel>
                  <ListBox Grid.Row="1" ItemsSource="{Binding FilteredTemplates}"
                           SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                           HorizontalContentAlignment="Stretch"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="7,9">
                          <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Library}"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       FontSize="11"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                Margin="0,10,0,0">
                    <Border Style="{StaticResource StudioSectionStyle}" Margin="0" Padding="10">
                      <StackPanel>
                        <TextBlock Text="{Binding SelectedTemplate.Name}"
                                   Style="{StaticResource StudioSectionHeadingStyle}" />
                        <TextBlock Text="{Binding SelectedTemplateProperties, Mode=OneWay}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />

                        <Expander Header="Elements" IsExpanded="False" Margin="0,8,0,0">
                          <TextBox Text="{Binding SelectedTemplateElementsText, Mode=OneWay}"
                                   IsReadOnly="True"
                                   AcceptsReturn="True"
                                   TextWrapping="NoWrap"
                                   FontFamily="{StaticResource CodeFontFamily}"
                                   FontSize="11"
                                   MinHeight="72"
                                   MaxHeight="160"
                                   Margin="0,5,0,0"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Auto" />
                        </Expander>

                        <Expander Header="Structure" Margin="0,8,0,0">
                          <TextBox Text="{Binding SelectedTemplateStructure, Mode=OneWay}"
                                   IsReadOnly="True"
                                   AcceptsReturn="True"
                                   TextWrapping="NoWrap"
                                   FontFamily="{StaticResource CodeFontFamily}"
                                   FontSize="11"
                                   MinHeight="72"
                                   Margin="0,5,0,0"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Auto" />
                        </Expander>

                        <Expander Header="Page" Margin="0,8,0,0"
                                  Visibility="{Binding IsSelectedTemplatePage, Converter={StaticResource BooleanToVisibilityConverter}}">
                          <StackPanel>
                            <TextBlock Text="Name" Style="{StaticResource StudioFieldLabelStyle}" />
                            <TextBox Text="{Binding TemplatePageName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Route" Style="{StaticResource StudioFieldLabelStyle}"
                                       Margin="0,5,0,0" />
                            <TextBox Text="{Binding TemplatePageRoute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Page route" />
                          </StackPanel>
                        </Expander>
                      </StackPanel>
                    </Border>
                  </ScrollViewer>
                  <UniformGrid Grid.Row="3" Columns="2" Margin="0,9,0,0">
                    <Button Command="{Binding InsertTemplateCommand}"
                            Style="{StaticResource StudioPrimaryButtonStyle}"
                            Content="Insert"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,4,0"
                            ToolTip="Insert template" />
                    <Button Click="CreateTemplateClick"
                            Style="{StaticResource StudioToolButtonStyle}"
                            Content="Create"
                            HorizontalAlignment="Stretch"
                            Margin="4,0,0,0"
                            ToolTip="Create template" />
                  </UniformGrid>
                </Grid>
              </TabItem>
              <TabItem Header="Assets" Tag="assets" ToolTip="Project assets">
                <Grid Margin="10,12,10,10">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="100" />
                  </Grid.RowDefinitions>
                  <StackPanel>
                    <WrapPanel>
                      <Button Click="ImportAssetClick" Style="{StaticResource StudioPrimaryButtonStyle}"
                              Content="Import"
                              ToolTip="Import asset" />
                      <Button Command="{Binding UseAssetCommand}"
                              Style="{StaticResource StudioToolButtonStyle}"
                              Content="Use"
                              ToolTip="Use asset" />
                    </WrapPanel>
                  </StackPanel>
                  <Grid Grid.Row="1" Margin="0,10,0,12">
                    <ListBox ItemsSource="{Binding ProjectAssets}"
                             SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="5,6">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ForegroundBrush}" />
                            <TextBlock Text="{Binding RelativePath}"
                                       Style="{StaticResource StudioCodeTextStyle}" />
                            <TextBlock Text="{Binding MediaType}" Style="{StaticResource StudioHelpTextStyle}"
                                       FontSize="11"
                                       Margin="0" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No assets" Margin="18"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               IsHitTestVisible="False">
                      <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource StudioHelpTextStyle}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ProjectAssets.Count}" Value="0">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Grid>
              </TabItem>
            </TabControl>
          </Grid>
        </Grid>
      </Border>
      <GridSplitter x:Name="LeftToolPanelSplitter"
                    Grid.Column="1" Background="{StaticResource BorderBrush}" ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    HorizontalAlignment="Stretch"
                    Visibility="{Binding IsLeftToolPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <Button x:Name="StudioLeftPanelHideButton" Grid.Column="1"
              Width="30"
              Height="46"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Click="StudioLeftPanelToggleClick"
              Style="{StaticResource WorkspaceBoundaryToggleButtonStyle}"
              Visibility="{Binding IsLeftToolPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              AutomationProperties.Name="Hide tools"
              ToolTip="Hide tools">
        <Path Data="{StaticResource StudioDoubleChevronGeometry}"
              Width="14" Height="16" Stretch="Uniform"
              Stroke="{StaticResource MutedForegroundBrush}"
              StrokeThickness="1.5"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round" />
      </Button>
      <Border x:Name="CentralWorkspaceHost"
              Grid.Column="2"
              Background="{StaticResource AppBackgroundBrush}">
        <Border.Style>
          <Style TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,50,0,0" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasHyperlibAuthoring}" Value="True">
                <Setter Property="Margin" Value="0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition x:Name="AiAssistantSplitterRow"
                           Height="{Binding AiAssistantSplitterHeight}" />
            <RowDefinition x:Name="AiAssistantPanelRow"
                           Height="{Binding AiAssistantPanelHeight}" />
          </Grid.RowDefinitions>
          <ContentControl x:Name="PaneHost" Grid.Row="1" />
          <ScrollViewer x:Name="WorkspaceLayoutToolbar"
                        Grid.Row="0"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        Visibility="{Binding IsStandardStudioProject, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Margin="0,4,4,4">
            <Border Style="{StaticResource StudioToolbarGroupStyle}"
                    ToolTip="Canvas layout">
              <StackPanel Orientation="Horizontal">
                <ToggleButton Command="{Binding CanvasOnlyCommand}"
                              IsChecked="{Binding IsCanvasOnlyWorkspace, Mode=OneWay}"
                              Style="{StaticResource StudioToolbarToggleButtonStyle}"
                              AutomationProperties.Name="Canvas only"
                              ToolTip="Canvas only">
                  <Viewbox Width="20" Height="18">
                    <Path Data="M 2 3 H 18 V 15 H 2 Z"
                          Fill="Transparent"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round" />
                  </Viewbox>
                </ToggleButton>
                <ToggleButton Command="{Binding SplitHorizontalCommand}"
                              IsChecked="{Binding IsCodeRightWorkspace, Mode=OneWay}"
                              Style="{StaticResource StudioToolbarToggleButtonStyle}"
                              AutomationProperties.Name="Code beside canvas"
                              ToolTip="Code beside">
                  <Viewbox Width="20" Height="18">
                    <Path Data="M 2 3 H 18 V 15 H 2 Z M 12 3 V 15"
                          Fill="Transparent"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round" />
                  </Viewbox>
                </ToggleButton>
                <ToggleButton Command="{Binding SplitVerticalCommand}"
                              IsChecked="{Binding IsCodeBelowWorkspace, Mode=OneWay}"
                              Style="{StaticResource StudioToolbarToggleButtonStyle}"
                              AutomationProperties.Name="Code below canvas"
                              ToolTip="Code below">
                  <Viewbox Width="20" Height="18">
                    <Path Data="M 2 3 H 18 V 15 H 2 Z M 2 10 H 18"
                          Fill="Transparent"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round" />
                  </Viewbox>
                </ToggleButton>
                <ToggleButton Command="{Binding DocumentOnlyCommand}"
                              IsChecked="{Binding IsDocumentOnlyWorkspace, Mode=OneWay}"
                              Style="{StaticResource StudioToolbarToggleButtonStyle}"
                              AutomationProperties.Name="Documents only"
                              ToolTip="Documents only">
                  <Viewbox Width="20" Height="18">
                    <Path Data="M 2 3 H 18 V 15 H 2 Z M 5 7 H 15 M 5 10 H 15 M 5 13 H 12"
                          Fill="Transparent"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round" />
                  </Viewbox>
                </ToggleButton>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource StudioToolbarGroupStyle}"
                    Margin="8,0,0,0"
                    ToolTip="Canvas display">
              <StackPanel Orientation="Horizontal">
                <ToggleButton IsChecked="{Binding ShowCanvasGrid, Mode=TwoWay}"
                              Style="{StaticResource StudioToolbarToggleButtonStyle}"
                              AutomationProperties.Name="Canvas alignment grid"
                              ToolTip="16px grid">
                  <Viewbox Width="18" Height="18">
                    <Path Data="M 2 2 H 16 V 16 H 2 Z M 6.67 2 V 16 M 11.33 2 V 16 M 2 6.67 H 16 M 2 11.33 H 16"
                          Fill="Transparent"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                          StrokeThickness="1.2"
                          StrokeLineJoin="Round" />
                  </Viewbox>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ShowCanvasOutlines, Mode=TwoWay}"
                              Style="{StaticResource StudioToolbarToggleButtonStyle}"
                              AutomationProperties.Name="Element outlines"
                              ToolTip="Element outlines">
                  <Viewbox Width="18" Height="18">
                    <Path Data="M 3 5 H 12 V 14 H 3 Z M 6 5 V 2 H 15 V 11 H 12"
                          Fill="Transparent"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                          StrokeThickness="1.4"
                          StrokeLineJoin="Round" />
                  </Viewbox>
                </ToggleButton>
              </StackPanel>
            </Border>
          </StackPanel>
          </ScrollViewer>
          <GridSplitter Grid.Row="2"
                        Background="{StaticResource BorderBrush}"
                        ResizeDirection="Rows"
                        ResizeBehavior="PreviousAndNext"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding IsAiAssistantOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <Button Grid.Row="2"
                  Width="46"
                  Height="30"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Command="{Binding ToggleAiAssistantCommand}"
                  Style="{StaticResource WorkspaceHorizontalBoundaryToggleButtonStyle}"
                  Visibility="{Binding IsAiAssistantOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                  AutomationProperties.Name="Hide assistant"
                  ToolTip="Hide assistant">
            <Path Data="{StaticResource StudioDoubleChevronGeometry}"
                  Width="14" Height="16" Stretch="Uniform"
                  Stroke="{StaticResource MutedForegroundBrush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform>
                <RotateTransform Angle="-90" />
              </Path.RenderTransform>
            </Path>
          </Button>
          <Border x:Name="AiAssistantPanelHost" Grid.Row="3"
                   Background="{StaticResource AppBackgroundBrush}"
                   BorderBrush="{StaticResource BorderBrush}"
                   BorderThickness="0,1,0,0"
                   ClipToBounds="True"
                   Visibility="{Binding IsAiAssistantOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Visibility="{Binding IsAiAssistantOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="27" Height="27" CornerRadius="6"
                        Margin="8,0,0,0"
                        Background="{StaticResource PanelRaisedBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                  <controls:AiShellGlyph Width="18" Height="18"
                            Foreground="{StaticResource MutedForegroundBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1"
                            Text="Assistant"
                           Margin="9,0,12,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ForegroundBrush}" />
                <Button x:Name="AiAssistantHideButton"
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleAiAssistantCommand}"
                        Style="{StaticResource StudioPaneCloseButtonStyle}"
                        AutomationProperties.Name="Close assistant"
                        ToolTip="Close assistant">
                  <TextBlock Text="×" FontSize="16" FontWeight="SemiBold" />
                </Button>
              </Grid>

              <Grid Grid.Row="1" Margin="12,7,12,10"
                    Visibility="{Binding IsAiAssistantOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="HyperpageAiMessagesScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              IsVisibleChanged="HyperpageAiMessagesScrollViewerIsVisibleChanged">
                    <ItemsControl ItemsSource="{Binding AiAssistant.Messages}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border x:Name="MessageSurface"
                                  Margin="2,3,8,3"
                                  Padding="8,6"
                                  Background="Transparent"
                                  CornerRadius="6">
                            <StackPanel>
                              <DockPanel Margin="0,0,0,3">
                                <TextBlock Text="{Binding TimestampText}"
                                           DockPanel.Dock="Right"
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           FontSize="9" />
                                <TextBlock Text="{Binding Author}"
                                           Foreground="{StaticResource SecondaryVividBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                              </DockPanel>
                              <TextBox Text="{Binding Text, Mode=OneWay}"
                                       IsReadOnly="True"
                                       IsReadOnlyCaretVisible="True"
                                       AcceptsReturn="True"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       Padding="0"
                                       FontFamily="{StaticResource TerminalTabChromeFontFamily}"
                                       FontSize="12"
                                       HorizontalScrollBarVisibility="Disabled"
                                       VerticalScrollBarVisibility="Disabled" />
                            </StackPanel>
                          </Border>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                              <Setter TargetName="MessageSurface"
                                      Property="Background"
                                      Value="#252C35" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                              <Setter TargetName="MessageSurface"
                                      Property="Background"
                                      Value="#2A1719" />
                              <Setter TargetName="MessageSurface"
                                      Property="BorderBrush"
                                      Value="#FFFF7B72" />
                              <Setter TargetName="MessageSurface"
                                      Property="BorderThickness"
                                      Value="1" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Margin="0,5,0,7"
                        Padding="8"
                        Background="#2B2118"
                        BorderBrush="{StaticResource SecondaryBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Visibility="{Binding AiAssistant.HasPendingReview, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding AiAssistant.PendingReview.Title}"
                                   Foreground="{StaticResource SecondaryVividBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AiAssistant.PendingReview.Summary}"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AiAssistant.PendingReview.Target, StringFormat=Target: {0}}"
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   FontFamily="{StaticResource CodeFontFamily}"
                                   FontSize="9"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal"
                                  VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="Approve"
                                Click="ApproveHyperpageAiReviewClick"
                                IsEnabled="{Binding AiAssistant.CanReview}"
                                Style="{StaticResource StudioPrimaryButtonStyle}"
                                Margin="0,0,5,0" />
                        <Button Content="Reject"
                                Click="RejectHyperpageAiReviewClick"
                                IsEnabled="{Binding AiAssistant.CanReview}"
                                Style="{StaticResource StudioToolButtonStyle}" />
                      </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2">
                    <Border Margin="0,0,0,6"
                            Padding="8,5"
                            Background="#2B2118"
                            BorderBrush="{StaticResource SecondaryBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding AiAssistant.HasComposerBlocker, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBlock Text="{Binding AiAssistant.ComposerBlockerMessage}"
                                 Foreground="{StaticResource ForegroundBrush}"
                                 FontSize="10"
                                 TextWrapping="Wrap" />
                    </Border>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                      </Grid.ColumnDefinitions>
                      <TextBox Text="{Binding AiAssistant.Prompt, UpdateSourceTrigger=PropertyChanged}"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               MinHeight="54"
                               MaxHeight="94"
                               VerticalScrollBarVisibility="Auto"
                               PreviewKeyDown="HyperpageAiPromptPreviewKeyDown"
                               ToolTip="AI prompt" />
                      <Button Grid.Column="1"
                              Command="{Binding AiAssistant.SendCommand}"
                              Margin="6,0,0,0"
                              Padding="0"
                              Background="{StaticResource AccentHoverBrush}"
                              BorderBrush="{StaticResource AccentBrush}"
                              AutomationProperties.Name="Send to the Hyperpage AI assistant"
                              ToolTip="Send">
                        <Path Data="M 2 3 L 11 10 L 2 17 M 11 10 L 0 10"
                              Stroke="{StaticResource ForegroundBrush}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                      </Button>
                      <Button Grid.Column="1"
                              Command="{Binding AiAssistant.StopWorkCycleCommand}"
                              Visibility="{Binding AiAssistant.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Margin="6,0,0,0"
                              Padding="0"
                              Background="#3A2022"
                              Foreground="#FFFF7B72"
                              BorderBrush="#FFFF7B72"
                              AutomationProperties.Name="Stop current AI work cycle"
                              ToolTip="Stop AI">
                        <TextBlock Text="■" FontSize="12" />
                      </Button>
                    </Grid>
                </StackPanel>

                <Border x:Name="HyperpageAiCompactOptions"
                        Grid.Row="3"
                        Margin="0,7,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0">
                  <WrapPanel VerticalAlignment="Center">
                    <ComboBox Width="310" Height="30"
                              Margin="0,0,8,0"
                              ItemsSource="{Binding AiAssistant.ProviderModelOptions}"
                              SelectedItem="{Binding AiAssistant.SelectedProviderModel, Mode=TwoWay}"
                              IsEnabled="{Binding AiAssistant.CanChangeProvider}"
                              MaxDropDownHeight="230"
                              AutomationProperties.Name="AI model"
                              ToolTip="AI model">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding DisplayName}"
                                     TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Width="230" Height="30"
                              ItemsSource="{Binding AiAssistant.Contexts}"
                              SelectedItem="{Binding AiAssistant.SelectedContext, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              IsEnabled="{Binding AiAssistant.CanChangeContext}"
                              MaxDropDownHeight="230"
                              AutomationProperties.Name="Context and permissions"
                              ToolTip="AI context" />
                  </WrapPanel>
                </Border>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <GridSplitter x:Name="RightToolPanelSplitter"
                    Grid.Column="3" Background="{StaticResource BorderBrush}" ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    HorizontalAlignment="Stretch"
                    Visibility="{Binding IsRightToolPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <Button x:Name="StudioRightPanelHideButton" Grid.Column="3"
              Width="30"
              Height="46"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Click="StudioRightPanelToggleClick"
              Style="{StaticResource WorkspaceBoundaryToggleButtonStyle}"
              Visibility="{Binding IsRightToolPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              AutomationProperties.Name="Hide tools"
              ToolTip="Hide tools">
        <Path Data="{StaticResource StudioDoubleChevronGeometry}"
              Width="14" Height="16" Stretch="Uniform"
              Stroke="{StaticResource MutedForegroundBrush}"
              StrokeThickness="1.5"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round"
              RenderTransformOrigin="0.5,0.5">
          <Path.RenderTransform>
            <RotateTransform Angle="180" />
          </Path.RenderTransform>
        </Path>
      </Button>
      <Border x:Name="RightToolPanelHost"
              Grid.Column="4" Background="{StaticResource AppBackgroundBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1,0,0,0">
        <Grid>
          <Grid Visibility="{Binding IsRightToolPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="46" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="AuthoringNativePanelActions" Grid.Row="0" Orientation="Horizontal"
                        HorizontalAlignment="Right" Height="44" Margin="0,0,8,0" Visibility="Collapsed">
              <Button Tag="layouts" Click="AuthoringNativeActionClick" Style="{StaticResource StudioToolbarIconButtonStyle}"
                      ToolTip="Page templates" AutomationProperties.Name="Page templates">
                <Path Data="M 1 1 H 6 V 6 H 1 Z M 10 1 H 15 V 6 H 10 Z M 1 10 H 6 V 15 H 1 Z M 10 10 H 15 V 15 H 10 Z"
                      Stroke="{StaticResource MutedForegroundBrush}" StrokeThickness="1.5" Fill="Transparent" Width="17" Height="17" Stretch="Uniform" />
              </Button>
              <Button Tag="authoring" Click="AuthoringNativeActionClick" Style="{StaticResource StudioToolbarIconButtonStyle}"
                      ToolTip="Authoring" AutomationProperties.Name="Authoring">
                <Path Data="M 2 13 L 1 17 L 5 16 L 16 5 L 12 1 Z M 10 3 L 14 7"
                      Stroke="{StaticResource MutedForegroundBrush}" StrokeThickness="1.5" Fill="Transparent" Width="17" Height="17" Stretch="Uniform" />
              </Button>
              <Button Tag="publish" Click="AuthoringNativeActionClick" Style="{StaticResource StudioToolbarIconButtonStyle}"
                      ToolTip="Publish" AutomationProperties.Name="Publish">
                <Path Data="M 2 11 V 17 H 16 V 11 M 9 12 V 1 M 4 6 L 9 1 L 14 6"
                      Stroke="{StaticResource MutedForegroundBrush}" StrokeThickness="1.5" Fill="Transparent" Width="17" Height="17" Stretch="Uniform" />
              </Button>
              <Button x:Name="AuthoringNativeSaveButton" Tag="save" Click="AuthoringNativeActionClick" Style="{StaticResource StudioToolbarIconButtonStyle}"
                      ToolTip="Save project" AutomationProperties.Name="Save project">
                <Path Data="M 1 1 H 13 L 17 5 V 17 H 1 Z M 5 1 V 7 H 12 V 1 M 5 17 V 11 H 13 V 17"
                      Stroke="{StaticResource MutedForegroundBrush}" StrokeThickness="1.5" Fill="Transparent" Width="17" Height="17" Stretch="Uniform" />
              </Button>
            </StackPanel>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="RightToolSelector"
                        Grid.Column="1"
                        Style="{StaticResource StudioPanelHeaderSelectorStyle}"
                        ItemsSource="{Binding ElementName=RightToolTabs, Path=Items}"
                        SelectedItem="{Binding ElementName=RightToolTabs, Path=SelectedItem, Mode=TwoWay}"
                        DisplayMemberPath="Header"
                        Margin="4"
                        AutomationProperties.Name="Edit and output tool"
                        ToolTip="Choose tool">
                <ComboBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Float" Click="FloatToolTabClick" />
                    <MenuItem Header="Left" Click="DockToolLeftClick" />
                    <MenuItem Header="Right" Click="DockToolRightClick" />
                  </ContextMenu>
                </ComboBox.ContextMenu>
              </ComboBox>
            </Grid>
            <TabControl x:Name="RightToolTabs" Grid.Row="2" Style="{StaticResource StudioDockedToolTabControlStyle}"
                        Background="Transparent"
                        BorderThickness="0">
              <TabItem Header="Builder" Tag="language-builder"
                       ToolTip="Statement builder">
                <Grid Margin="10,10,10,8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Border Style="{StaticResource StudioSectionStyle}"
                          Margin="0,0,0,8">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock Text="{Binding SelectedAuthoringRecipe.Name}"
                                   Style="{StaticResource StudioSectionHeadingStyle}" />
                        <TextBlock Text="{Binding SelectedAuthoringRecipe.KindLabel}"
                                   Style="{StaticResource StudioDescriptorBadgeStyle}"
                                   HorizontalAlignment="Right" />
                      </DockPanel>
                      <TextBlock Text="{Binding ActiveAuthoringDocumentName}"
                                 Style="{StaticResource StudioCodeTextStyle}"
                                 TextTrimming="CharacterEllipsis"
                                 Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                  <ScrollViewer Grid.Row="1"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                      <ItemsControl ItemsSource="{Binding AuthoringFields}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                              <TextBlock Text="{Binding DisplayName}"
                                         Style="{StaticResource StudioFieldLabelStyle}" />
                              <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       AcceptsReturn="True"
                                       TextWrapping="NoWrap"
                                       FontFamily="{StaticResource CodeFontFamily}"
                                       ToolTip="{Binding Help}">
                                <TextBox.Style>
                                  <Style TargetType="{x:Type TextBox}"
                                         BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="MinHeight" Value="32" />
                                    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                                        <Setter Property="MinHeight" Value="92" />
                                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBox.Style>
                              </TextBox>
                              <TextBlock Text="{Binding Help}"
                                         Style="{StaticResource StudioHelpTextStyle}"
                                         FontSize="10"
                                         Margin="1,3,0,0" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="Preview"
                                 Style="{StaticResource StudioFieldLabelStyle}" />
                      <TextBox Text="{Binding AuthoringPreview, Mode=OneWay}"
                               IsReadOnly="True"
                               AcceptsReturn="True"
                               TextWrapping="NoWrap"
                               FontFamily="{StaticResource CodeFontFamily}"
                               FontSize="12"
                               MinHeight="150"
                               VerticalScrollBarVisibility="Auto"
                               HorizontalScrollBarVisibility="Auto"
                               AutomationProperties.Name="Generated statement preview" />
                    </StackPanel>
                  </ScrollViewer>
                  <Button Grid.Row="2"
                          Command="{Binding InsertAuthoringSnippetCommand}"
                          Content="Insert"
                          Style="{StaticResource StudioPrimaryButtonStyle}"
                          HorizontalAlignment="Stretch"
                          Margin="0,9,0,0"
                          ToolTip="Insert at cursor"
                          ToolTipService.ShowOnDisabled="True" />
                  <Border Grid.RowSpan="3"
                          Background="{StaticResource AppBackgroundBrush}"
                          Opacity="0.96"
                          IsHitTestVisible="False">
                    <Border.Style>
                      <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasActiveAuthoringDocument}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" Margin="20">
                      <TextBlock Text="Choose code"
                                 Style="{StaticResource StudioSectionHeadingStyle}"
                                 HorizontalAlignment="Center" />
                      <TextBlock Text="Open a document."
                                 Style="{StaticResource StudioHelpTextStyle}"
                                 TextAlignment="Center"
                                 TextWrapping="Wrap"
                                 Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>
              </TabItem>
              <TabItem Header="Page" Tag="page" ToolTip="Page settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="10,12,10,4">
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Identity" Style="{StaticResource StudioSectionHeadingStyle}" />
                        <TextBlock Text="Name" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding PageNameEditor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Route" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding PageRouteEditor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource CodeFontFamily}" />
                        <TextBlock Text="Slug" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding PageSlugEditor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource CodeFontFamily}" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Sharing"
                                   Style="{StaticResource StudioSectionHeadingStyle}" />
                        <TextBlock Text="Title" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding PageTitleEditor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Description" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding PageDescriptionEditor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 MinHeight="76"
                                 TextWrapping="Wrap" />
                        <Button Content="Apply" Command="{Binding ApplyPageMetadataCommand}"
                                Style="{StaticResource StudioPrimaryButtonStyle}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Properties" Tag="inspector"
                       ToolTip="Element properties">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="10,12,10,4">
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding InspectorElementTitle}"
                                     ToolTip="Element"
                                     Style="{StaticResource StudioSectionHeadingStyle}"
                                     TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Text="{Binding InspectorElementBadge}"
                                     Style="{StaticResource StudioDescriptorBadgeStyle}"
                                     Margin="7,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding InspectorElementMarkup}"
                                   Style="{StaticResource StudioCodeTextStyle}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                        <Border Style="{StaticResource StudioWarningStyle}" Margin="0,6,0,2"
                                Visibility="{Binding HasInspectorElementWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                          <TextBlock Style="{StaticResource StudioHelpTextStyle}"
                                     Text="{Binding InspectorElementWarning}"
                                     TextWrapping="Wrap" />
                        </Border>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <StackPanel Visibility="{Binding InspectorElementSupportsText, Converter={StaticResource BooleanToVisibilityConverter}}">
                          <TextBlock Text="{Binding InspectorElementTextEditorLabel}"
                                     Style="{StaticResource StudioFieldLabelStyle}" />
                          <TextBox Text="{Binding SelectedTextEditor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   AcceptsReturn="True"
                                   MinHeight="58"
                                   TextWrapping="Wrap"
                                   ToolTip="Element text" />
                          <Button Command="{Binding ApplyTextCommand}"
                                  Style="{StaticResource StudioToolButtonStyle}"
                                  Content="Apply"
                                  HorizontalAlignment="Left" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource StudioHelpTextStyle}"
                                   Visibility="{Binding InspectorElementDoesNotSupportText, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Text="Select a child."
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Type" Style="{StaticResource StudioSectionHeadingStyle}" />
                        <ComboBox ItemsSource="{Binding AvailableAttributes}"
                                  SelectedItem="{Binding SelectedAttributeDefinition, Mode=TwoWay}"
                                  ToolTip="Property type">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           FontFamily="{StaticResource CodeFontFamily}"
                                           FontSize="12"
                                           Margin="8,0,0,0" />
                              </Grid>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Attribute" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding AttributeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Property name" />
                        <TextBlock Text="{Binding AttributeEditorKindLabel}"
                                   Style="{StaticResource StudioFieldLabelStyle}" />
                        <CheckBox IsChecked="{Binding AttributeBooleanValue, Mode=TwoWay}" Margin="0,6,0,4"
                                  Visibility="{Binding UsesBooleanAttributeEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                          <TextBlock Text="Enabled"
                                     Style="{StaticResource StudioHelpTextStyle}"
                                     Foreground="{StaticResource ForegroundBrush}"
                                     Margin="4,0,0,0" />
                        </CheckBox>
                        <ComboBox ItemsSource="{Binding AttributeValueSuggestions}"
                                  Text="{Binding AttributeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="{Binding AttributeChoiceIsEditable}"
                                  IsTextSearchEnabled="True"
                                  Visibility="{Binding UsesChoiceAttributeEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ToolTip="Property value" />
                        <ComboBox ItemsSource="{Binding AttributeValueSuggestions}"
                                  Text="{Binding AttributeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  Visibility="{Binding UsesTextAttributeEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ToolTip="Property value" />
                        <StackPanel Orientation="Horizontal">
                          <Button Command="{Binding SetAttributeCommand}"
                                  Style="{StaticResource StudioToolButtonStyle}"
                                  Content="Apply" />
                          <Button Command="{Binding RemoveAttributeCommand}"
                                  Style="{StaticResource StudioDestructiveButtonStyle}"
                                  Content="Remove" />
                        </StackPanel>
                        <TextBlock Text="Applied" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ListBox ItemsSource="{Binding SelectedElementAttributes}"
                                 SelectedItem="{Binding SelectedAttributeEntry, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource StudioPropertyEntryTemplate}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MaxHeight="160"
                                 ToolTip="Applied property" />
                      </StackPanel>
                    </Border>
                    <Expander Header="Arrange" Margin="2,0,2,12"
                              Visibility="{Binding IsPlacedElementInspector, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <WrapPanel>
                        <Button Command="{Binding QuickAddBindingCommand}"
                                Style="{StaticResource StudioToolButtonStyle}"
                                Content="Bind" />
                        <Button Command="{Binding AddEventCommand}"
                                Style="{StaticResource StudioToolButtonStyle}"
                                Content="Event" />
                        <Button Command="{Binding DuplicateCommand}"
                                Style="{StaticResource StudioToolButtonStyle}"
                                Content="Duplicate" />
                        <Button Command="{Binding WrapCommand}" Style="{StaticResource StudioToolButtonStyle}"
                                Content="Wrap" />
                        <Button Command="{Binding SelectParentCommand}"
                                Style="{StaticResource StudioToolButtonStyle}"
                                Content="Parent"
                                ToolTip="Select parent" />
                        <Button Command="{Binding MoveUpCommand}" Style="{StaticResource StudioToolButtonStyle}"
                                Content="Up"
                                ToolTip="Move up" />
                        <Button Command="{Binding MoveDownCommand}"
                                Style="{StaticResource StudioToolButtonStyle}"
                                Content="Down"
                                ToolTip="Move down" />
                        <Button Command="{Binding ToggleLockCommand}"
                                Style="{StaticResource StudioToolButtonStyle}"
                                Content="Lock" />
                        <Button Command="{Binding ToggleHiddenCommand}"
                                Style="{StaticResource StudioToolButtonStyle}"
                                Content="Hide" />
                        <Button Command="{Binding DeleteCommand}"
                                Style="{StaticResource StudioDestructiveButtonStyle}"
                                Content="Delete" />
                      </WrapPanel>
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Layout" Tag="layout"
                       ToolTip="Responsive layout">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="10,12,10,4">
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Breakpoint" Style="{StaticResource StudioSectionHeadingStyle}" />
                        <TextBlock Text="Screen" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Breakpoints}"
                                  SelectedItem="{Binding ActiveBreakpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Flow" Style="{StaticResource StudioSectionHeadingStyle}" />
                        <TextBlock Text="Mode" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding DisplayChoices}"
                                  Text="{Binding LayoutDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" />
                        <UniformGrid Columns="2">
                          <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Direction" Style="{StaticResource StudioFieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding FlexDirectionChoices}"
                                      Text="{Binding LayoutDirection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" />
                          </StackPanel>
                          <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Wrap" Style="{StaticResource StudioFieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding FlexWrapChoices}"
                                      Text="{Binding LayoutWrap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" />
                          </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Columns" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding LayoutColumns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Grid columns"
                                 FontFamily="{StaticResource CodeFontFamily}" />
                        <UniformGrid Columns="2">
                          <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Column span" Style="{StaticResource StudioFieldLabelStyle}" />
                            <TextBox Text="{Binding LayoutColumnSpan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                          <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Row span" Style="{StaticResource StudioFieldLabelStyle}" />
                            <TextBox Text="{Binding LayoutRowSpan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Basis" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding LayoutFlexBasis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Spacing" Style="{StaticResource StudioSectionHeadingStyle}" />
                        <TextBlock Text="Gap" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding LayoutGap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <UniformGrid Columns="2">
                          <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Padding" Style="{StaticResource StudioFieldLabelStyle}" />
                            <TextBox Text="{Binding LayoutPadding, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                          <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Margin" Style="{StaticResource StudioFieldLabelStyle}" />
                            <TextBox Text="{Binding LayoutMargin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                        </UniformGrid>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Alignment" Style="{StaticResource StudioSectionHeadingStyle}" />
                        <TextBlock Text="Items" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding AlignmentChoices}"
                                  Text="{Binding LayoutAlignItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" />
                        <TextBlock Text="Content" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding JustificationChoices}"
                                  Text="{Binding LayoutJustifyContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" />
                        <TextBlock Text="Self" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding AlignmentChoices}"
                                  Text="{Binding LayoutAlignSelf, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Limits" Style="{StaticResource StudioSectionHeadingStyle}" />
                        <UniformGrid Columns="2">
                          <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Min width" Style="{StaticResource StudioFieldLabelStyle}" />
                            <TextBox Text="{Binding LayoutMinWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Min height" Style="{StaticResource StudioFieldLabelStyle}" />
                            <TextBox Text="{Binding LayoutMinHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                          <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Max width" Style="{StaticResource StudioFieldLabelStyle}" />
                            <TextBox Text="{Binding LayoutMaxWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Max height" Style="{StaticResource StudioFieldLabelStyle}" />
                            <TextBox Text="{Binding LayoutMaxHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                        </UniformGrid>
                        <Button Content="Apply" Command="{Binding ApplyLayoutCommand}"
                                Style="{StaticResource StudioPrimaryButtonStyle}" />
                      </StackPanel>
                    </Border>
                    <Expander Header="Presets" Margin="2,2,2,12">
                      <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Name" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding LayoutPresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox ItemsSource="{Binding NamedLayoutPresets}"
                                  SelectedItem="{Binding SelectedLayoutPreset, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Margin="0,8,0,4" />
                        <WrapPanel>
                          <Button Content="Save" Command="{Binding SaveLayoutPresetCommand}"
                                  Style="{StaticResource StudioToolButtonStyle}" />
                          <Button Content="Apply" Command="{Binding ApplyLayoutPresetCommand}"
                                  Style="{StaticResource StudioToolButtonStyle}" />
                          <Button Content="Delete" Command="{Binding DeleteLayoutPresetCommand}"
                                  Style="{StaticResource StudioDestructiveButtonStyle}" />
                        </WrapPanel>
                        <Button Content="Default"
                                Command="{Binding SetPersonalDefaultLayoutCommand}"
                                Style="{StaticResource StudioToolButtonStyle}"
                                ToolTip="Default layout" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Appearance" Tag="styles"
                       ToolTip="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="10,12,10,4">
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="CSS" Style="{StaticResource StudioSectionHeadingStyle}" />
                        <TextBlock Text="Property" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding CssPropertySuggestions}"
                                  Text="{Binding StyleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" />
                        <TextBlock Text="Value" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding StyleValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource CodeFontFamily}" />
                        <WrapPanel>
                          <Button Content="Apply" Command="{Binding SetStyleCommand}"
                                  Style="{StaticResource StudioPrimaryButtonStyle}" />
                          <Button Content="Remove" Command="{Binding RemoveStyleCommand}"
                                  Style="{StaticResource StudioDestructiveButtonStyle}" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Applied" Style="{StaticResource StudioSectionHeadingStyle}" />
                        <ListBox ItemsSource="{Binding SelectedElementStyles}"
                                 SelectedItem="{Binding SelectedStyleEntry, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource StudioPropertyEntryTemplate}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MaxHeight="220"
                                 ToolTip="CSS declaration" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Data" Tag="state-bindings"
                       ToolTip="Data bindings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="10,12,10,4">
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Values" Style="{StaticResource StudioSectionHeadingStyle}" />
                        <TextBlock Text="Name" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding StateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource CodeFontFamily}" />
                        <TextBlock Text="Kind" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding StateKinds}"
                                  SelectedItem="{Binding StateKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Type" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding StateType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource CodeFontFamily}" />
                        <TextBlock Text="Initial" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding StateInitialValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource CodeFontFamily}" />
                        <Button Content="Add" Command="{Binding AddStateCommand}"
                                Style="{StaticResource StudioPrimaryButtonStyle}" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Binding"
                                   Style="{StaticResource StudioSectionHeadingStyle}" />
                        <TextBlock Text="{Binding SelectedElementSummary}"
                                   Style="{StaticResource StudioCodeTextStyle}" />
                        <Button Content="Bind" Command="{Binding QuickAddBindingCommand}"
                                Style="{StaticResource StudioToolButtonStyle}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Actions" Tag="events"
                       ToolTip="Event handlers">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="10,12,10,4">
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Event" Style="{StaticResource StudioSectionHeadingStyle}" />
                        <TextBlock Text="{Binding SelectedElementSummary}"
                                   Style="{StaticResource StudioCodeTextStyle}" />
                        <TextBlock Text="Trigger" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding EventKinds}"
                                  SelectedItem="{Binding EventKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Handler" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding EventHandlerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource CodeFontFamily}" />
                        <Button Content="Connect" Command="{Binding AddEventCommand}"
                                Style="{StaticResource StudioPrimaryButtonStyle}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Preview" Tag="build"
                       ToolTip="Build preview">
                <Grid Margin="10,12,10,10">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="110" />
                  </Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock Text="Build" Style="{StaticResource StudioSectionHeadingStyle}" />
                    <Button Command="{Binding BuildCommand}" Style="{StaticResource StudioPrimaryButtonStyle}"
                            Content="Build"
                            HorizontalAlignment="Left" />
                  </StackPanel>
                  <TextBlock Grid.Row="1" Text="Output" Style="{StaticResource StudioFieldLabelStyle}" />
                  <TextBox Grid.Row="2" Text="{Binding BuildOutput, Mode=OneWay}" IsReadOnly="True"
                           FontFamily="{StaticResource CodeFontFamily}"
                           FontSize="12"
                           AcceptsReturn="True"
                           TextWrapping="NoWrap"
                           VerticalScrollBarVisibility="Auto"
                           HorizontalScrollBarVisibility="Auto"
                           AutomationProperties.Name="Build output" />
                  <ListBox Grid.Row="4" ItemsSource="{Binding Diagnostics}"
                           SelectedItem="{Binding SelectedDiagnostic, Mode=TwoWay}"
                           ItemTemplate="{StaticResource StudioDiagnosticTemplate}"
                           HorizontalContentAlignment="Stretch"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ToolTip="Open diagnostic" />
                </Grid>
              </TabItem>
              <TabItem Header="Host" Tag="host"
                       ToolTip="Local host">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="10,12,10,4">
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Trust"
                                   Style="{StaticResource StudioSectionHeadingStyle}" />
                        <CheckBox IsChecked="{Binding TrustCustomCode, Mode=TwoWay}" Margin="0,8,0,8">
                          <TextBlock Text="Trust code"
                                     Style="{StaticResource StudioHelpTextStyle}"
                                     Foreground="{StaticResource ForegroundBrush}"
                                     Margin="4,0,0,0" />
                        </CheckBox>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Network" Style="{StaticResource StudioSectionHeadingStyle}" />
                        <TextBlock Text="Port"
                                   Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding HostPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource CodeFontFamily}" />
                        <CheckBox IsChecked="{Binding AllowLanHosting, Mode=TwoWay}" Margin="0,8,0,8">
                          <TextBlock Text="Allow network"
                                     Style="{StaticResource StudioHelpTextStyle}"
                                     Foreground="{StaticResource ForegroundBrush}"
                                     Margin="4,0,0,0" />
                        </CheckBox>
                        <TextBlock Text="Address"
                                   Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding AdapterAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding AllowLanHosting}"
                                 FontFamily="{StaticResource CodeFontFamily}" />
                      </StackPanel>
                    </Border>
                    <TextBlock Text="Firewall unchanged"
                               Style="{StaticResource StudioHelpTextStyle}"
                               ToolTip="Firewall unchanged" />
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Host" Style="{StaticResource StudioSectionHeadingStyle}" />
                        <WrapPanel>
                          <Button Content="Start" Command="{Binding StartHostCommand}"
                                  Style="{StaticResource StudioPrimaryButtonStyle}" />
                          <Button Content="Stop" Command="{Binding StopHostCommand}"
                                  Style="{StaticResource StudioDestructiveButtonStyle}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding RuntimePreviewUrl}"
                                   Style="{StaticResource StudioCodeTextStyle}"
                                   Margin="0,12,0,0" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Publish" Tag="publish"
                       ToolTip="Publish review">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="10,12,10,4">
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Release"
                                   Style="{StaticResource StudioSectionHeadingStyle}" />
                        <TextBlock Text="Checkout" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding AtlasCheckoutPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource CodeFontFamily}"
                                 ToolTip="Atlas checkout" />
                        <TextBlock Text="Slug" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding ArchiveSlug, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Branch"
                                   Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding PublishTargetBranch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource CodeFontFamily}"
                                 ToolTip="Source branch" />
                        <Button Content="Prepare" Command="{Binding PreparePublicationCommand}"
                                Style="{StaticResource StudioPrimaryButtonStyle}" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StudioSectionStyle}">
                      <StackPanel>
                        <TextBlock Text="Review" Style="{StaticResource StudioSectionHeadingStyle}" />
                        <CheckBox IsChecked="{Binding ApproveReviewedCode, Mode=TwoWay}" Margin="0,8,0,8"
                                  IsEnabled="{Binding RequiresReviewedCode}">
                          <TextBlock Text="Approve source"
                                     Style="{StaticResource StudioHelpTextStyle}"
                                     Foreground="{StaticResource ForegroundBrush}"
                                     Margin="4,0,0,0" />
                        </CheckBox>
                        <Button Content="Push"
                                Command="{Binding PublishExactCommitCommand}"
                                Style="{StaticResource StudioToolButtonStyle}" />
                        <TextBlock Text="{Binding PublishedCommit}" Style="{StaticResource StudioCodeTextStyle}"
                                   Margin="0,10,0,0" />
                      </StackPanel>
                    </Border>
                    <TextBlock Text="Review" Style="{StaticResource StudioFieldLabelStyle}" />
                    <TextBox Text="{Binding PublicationReview, Mode=OneWay}" IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="{StaticResource CodeFontFamily}"
                             FontSize="12"
                             MinHeight="220"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Margin="0,0,0,12" />
                    <TextBlock Text="Production unchanged"
                               Style="{StaticResource StudioHelpTextStyle}" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </Grid>
        </Grid>
      </Border>

      <Popup x:Name="StudioLeftPanelEdgeRevealHost"
             Placement="Custom"
             AllowsTransparency="True"
             PopupAnimation="Fade"
             StaysOpen="True">
        <Popup.Style>
          <Style TargetType="{x:Type Popup}">
            <Setter Property="IsOpen" Value="{Binding IsLeftToolPanelClosed, Mode=OneWay}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsHyperlibEditor}" Value="True">
                <Setter Property="IsOpen" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Popup.Style>
        <Button x:Name="StudioLeftPanelReopenButton"
                Width="30"
                Height="{Binding ActualHeight, ElementName=StudioPanelGrid}"
                Click="StudioLeftPanelToggleClick"
                Style="{StaticResource WorkspaceEdgeRevealButtonStyle}"
                AutomationProperties.Name="Show add and organize panel"
                ToolTip="Show tools">
          <Path Data="{StaticResource StudioDoubleChevronGeometry}"
                  Width="14" Height="16" Stretch="Uniform"
                  Stroke="{StaticResource MutedForegroundBrush}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform>
                <RotateTransform Angle="180" />
              </Path.RenderTransform>
          </Path>
        </Button>
      </Popup>

      <Popup x:Name="StudioRightPanelEdgeRevealHost"
             Placement="Custom"
             AllowsTransparency="True"
             PopupAnimation="Fade"
             StaysOpen="True">
        <Popup.Style>
          <Style TargetType="{x:Type Popup}">
            <Setter Property="IsOpen" Value="{Binding IsRightToolPanelClosed, Mode=OneWay}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsHyperlibEditor}" Value="True">
                <Setter Property="IsOpen" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Popup.Style>
        <Button x:Name="StudioRightPanelReopenButton"
                Width="30"
                Height="{Binding ActualHeight, ElementName=StudioPanelGrid}"
                Click="StudioRightPanelToggleClick"
                Style="{StaticResource WorkspaceEdgeRevealButtonStyle}"
                AutomationProperties.Name="Show edit and output panel"
                ToolTip="Show tools">
          <Path Data="{StaticResource StudioDoubleChevronGeometry}"
                  Width="14" Height="16" Stretch="Uniform"
                  Stroke="{StaticResource MutedForegroundBrush}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
        </Button>
      </Popup>

      <Popup x:Name="AiAssistantBottomEdgeRevealHost"
             Placement="Custom"
             AllowsTransparency="True"
             PopupAnimation="Fade"
             StaysOpen="True">
        <Popup.Style>
          <Style TargetType="{x:Type Popup}">
            <Setter Property="IsOpen" Value="{Binding IsAiAssistantClosed, Mode=OneWay}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsHyperlibEditor}" Value="True">
                <Setter Property="IsOpen" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Popup.Style>
        <Button x:Name="AiAssistantReopenButton"
                Width="{Binding ActualWidth, ElementName=StudioPanelGrid}"
                Height="30"
                Command="{Binding ToggleAiAssistantCommand}"
                Style="{StaticResource WorkspaceBottomEdgeRevealButtonStyle}"
                AutomationProperties.Name="Show AI assistant panel"
                ToolTip="Show assistant">
          <Path Data="{StaticResource StudioDoubleChevronGeometry}"
                  Width="14" Height="16" Stretch="Uniform"
                  Stroke="{StaticResource MutedForegroundBrush}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform>
                <RotateTransform Angle="90" />
              </Path.RenderTransform>
          </Path>
        </Button>
      </Popup>
    </Grid>
  </Grid>
</UserControl>
