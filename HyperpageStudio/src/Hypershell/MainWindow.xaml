<Window x:Class="Hypershell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Hypershell.Models"
        xmlns:viewModels="clr-namespace:Hypershell.ViewModels"
        xmlns:controls="clr-namespace:Hypershell.Controls"
        xmlns:studio="clr-namespace:Hypershell"
        xmlns:extensions="clr-namespace:Hypershell.Extensibility"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WorkspaceWindowTitle}"
        Icon="Assets/Brand/hypershell.ico"
        Width="1540"
        Height="960"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="13"
        FontWeight="Medium"
        Background="{StaticResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46"
                        ResizeBorderThickness="7"
                        GlassFrameThickness="0"
                        CornerRadius="10"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate x:Key="WorkspaceSideToolIconTemplate">
      <Grid Width="22" Height="22" IsHitTestVisible="False">
        <TextBlock x:Name="FontGlyph"
                   Text="{Binding Glyph}"
                   FontFamily="{Binding GlyphFontFamily}"
                   FontSize="15"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <controls:WorkspaceSideToolGlyph Kind="{Binding Kind}" />
        <controls:AiShellGlyph x:Name="AssistantGlyph" Visibility="Collapsed" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static extensions:WorkspaceSideToolKind.ProjectWorkItems}">
          <Setter TargetName="FontGlyph" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static extensions:WorkspaceSideToolKind.AtlasMyNet}">
          <Setter TargetName="FontGlyph" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static extensions:WorkspaceSideToolKind.NetworkObservatory}">
          <Setter TargetName="FontGlyph" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static extensions:WorkspaceSideToolKind.WorkspaceAi}">
          <Setter TargetName="FontGlyph" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="AssistantGlyph" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="DockedPanelResizeThumbStyle"
           TargetType="{x:Type Thumb}">
      <Setter Property="Width" Value="6" />
      <Setter Property="Cursor" Value="SizeWE" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Thumb}">
            <Grid Background="{TemplateBinding Background}">
              <Border x:Name="ResizeIndicator"
                      Width="1"
                      HorizontalAlignment="Center"
                      Background="{StaticResource BorderBrush}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ResizeIndicator"
                        Property="Width"
                        Value="3" />
                <Setter TargetName="ResizeIndicator"
                        Property="Background"
                        Value="{StaticResource SecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ResizeIndicator"
                        Property="Width"
                        Value="3" />
                <Setter TargetName="ResizeIndicator"
                        Property="Background"
                        Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AiLiveToggleStyle"
           TargetType="{x:Type ToggleButton}">
      <Setter Property="Foreground" Value="#A5B7BE" />
      <Setter Property="Background" Value="#141D24" />
      <Setter Property="BorderBrush" Value="#29373E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Grid x:Name="LiveToggleSurface">
              <Border x:Name="LiveToggleBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="7" />
              <Grid x:Name="ShellIcon"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                  <ScaleTransform x:Name="ShellScale"
                                  ScaleX="1"
                                  ScaleY="1" />
                </Grid.RenderTransform>
                <Ellipse x:Name="PulseHalo"
                         Width="27"
                         Height="27"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Stroke="{StaticResource SecondaryVividBrush}"
                         StrokeThickness="0.8"
                         Opacity="0" />
                <controls:AiShellGlyph x:Name="ShellCore"
                                       Width="24"
                                       Height="24"
                                       Foreground="{TemplateBinding Foreground}"
                                       IsHitTestVisible="False"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="LiveToggleBorder"
                        Property="BorderBrush"
                        Value="{StaticResource SecondaryBrush}" />
                <Setter TargetName="LiveToggleBorder"
                        Property="Background"
                        Value="#202D34" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ShellIcon"
                        Property="Opacity"
                        Value="0.78" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground"
                        Value="{StaticResource SecondaryVividBrush}" />
                <Setter TargetName="LiveToggleBorder"
                        Property="BorderBrush"
                        Value="{StaticResource SecondaryBrush}" />
                <Setter TargetName="LiveToggleBorder"
                        Property="Background"
                        Value="#1B302E" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="LiveToggleBorder"
                        Property="BorderBrush"
                        Value="{StaticResource SecondaryVividBrush}" />
              </Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                             Value="True" />
                  <Condition Binding="{Binding DataContext.WorkspaceAiAssistant.IsLiveRequestRunning, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard x:Name="LivePulseStoryboard">
                    <Storyboard RepeatBehavior="Forever"
                                AutoReverse="True">
                      <DoubleAnimation Storyboard.TargetName="PulseHalo"
                                       Storyboard.TargetProperty="Opacity"
                                       From="0.12"
                                       To="0.6"
                                       Duration="0:0:1" />
                      <DoubleAnimation Storyboard.TargetName="ShellScale"
                                       Storyboard.TargetProperty="ScaleX"
                                       From="1"
                                       To="1.04"
                                       Duration="0:0:1" />
                      <DoubleAnimation Storyboard.TargetName="ShellScale"
                                       Storyboard.TargetProperty="ScaleY"
                                       From="1"
                                       To="1.04"
                                       Duration="0:0:1" />
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="LivePulseStoryboard" />
                </MultiDataTrigger.ExitActions>
              </MultiDataTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="LiveToggleSurface"
                        Property="Opacity"
                        Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>
  <Border Background="{StaticResource AppBackgroundBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0"
          CornerRadius="10"
          ClipToBounds="True">
    <Grid>
    <DockPanel x:Name="WorkspaceDock"
               LastChildFill="True">
      <DockPanel.Style>
        <Style TargetType="{x:Type DockPanel}">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsProfileLoginGateVisible}"
                         Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DockPanel.Style>
      <controls:WorkspacePanelHost x:Name="FileExplorerPanelHost"
                                   DockPanel.Dock="Left">
      <Border x:Name="FileExplorerPane"
              Width="300"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
               BorderThickness="0,0,1,0"
               ClipToBounds="True">
         <Grid x:Name="FileExplorerPanelContent"
               Width="300"
               HorizontalAlignment="Right">
          <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid x:Name="FileExplorerHeaderGrid">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FileExplorerHeaderPageColumn" Width="Auto" />
                <ColumnDefinition x:Name="FileExplorerHeaderPrimaryColumn" Width="*" />
                <ColumnDefinition x:Name="FileExplorerHeaderToggleColumn" Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button x:Name="FileExplorerHeaderToggle"
                      Grid.Column="2"
                      Command="{Binding ToggleFileExplorerCommand}"
                      Style="{StaticResource WorkspaceSidebarToggleButtonStyle}"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True"
                      AutomationProperties.Name="Hide left sidebar"
                      ToolTip="Hide sidebar">
                <Path Data="{StaticResource WorkspaceDoubleChevronGeometry}"
                      Width="14" Height="16" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5">
                  <Path.RenderTransform>
                    <RotateTransform x:Name="FileExplorerToggleRotation" Angle="180" />
                  </Path.RenderTransform>
                </Path>
              </Button>
              <ItemsControl x:Name="FileExplorerPageToggles"
                            Grid.Column="0"
                            ItemsSource="{Binding FileExplorerSideTools}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton GroupName="FileExplorerSideTools"
                                 Style="{StaticResource CommandBuilderPageToggleStyle}"
                                 IsChecked="{Binding IsActive, Mode=OneWay}"
                                 Command="{Binding SelectCommand}"
                                 AutomationProperties.Name="{Binding DisplayName}" ToolTip="{Binding DisplayName}">
                      <ContentControl Content="{Binding}"
                                      ContentTemplate="{StaticResource WorkspaceSideToolIconTemplate}"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                      Focusable="False" />
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
          </Grid>

          <DockPanel Grid.Row="1"
                     Margin="10"
                     IsHitTestVisible="{Binding IsFileExplorerOpen}"
                     Visibility="{Binding IsFileExplorerToolPageActive, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="DEVICE"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource MutedForegroundBrush}"
                         Margin="1,0,0,4" />
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding FileExplorer.Devices}"
                          SelectedItem="{Binding FileExplorer.SelectedDevice, Mode=TwoWay}"
                          ToolTip="Choose device">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <Grid MinWidth="190">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StateText}"
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Margin="10,0,0,0">
                          <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLocal}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="LinkedHostDeviceButton"
                        Grid.Column="1"
                        Click="OpenLinkedHostsSettingsClick"
                        Content="+"
                        FontSize="19"
                        Margin="5,0,0,0"
                        Padding="0"
                        AutomationProperties.Name="Add an SSH device"
                        ToolTip="Manage devices" />
              </Grid>
              <TextBlock Text="PROJECT"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource MutedForegroundBrush}"
                         Margin="1,0,0,4" />
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding FileExplorer.ProjectOptions}"
                          SelectedItem="{Binding FileExplorer.SelectedProjectOption, Mode=TwoWay}"
                          ToolTip="Choose project">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1"
                        Click="CreateExplorerProjectClick"
                        Content="+"
                        FontSize="19"
                        Margin="5,0,0,0"
                        Padding="0"
                        ToolTip="Create a project" />
              </Grid>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="38" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="38" />
                  <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                      Command="{Binding FileExplorer.BackCommand}"
                      Content="←"
                      FontSize="18"
                      Padding="4,0"
                      ToolTip="Previous location" />
                <TextBox Grid.Column="1"
                         Text="{Binding FileExplorer.CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                         Margin="5,0"
                         ToolTip="Open path">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter"
                                Command="{Binding FileExplorer.GoCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="2"
                      Command="{Binding FileExplorer.RefreshCommand}"
                      Content="↻"
                      FontSize="18"
                      Padding="4,0"
                      ToolTip="Refresh folder contents" />
                <Button Grid.Column="3"
                        Click="OpenNewItemMenu"
                        Content="+"
                        FontSize="19"
                        Margin="5,0,0,0"
                        Padding="0"
                        ToolTip="New item">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="File"
                                Click="CreateExplorerFileClick" />
                      <MenuItem Header="Folder"
                                Click="CreateExplorerFolderClick" />
                      <Separator />
                      <MenuItem Header="Upload"
                                Click="UploadExplorerFileClick" />
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
              </Grid>
          </StackPanel>

          <ListBox x:Name="FileList"
                   ItemsSource="{Binding FileExplorer.Entries}"
                   SelectionMode="Extended"
                   PreviewMouseLeftButtonUp="FileListPreviewMouseLeftButtonUp"
                   PreviewMouseRightButtonDown="FileListPreviewMouseRightButtonDown"
                   ContextMenuOpening="FileListContextMenuOpening"
                   MouseDoubleClick="FileListMouseDoubleClick"
                   ToolTip="Browse files">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Edit" Click="OpenFileInEditorClick" />
                <MenuItem Header="Insert" Click="InsertFilePathClick" ToolTip="Insert path" />
                <Separator />
                <MenuItem Header="Rename…" Click="RenameExplorerEntryClick" />
                <MenuItem Header="Move…" Click="MoveExplorerEntryClick" />
                <MenuItem Header="Download…" Click="DownloadExplorerEntryClick" />
                <Separator />
                <MenuItem Header="Delete"
                          Click="DeleteExplorerEntryClick"
                          Foreground="#FFFF7B72" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type models:FileSystemEntry}">
                <Grid Margin="{Binding Depth, Converter={StaticResource DepthToIndentConverter}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                  </Grid.ColumnDefinitions>
                  <Path Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                    <Path.Style>
                      <Style TargetType="Path">
                        <Setter Property="Data" Value="M 5,1 L 16,1 L 22,7 L 22,25 L 5,25 Z M 16,1 L 16,7 L 22,7" />
                        <Setter Property="Stroke" Value="{StaticResource SecondaryBrush}" />
                        <Setter Property="StrokeThickness" Value="1.6" />
                        <Setter Property="Fill" Value="Transparent" />
                        <Setter Property="Opacity" Value="0.76" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                            <Setter Property="Data" Value="M 1,7 L 9,7 L 11,10 L 25,10 L 23,23 L 1,23 Z" />
                            <Setter Property="Stroke" Value="{StaticResource SecondaryVividBrush}" />
                            <Setter Property="Fill" Value="{StaticResource SecondaryTintBrush}" />
                            <Setter Property="StrokeThickness" Value="1.8" />
                            <Setter Property="Opacity" Value="1" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Path.Style>
                  </Path>
                  <TextBlock Grid.Column="1"
                             Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"
                             Margin="5,0,0,0" />
                  <TextBlock Grid.Column="2"
                             Text="{Binding ExpansionGlyph}"
                             FontSize="21"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </DockPanel>

          <controls:ProjectsView Grid.Row="1"
                                 IsHitTestVisible="{Binding IsFileExplorerOpen}"
                                 Visibility="{Binding IsProjectsPageActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <controls:AtlasMyNetView Grid.Row="1"
                                   DataContext="{Binding AtlasMyNet}"
                                   IsHitTestVisible="{Binding DataContext.IsFileExplorerOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                   Visibility="{Binding DataContext.IsAtlasMyNetPageActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
       </Grid>
      </Border>
      </controls:WorkspacePanelHost>

      <Thumb x:Name="FileExplorerResizeThumb"
             DockPanel.Dock="Left"
             Style="{StaticResource DockedPanelResizeThumbStyle}"
             Visibility="Collapsed"
             ToolTip="Resize tools"
             DragDelta="FileExplorerResizeDragDelta"
             DragCompleted="FileExplorerResizeDragCompleted" />

      <controls:WorkspacePanelHost x:Name="CommandBuilderPanelHost"
                                   DockPanel.Dock="Right">
      <Border x:Name="CommandBuilderPane"
              Width="418"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
               BorderThickness="1,0,0,0"
               ClipToBounds="True">
         <Grid x:Name="CommandBuilderPanelContent"
               Width="418"
               HorizontalAlignment="Left">
          <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid x:Name="CommandBuilderHeaderGrid">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CommandBuilderHeaderToggleColumn" Width="Auto" />
                <ColumnDefinition x:Name="CommandBuilderHeaderPrimaryColumn" Width="*" />
                <ColumnDefinition x:Name="CommandBuilderHeaderPageColumn" Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button x:Name="CommandBuilderHeaderToggle"
                      Grid.Column="0"
                      Command="{Binding ToggleCommandBuilderCommand}"
                      Style="{StaticResource WorkspaceSidebarToggleButtonStyle}"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True"
                      AutomationProperties.Name="Hide right sidebar"
                      ToolTip="Hide sidebar">
                <Path Data="{StaticResource WorkspaceDoubleChevronGeometry}"
                      Width="14" Height="16" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5">
                  <Path.RenderTransform>
                    <RotateTransform x:Name="CommandBuilderToggleRotation" Angle="0" />
                  </Path.RenderTransform>
                </Path>
              </Button>
              <ItemsControl x:Name="CommandBuilderPageToggles"
                            Grid.Column="2"
                            ItemsSource="{Binding CommandBuilderSideTools}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton GroupName="CommandBuilderSideTools"
                                 Style="{StaticResource CommandBuilderPageToggleStyle}"
                                 IsChecked="{Binding IsActive, Mode=OneWay}"
                                 Command="{Binding SelectCommand}"
                                 AutomationProperties.Name="{Binding DisplayName}" ToolTip="{Binding DisplayName}">
                      <ContentControl Content="{Binding}"
                                      ContentTemplate="{StaticResource WorkspaceSideToolIconTemplate}"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                      Focusable="False" />
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
          </Grid>

          <DockPanel Grid.Row="1"
                     Margin="12"
                     IsHitTestVisible="{Binding IsCommandBuilderOpen}">
            <Grid>
              <DockPanel Visibility="{Binding IsCommandBuilderToolPageActive, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid Margin="0,0,0,3">
              <TextBlock Text="Pipeline"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}"
                         FontSize="11" />
            </Grid>
            <Border MinHeight="42"
                    MaxHeight="250"
                    Background="#0D1117"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
              <Grid>
                <ListBox ItemsSource="{Binding CommandBuilder.Pipeline}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="5,3"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.Resources>
                    <Style x:Key="PipelineDocumentButtonStyle"
                           TargetType="{x:Type ToggleButton}">
                      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
                      <Setter Property="FontSize" Value="11" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                      <Setter Property="Background" Value="#161B22" />
                      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                      <Setter Property="BorderThickness" Value="1" />
                      <Setter Property="MinWidth" Value="88" />
                      <Setter Property="Height" Value="34" />
                      <Setter Property="Margin" Value="8,0,6,0" />
                      <Setter Property="Padding" Value="9,0" />
                      <Setter Property="Cursor" Value="Hand" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="PipelineDocumentButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="2">
                              <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PipelineDocumentButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                              </Trigger>
                              <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PipelineDocumentButtonBorder"
                                        Property="Background"
                                        Value="#33271C" />
                                <Setter TargetName="PipelineDocumentButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource SecondaryBrush}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource SecondaryBrush}" />
                              </Trigger>
                              <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PipelineDocumentButtonBorder"
                                        Property="Opacity"
                                        Value="0.82" />
                              </Trigger>
                              <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{StaticResource MutedForegroundBrush}" />
                                <Setter Property="Opacity" Value="0.55" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.Resources>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="VerticalContentAlignment" Value="Center" />
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="BorderThickness" Value="0" />
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                      <Setter Property="IsTabStop" Value="False" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border Background="Transparent"
                                    BorderThickness="0"
                                    SnapsToDevicePixels="True">
                              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,3">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Text}"
                                     FontFamily="{StaticResource CodeFontFamily}"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Center" />
                          <ToggleButton Grid.Column="1"
                                        IsChecked="{Binding IsSyntaxExpanded, Mode=TwoWay}"
                                        Style="{StaticResource PipelineDocumentButtonStyle}"
                                        Visibility="{Binding HasUsefulDocumentation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        VerticalAlignment="Center"
                                        ToolTip="Show details">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&lt;/&gt;"
                                         FontFamily="{StaticResource CodeFontFamily}"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center" />
                              <TextBlock Text="Syntax"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center" />
                            </StackPanel>
                          </ToggleButton>
                            <Button Grid.Column="2"
                                    Command="{Binding DataContext.CommandBuilder.RemoveStatementCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    CommandParameter="{Binding}"
                                    Width="38"
                                  Height="34"
                                  Padding="0"
                                  Foreground="{StaticResource AttentionBrush}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  VerticalAlignment="Center"
                                  ToolTip="Remove this item">
                            <TextBlock Text="×"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AttentionBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                          </Button>
                        </Grid>

                        <Border Padding="9"
                                Margin="0,6,0,0"
                                Background="{StaticResource PanelRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Visibility="{Binding IsSyntaxExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                          <StackPanel>
                            <TextBlock Text="{Binding SyntaxHeading}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SyntaxExplanation}"
                                       Foreground="{StaticResource SecondaryBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,6" />
                            <TextBox Text="{Binding Syntax, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontFamily="{StaticResource CodeFontFamily}"
                                     FontSize="13"
                                     MinHeight="42"
                                     MaxHeight="180"
                                     VerticalScrollBarVisibility="Auto" />
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding HasExamples, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <Border BorderBrush="{StaticResource BorderBrush}"
                                      BorderThickness="0,1,0,0"
                                      Margin="0,0,0,8" />
                              <TextBlock Text="EXAMPLES"
                                         Foreground="{StaticResource AccentBrush}"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Margin="0,0,0,4" />
                              <ItemsControl ItemsSource="{Binding Examples}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="{x:Type models:CommandUsageExample}">
                                    <Border Padding="7"
                                            Margin="0,3,0,5"
                                            Background="#0D1117"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                      <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{StaticResource SecondaryBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBox Text="{Binding Code, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 FontFamily="{StaticResource CodeFontFamily}"
                                                 FontSize="13"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="0"
                                                 MaxHeight="180"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding Explanation}"
                                                   Foreground="{StaticResource MutedForegroundBrush}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"
                                                   Visibility="{Binding HasExplanation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Image Source="{Binding ImagePath}"
                                               MaxHeight="190"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Left"
                                               Margin="0,7,0,0"
                                               ToolTip="{Binding ImageAltText}"
                                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding ImageAltText}"
                                                   Foreground="{StaticResource MutedForegroundBrush}"
                                                   FontSize="9"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0"
                                                   Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <TextBlock Text="Output"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="11"
                       Margin="0,9,0,0" />
            <TextBox Text="{Binding CommandBuilder.CommandText, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource CodeFontFamily}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     MinHeight="110"
                     MaxHeight="320"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Margin="0,4,0,7"
                     ToolTip="Composed source"
                     ToolTipService.InitialShowDelay="250">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter"
                            Modifiers="Control"
                            Command="{Binding CommandBuilder.PrimaryActionCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <StackPanel Visibility="{Binding CommandBuilder.HasTerminalActions, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding CommandBuilder.ClearBuilderCommand}"
                        Content="Clear"
                        Margin="0,0,3,0" />
                <Button Grid.Column="1"
                        Command="{Binding CommandBuilder.CopyComposedTextCommand}"
                        Content="Copy"
                        Margin="3,0,0,0"
                        ToolTip="Copy source" />
              </Grid>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding CommandBuilder.InsertIntoEditorCommand}"
                        Content="{Binding CommandBuilder.EditorActionLabel}"
                        Margin="0,0,3,0"
                        ToolTip="Insert source">
                  <Button.Style>
                    <Style TargetType="{x:Type Button}"
                           BasedOn="{StaticResource {x:Type Button}}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding CommandBuilder.IsEditorPrimaryAction}"
                                     Value="True">
                          <Setter Property="Background"
                                  Value="{StaticResource AccentHoverBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Grid.Column="1"
                        Command="{Binding CommandBuilder.SendToTerminalCommand}"
                        Content="{Binding CommandBuilder.TerminalActionLabel}"
                        Margin="3,0"
                        ToolTip="Stage source" />
                <Button Grid.Column="2"
                        Command="{Binding CommandBuilder.RunBuilderCommand}"
                        Content="Run"
                        Margin="3,0,0,0"
                        ToolTip="Run source">
                  <Button.Style>
                    <Style TargetType="{x:Type Button}"
                           BasedOn="{StaticResource {x:Type Button}}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding CommandBuilder.IsTerminalPrimaryAction}"
                                     Value="True">
                          <Setter Property="Background"
                                  Value="{StaticResource AccentHoverBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </Grid>
            </StackPanel>
            <Grid Visibility="{Binding CommandBuilder.HasEditorOnlyActions, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>
              <Button Command="{Binding CommandBuilder.ClearBuilderCommand}"
                      Content="Clear"
                      Margin="0,0,4,0" />
              <Button Grid.Column="1"
                      Command="{Binding CommandBuilder.CopyComposedTextCommand}"
                      Content="Copy"
                      Margin="2,0"
                      ToolTip="Copy source" />
              <Button Grid.Column="2"
                      Command="{Binding CommandBuilder.InsertIntoEditorCommand}"
                      Content="{Binding CommandBuilder.EditorActionLabel}"
                      Margin="4,0,0,0"
                      Background="{StaticResource AccentHoverBrush}"
                      ToolTip="Insert source" />
            </Grid>
            <TextBlock Text="{Binding CommandBuilder.StatusMessage}"
                       TextWrapping="Wrap"
                       Margin="1,7,1,0"
                       FontSize="11"
                       Visibility="{Binding CommandBuilder.IsStatusMessageError, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CommandBuilder.IsStatusMessageError}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource AttentionBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <Border Padding="8"
                      Margin="0,0,0,7"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      CornerRadius="8">
                <StackPanel>
                  <TextBlock Text="SYNTAX"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource SecondaryBrush}"
                             FontSize="11" />
                  <ComboBox Margin="0,4,0,0"
                            ItemsSource="{Binding CommandBuilder.InputSyntaxOptions}"
                            SelectedItem="{Binding CommandBuilder.SelectedInputSyntax, Mode=TwoWay}"
                            IsTextSearchEnabled="True"
                            ToolTip="Input syntax">
                  </ComboBox>
                </StackPanel>
              </Border>

              <Border Padding="8"
                      Margin="0,0,0,7"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      CornerRadius="8">
                <StackPanel>
                  <TextBlock Text="LIBRARY"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="11" />
                  <ComboBox Margin="0,4,0,0"
                            ItemsSource="{Binding CommandBuilder.BuilderSurfaces}"
                            SelectedItem="{Binding CommandBuilder.SelectedBuilderSurface, Mode=TwoWay}"
                            IsTextSearchEnabled="True"
                            TextSearch.TextPath="DisplayName"
                            ToolTip="Builder mode">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{StaticResource ForegroundBrush}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Border>

              <Border Padding="8"
                      Margin="0,0,0,7"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      CornerRadius="8"
                      Visibility="{Binding CommandBuilder.SupportsDotNetInvocationSyntax, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                  <TextBlock Text="INVOCATION"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource SecondaryBrush}"
                             FontSize="11" />
                  <ComboBox Margin="0,4,0,0"
                            ItemsSource="{Binding CommandBuilder.DotNetInvocationSyntaxOptions}"
                            SelectedItem="{Binding CommandBuilder.SelectedDotNetInvocationSyntax, Mode=TwoWay}"
                            TextSearch.TextPath="DisplayName"
                            ToolTip=".NET syntax">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{StaticResource ForegroundBrush}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Border>

              <Border Padding="8"
                      Margin="0,0,0,7"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      CornerRadius="8"
                      Visibility="{Binding CommandBuilder.IsCatalogCommandWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                  <TextBlock Text="SEARCH"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="11" />
                  <TextBox Text="{Binding CommandBuilder.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,4,0,0"
                           ToolTip="Search library" />
                  <ListBox ItemsSource="{Binding CommandBuilder.SearchResults}"
                           SelectedItem="{Binding CommandBuilder.SelectedSearchResult, Mode=TwoWay}"
                           MaxHeight="210"
                           Margin="0,5,0,0"
                           Background="{StaticResource PanelRaisedBrush}"
                           BorderBrush="{StaticResource BorderBrush}"
                           BorderThickness="1"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           Visibility="{Binding CommandBuilder.HasSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"
                                   Margin="2,3"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   FontFamily="{StaticResource CodeFontFamily}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>

              <StackPanel Visibility="{Binding CommandBuilder.IsHierarchySurface, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding CommandBuilder.HierarchyLevels}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="8"
                              Margin="0,0,0,7"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="0"
                              CornerRadius="8">
                        <StackPanel>
                          <TextBlock Text="{Binding Label}"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource AccentBrush}"
                                     FontSize="11" />
                          <ComboBox Margin="0,4,0,0"
                                    ItemsSource="{Binding Options}"
                                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                    IsTextSearchEnabled="True"
                                    TextSearch.TextPath="DisplayName">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           FontFamily="{StaticResource CodeFontFamily}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Padding="8"
                        Margin="0,0,0,7"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Visibility="{Binding CommandBuilder.HasCommandVariants, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <StackPanel>
                    <TextBlock Text="VARIANT"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="11" />
                    <ComboBox Margin="0,4,0,0"
                              ItemsSource="{Binding CommandBuilder.MatchingCommands}"
                              SelectedItem="{Binding CommandBuilder.SelectedCommand, Mode=TwoWay}"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="DisplayName">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:CommandDefinition}">
                          <TextBlock Text="{Binding DisplayName}"
                                     Foreground="{StaticResource ForegroundBrush}"
                                     FontFamily="{StaticResource CodeFontFamily}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Border>

              </StackPanel>

              <StackPanel Visibility="{Binding CommandBuilder.IsCSharpComposerWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Padding="8"
                        Margin="0,0,0,7"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Visibility="{Binding CommandBuilder.HasCSharpComposerFramework, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <StackPanel>
                    <TextBlock Text="ITEM"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="11" />
                    <Grid Margin="0,4,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ComboBox ItemsSource="{Binding CommandBuilder.CSharpComposerMenuItems}"
                                SelectedItem="{Binding CommandBuilder.SelectedCSharpComposerMenuItem, Mode=TwoWay}"
                                Text="{Binding CommandBuilder.CSharpComposerMenuText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsDropDownOpen="{Binding CommandBuilder.IsCSharpComposerMenuOpen, Mode=TwoWay}"
                                IsEditable="True"
                                IsTextSearchEnabled="True"
                                StaysOpenOnEdit="True"
                                TextSearch.TextPath="DisplayName"
                                HorizontalContentAlignment="Stretch"
                                MaxDropDownHeight="360">
                        <ComboBox.InputBindings>
                          <KeyBinding Key="Enter"
                                      Command="{Binding CommandBuilder.CommitCSharpComposerMenuTextCommand}" />
                        </ComboBox.InputBindings>
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="←"
                                         Foreground="{StaticResource SecondaryBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsBack, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding DisplayName}"
                                         Foreground="{StaticResource ForegroundBrush}"
                                         VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2"
                                         Text="+"
                                         FontSize="17"
                                         Foreground="{StaticResource SecondaryBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding ShowsAddGlyph, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Column="1"
                              Command="{Binding CommandBuilder.CommitCSharpComposerMenuTextCommand}"
                              Content="+"
                              Width="38"
                              Margin="6,0,0,0"
                              FontSize="18"
                              Visibility="{Binding CommandBuilder.IsCSharpComposerMenuCustomInput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Visibility="{Binding CommandBuilder.IsCommandFacetSurface, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Border Padding="8"
                      Margin="0,0,0,7"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      CornerRadius="8">
                <StackPanel>
                  <TextBlock Text="{Binding CommandBuilder.PrimaryFacetHeading}"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="11"
                             ToolTip="Choose action"
                             ToolTipService.InitialShowDelay="200" />
                  <ComboBox Margin="0,4,0,0"
                            ItemsSource="{Binding CommandBuilder.Actions}"
                            SelectedItem="{Binding CommandBuilder.SelectedAction, Mode=TwoWay}"
                            IsTextSearchEnabled="True"
                            ToolTip="Choose action">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{StaticResource ForegroundBrush}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Border>
              </StackPanel>


              <StackPanel Visibility="{Binding CommandBuilder.IsCommandFacetSurface, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Border Padding="8"
                      Margin="0,0,0,7"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      CornerRadius="8">
                <StackPanel>
                  <TextBlock Text="{Binding CommandBuilder.SecondaryFacetHeading}"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="11"
                             ToolTip="Choose object"
                             ToolTipService.InitialShowDelay="200" />
                  <ComboBox Margin="0,4,0,0"
                            ItemsSource="{Binding CommandBuilder.ObjectsView}"
                            SelectedValue="{Binding CommandBuilder.SelectedObject, Mode=TwoWay}"
                            SelectedValuePath="DisplayName"
                            IsEnabled="{Binding CommandBuilder.HasSelectedAction}"
                            IsTextSearchEnabled="True"
                            TextSearch.TextPath="DisplayName"
                            ToolTip="Choose object"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTipService.InitialShowDelay="200">
                    <ComboBox.GroupStyle>
                      <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                          <DataTemplate>
                            <Border Margin="0,4,0,1"
                                    Padding="7,4"
                                    Background="{StaticResource PanelRaisedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                              <TextBlock Text="{Binding Name}"
                                         Foreground="{StaticResource AccentBrush}"
                                         FontSize="10"
                                         FontWeight="SemiBold"
                                         TextTrimming="CharacterEllipsis" />
                            </Border>
                          </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                      </GroupStyle>
                    </ComboBox.GroupStyle>
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource ForegroundBrush}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <StackPanel Margin="0,7,0,0"
                              Visibility="{Binding CommandBuilder.HasCommandVariants, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="VARIANT"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               FontSize="10"
                               ToolTip="Choose command" />
                    <ComboBox Margin="0,4,0,0"
                              ItemsSource="{Binding CommandBuilder.MatchingCommands}"
                              SelectedItem="{Binding CommandBuilder.SelectedCommand}"
                              IsTextSearchEnabled="True"
                              ToolTip="Choose command">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:CommandDefinition}">
                          <TextBlock Text="{Binding DisplayName}"
                                     Foreground="{StaticResource ForegroundBrush}"
                                     FontFamily="{StaticResource CodeFontFamily}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </StackPanel>
              </Border>
              </StackPanel>

              <Border Padding="8"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      CornerRadius="8"
                      Visibility="{Binding CommandBuilder.HasSelectedCommand, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                  <TextBlock Text="{Binding CommandBuilder.ParameterSectionHeading}"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="11" />
                  <Grid x:Name="FlagsDropDownHost" Margin="0,4,0,0">
                    <ToggleButton x:Name="FlagsDropDownToggle"
                                  Content="Options"
                                  IsChecked="{Binding CommandBuilder.IsFlagsExpanded, Mode=TwoWay}"
                                  IsEnabled="{Binding CommandBuilder.HasSelectedCommand}"
                                  ToolTip="Choose parameter"
                                  ToolTipService.ShowOnDisabled="True"
                                  ToolTipService.InitialShowDelay="200"
                                  HorizontalContentAlignment="Stretch"
                                  Background="{StaticResource PanelRaisedBrush}"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1"
                                  Padding="6,4"
                                  Cursor="Hand">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                          <Border x:Name="FlagsToggleBorder"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  Padding="{TemplateBinding Padding}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                              </Grid.ColumnDefinitions>
                              <ContentPresenter VerticalAlignment="Center"
                                                TextElement.Foreground="{TemplateBinding Foreground}" />
                              <Path x:Name="FlagsChevron"
                                    Grid.Column="1"
                                    Data="M 0 0 L 8 0 L 4 5 Z"
                                    Fill="{StaticResource MutedForegroundBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5" />
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="FlagsToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="FlagsToggleBorder" Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                              <Setter TargetName="FlagsChevron" Property="Fill" Value="{StaticResource SecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                              <Setter TargetName="FlagsChevron" Property="Opacity" Value="0.62" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>

                    <Popup x:Name="FlagsDropDownPopup"
                           PlacementTarget="{Binding ElementName=FlagsDropDownToggle}"
                           Placement="Bottom"
                           Width="{Binding ActualWidth, ElementName=FlagsDropDownHost}"
                           IsOpen="{Binding CommandBuilder.IsFlagsExpanded, Mode=TwoWay}"
                           StaysOpen="True"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                      <Border Padding="8"
                              Background="{StaticResource PanelBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1">
                        <ScrollViewer MaxHeight="250"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                          <ItemsControl ItemsSource="{Binding CommandBuilder.ParameterEditors}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="0,2">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <CheckBox Content="{Binding Label}"
                                            IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                            IsEnabled="{Binding CanToggleInclusion}"
                                            VerticalAlignment="Center"
                                            ToolTip="Parameter" />
                                  <TextBox Grid.Column="1"
                                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                           ToolTip="Value">
                                    <TextBox.Style>
                                      <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IsSwitch}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBox.Style>
                                  </TextBox>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </Border>
                    </Popup>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Margin="0,8,0,0"
                      Padding="8"
                      Background="{StaticResource PanelRaisedBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      Visibility="{Binding CommandBuilder.HasCatalogStatementPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                  <Grid.Resources>
                    <Style x:Key="StatementGuideButtonStyle"
                           TargetType="{x:Type ToggleButton}">
                      <Setter Property="MinWidth" Value="76" />
                      <Setter Property="Height" Value="42" />
                      <Setter Property="Margin" Value="4,0,0,0" />
                      <Setter Property="Padding" Value="9,0" />
                      <Setter Property="Background" Value="#161B22" />
                      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                      <Setter Property="BorderThickness" Value="1" />
                      <Setter Property="Cursor" Value="Hand" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="GuideButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="2">
                              <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GuideButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                              </Trigger>
                              <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="GuideButtonBorder" Property="Background" Value="#33271C" />
                                <Setter TargetName="GuideButtonBorder" Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
                              </Trigger>
                              <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GuideButtonBorder" Property="Opacity" Value="0.82" />
                              </Trigger>
                              <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="GuideButtonBorder" Property="Background" Value="#161B22" />
                                <Setter TargetName="GuideButtonBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                                <Setter Property="Opacity" Value="0.55" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>

                    <Style x:Key="StatementSendButtonStyle"
                           TargetType="{x:Type Button}">
                      <Setter Property="MinWidth" Value="104" />
                      <Setter Property="Height" Value="42" />
                      <Setter Property="Margin" Value="5,0,0,0" />
                      <Setter Property="Padding" Value="9,0" />
                      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                      <Setter Property="BorderThickness" Value="1" />
                      <Setter Property="Cursor" Value="Hand" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="SendButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="2">
                              <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SendButtonBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                              </Trigger>
                              <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SendButtonBorder" Property="Opacity" Value="0.82" />
                              </Trigger>
                              <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SendButtonBorder" Property="Background" Value="#161B22" />
                                <Setter TargetName="SendButtonBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                                <Setter Property="Opacity" Value="0.55" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </Grid.Resources>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="READY"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               FontSize="9"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CommandBuilder.StagedStatementText}"
                               FontFamily="{StaticResource CodeFontFamily}"
                               TextWrapping="Wrap"
                               MaxHeight="54"
                               Margin="0,3,8,0"
                               ToolTip="Statement" />
                  </StackPanel>
                  <ToggleButton Grid.Column="1"
                                IsChecked="{Binding CommandBuilder.IsCommandGuideExpanded, Mode=TwoWay}"
                                IsEnabled="{Binding CommandBuilder.HasSelectedCommand}"
                                Visibility="{Binding CommandBuilder.HasSelectedCommand, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource StatementGuideButtonStyle}"
                                ToolTip="Toggle guide">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE721;"
                                 FontFamily="Segoe Fluent Icons"
                                 FontSize="14"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="Guide"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </ToggleButton>
                  <Button Grid.Column="2"
                          Command="{Binding CommandBuilder.AddStatementCommand}"
                          Style="{StaticResource StatementSendButtonStyle}"
                          ToolTip="Add item">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding CommandBuilder.AddStatementActionLabel}"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="→"
                                 FontSize="17"
                                 Margin="6,-1,0,0"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>

              <Border Margin="0,8,0,0"
                      Padding="8"
                      Background="{StaticResource PanelRaisedBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      Visibility="{Binding CommandBuilder.IsCommandGuideExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                  <TextBlock Text="GUIDE"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="11" />
                  <TextBlock Text="{Binding CommandBuilder.CommandGuideContextLabel}"
                             Foreground="{StaticResource SecondaryBrush}"
                             FontSize="10"
                             Margin="0,3,0,0"
                             TextWrapping="Wrap" />
                  <TextBlock Text="Loading…"
                             Foreground="{StaticResource MutedForegroundBrush}"
                             FontSize="10"
                             Margin="0,7,0,0"
                             Visibility="{Binding CommandBuilder.IsCommandGuideLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

                  <StackPanel Margin="0,5,0,0"
                              Visibility="{Binding CommandBuilder.HasSelectedCommandGuide, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Expander Header="DEFINITION"
                              IsExpanded="True">
                      <StackPanel Margin="7,3,4,4">
                        <TextBlock Text="{Binding CommandBuilder.SelectedCommand.DisplayName}"
                                   FontFamily="{StaticResource CodeFontFamily}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CommandBuilder.SelectedCommandGuide.Summary}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                        <TextBlock Text="{Binding CommandBuilder.SelectedCommandGuide.Definition}"
                                   Foreground="{StaticResource SecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"
                                   Visibility="{Binding CommandBuilder.SelectedCommandGuide.HasDistinctDefinition, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </StackPanel>
                    </Expander>

                    <Expander Header="{Binding CommandBuilder.SelectedCommandGuide.SyntaxHeading}"
                              Margin="0,3,0,0">
                      <StackPanel Margin="7,3,4,4">
                        <TextBlock Text="{Binding CommandBuilder.SelectedCommandGuide.SyntaxExplanation}"
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   FontSize="9"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding CommandBuilder.SelectedCommandGuide.Syntax, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="{StaticResource CodeFontFamily}"
                                 MinHeight="42"
                                 MaxHeight="130"
                                 VerticalScrollBarVisibility="Auto" />
                      </StackPanel>
                    </Expander>

                    <Expander Header="EXAMPLE"
                              Margin="0,3,0,0"
                              Visibility="{Binding CommandBuilder.SelectedCommandGuide.HasExamples, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <ItemsControl ItemsSource="{Binding CommandBuilder.SelectedCommandGuide.Examples}"
                                    Margin="7,3,4,4">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type models:CommandUsageExample}">
                            <Border Padding="7"
                                    Margin="0,3,0,0"
                                    Background="#0D1117"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                              <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBox Text="{Binding Code, Mode=OneWay}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         FontFamily="{StaticResource CodeFontFamily}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0"
                                         Margin="0,5,0,0" />
                                <TextBlock Text="{Binding Explanation}"
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"
                                           Visibility="{Binding HasExplanation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Image Source="{Binding ImagePath}"
                                       MaxHeight="190"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left"
                                       Margin="0,7,0,0"
                                       ToolTip="{Binding ImageAltText}"
                                       Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="{Binding ImageAltText}"
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           FontSize="9"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"
                                           Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>

                    <TextBlock Text="{Binding CommandBuilder.SelectedCommandGuide.SourceLabel, StringFormat=Source: {0}}"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               FontSize="9"
                               Margin="0,6,0,0" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
              </DockPanel>

              <Grid Visibility="{Binding IsCommandBuilderConfigurationPageActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                  <TextBlock Text="PROFILES"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="11" />
                  <TextBlock Text="Choose one language."
                             TextWrapping="Wrap"
                             Margin="0,4,0,0"
                             Foreground="{StaticResource MutedForegroundBrush}"
                             FontSize="10" />
                  <ComboBox Margin="0,8,0,0"
                            ItemsSource="{Binding CommandBuilder.Environments}"
                            SelectedItem="{Binding CommandBuilder.SelectedEnvironment}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Name}"
                                     Foreground="{StaticResource ForegroundBrush}"
                                     FontWeight="SemiBold" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding Language}"
                                     Foreground="{StaticResource SecondaryBrush}"
                                     FontSize="9"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Top"
                                     Margin="8,1,0,0" />
                        </Grid>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding CommandBuilder.ProfileCreatorToggleLabel}"
                            Command="{Binding CommandBuilder.ToggleProfileCreatorCommand}"
                            Padding="7,3"
                            Margin="0,0,3,0"
                            ToolTip="Create profile" />
                    <Button Grid.Column="1"
                            Content="Copy"
                            Command="{Binding CommandBuilder.DuplicateProfileCommand}"
                            Padding="7,3"
                            Margin="2,0"
                            ToolTip="Duplicate profile" />
                    <Button Grid.Column="2"
                            Content="Save"
                            Command="{Binding CommandBuilder.SaveProfileCommand}"
                            Padding="7,3"
                            Margin="2,0"
                            ToolTip="Save profile" />
                    <Button Grid.Column="3"
                            Content="Delete"
                            Command="{Binding CommandBuilder.DeleteProfileCommand}"
                            Padding="7,3"
                            Margin="3,0,0,0"
                            ToolTip="Delete profile" />
                  </Grid>

                  <Border Margin="0,8,0,0"
                          Padding="8"
                          Background="{StaticResource PanelRaisedBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          Visibility="{Binding CommandBuilder.IsProfileCreatorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                      <TextBlock Text="PROFILE"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource SecondaryBrush}"
                                 FontSize="10" />
                      <TextBox Text="{Binding CommandBuilder.NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                               Margin="0,5,0,5"
                               ToolTip="Profile name" />
                      <TextBlock Text="Language"
                                 Foreground="{StaticResource MutedForegroundBrush}"
                                 FontSize="9"
                                 Margin="1,0,0,2" />
                      <ComboBox ItemsSource="{Binding CommandBuilder.ProfileLanguageOptions}"
                                SelectedItem="{Binding CommandBuilder.NewProfileLanguage, Mode=TwoWay}"
                                Margin="0,0,0,6"
                                ToolTip="Profile language" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding CommandBuilder.NewProfileLanguageHint}"
                                     Foreground="{StaticResource ForegroundBrush}"
                                     FontSize="10"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding CommandBuilder.NewProfileValidationMessage}"
                                     Foreground="{StaticResource SecondaryBrush}"
                                     FontSize="9"
                                     TextWrapping="Wrap"
                                     Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding CommandBuilder.CreateProfileCommand}"
                                Content="Create"
                                Margin="8,0,0,0"
                                ToolTip="Create profile" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Margin="0,8,0,0"
                          Padding="8"
                          Background="{StaticResource PanelRaisedBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="PROFILE DETAILS"
                                 Foreground="{StaticResource MutedForegroundBrush}"
                                 FontSize="9"
                                 FontWeight="SemiBold" />
                      <TextBox Grid.Row="1"
                               Text="{Binding CommandBuilder.SelectedEnvironmentName, UpdateSourceTrigger=PropertyChanged}"
                               Margin="0,5,0,0"
                               ToolTip="Profile name" />
                      <TextBlock Grid.Row="2"
                                 Text="Description"
                                 Foreground="{StaticResource MutedForegroundBrush}"
                                 FontSize="9"
                                 Margin="1,5,0,2" />
                      <StackPanel Grid.Row="3">
                        <TextBox Text="{Binding CommandBuilder.SelectedEnvironmentDescription, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Profile description" />
                        <TextBlock Text="{Binding CommandBuilder.ProfileSaveHint}"
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   FontSize="9"
                                   TextWrapping="Wrap"
                                   Margin="1,4,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Row="4"
                                 Text="Language boundary"
                                 Foreground="{StaticResource MutedForegroundBrush}"
                                 FontSize="9"
                                 Margin="1,6,0,2" />
                      <Border Grid.Row="5"
                              Padding="7,5"
                              Background="#0D1117"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1">
                        <StackPanel>
                          <TextBlock Text="{Binding CommandBuilder.SelectedEnvironmentLanguage}"
                                     Foreground="{StaticResource SecondaryBrush}"
                                     FontWeight="SemiBold" />
                          <TextBlock Text="{Binding CommandBuilder.ProfileLanguageRule}"
                                     Foreground="{StaticResource MutedForegroundBrush}"
                                     FontSize="9"
                                     TextWrapping="Wrap"
                                     Margin="0,2,0,0" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Margin="0,0,0,5"
                         ToolTip="Libraries">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="COMMAND LEXICON"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="11" />
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Margin="7,0,0,0">
                       <Button Content="ALL"
                               Command="{Binding CommandBuilder.SelectAllLibrariesCommand}"
                               Padding="6,2"
                               FontSize="9"
                               ToolTip="Select all" />
                       <Button Content="NONE"
                               Command="{Binding CommandBuilder.ClearLibrarySelectionCommand}"
                               Padding="6,2"
                               FontSize="9"
                               Margin="4,0,0,0"
                               ToolTip="Clear all" />
                    </StackPanel>
                  </Grid>
                  <Border Grid.Row="1"
                           Padding="7"
                           Background="#0D1117"
                           BorderBrush="{StaticResource BorderBrush}"
                           BorderThickness="1">
                    <TabControl ItemsSource="{Binding CommandBuilder.LibraryLanguageTabs}"
                                SelectedItem="{Binding CommandBuilder.SelectedLibraryLanguageTab, Mode=TwoWay}"
                                Background="#0D1117"
                                BorderThickness="0">
                      <TabControl.Template>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                          <Grid KeyboardNavigation.TabNavigation="Local"
                                SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Background="{StaticResource PanelRaisedBrush}">
                              <TabPanel x:Name="HeaderPanel"
                                        IsItemsHost="True"
                                        Margin="0,3,0,0" />
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}">
                              <ContentPresenter x:Name="PART_SelectedContentHost"
                                                Content="{TemplateBinding SelectedContent}"
                                                ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                                ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                                ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                          </Grid>
                        </ControlTemplate>
                      </TabControl.Template>
                      <TabControl.ItemContainerStyle>
                        <Style TargetType="{x:Type TabItem}"
                               BasedOn="{StaticResource {x:Type TabItem}}">
                          <Setter Property="MinHeight" Value="28" />
                          <Setter Property="Margin" Value="0,0,4,0" />
                          <Setter Property="Padding" Value="8,4" />
                        </Style>
                      </TabControl.ItemContainerStyle>
                      <TabControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding DisplayName}"
                                     FontWeight="SemiBold" />
                        </DataTemplate>
                      </TabControl.ItemTemplate>
                      <TabControl.ContentTemplate>
                        <DataTemplate>
                          <Grid Margin="0,7,0,0">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                              <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <StackPanel Margin="0,2,0,7">
                                      <Border Padding="6,4"
                                              Background="{StaticResource PanelRaisedBrush}"
                                              BorderBrush="{StaticResource BorderBrush}"
                                              BorderThickness="0,0,0,1">
                                        <Grid>
                                          <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                          </Grid.ColumnDefinitions>
                                          <TextBlock Text="{Binding DisplayName}"
                                                     Foreground="{StaticResource AccentBrush}"
                                                     FontSize="10"
                                                     FontWeight="SemiBold" />
                                        </Grid>
                                      </Border>
                                      <ItemsControl ItemsSource="{Binding Libraries}">
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate>
                                            <Border Padding="7,5"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                     ToolTip="Select library">
                                              <Grid>
                                                <Grid.ColumnDefinitions>
                                                  <ColumnDefinition Width="Auto" />
                                                  <ColumnDefinition Width="*" />
                                                  <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding IsCompatibleWithProfile}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,7,0"
                                                          ToolTip="Select library" />
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                  <TextBlock Text="{Binding DisplayName}"
                                                             Foreground="{StaticResource ForegroundBrush}"
                                                             TextTrimming="CharacterEllipsis" />
                                                  <TextBlock Text="{Binding SourceLabel}"
                                                             Foreground="{StaticResource MutedForegroundBrush}"
                                                             FontSize="9"
                                                             TextTrimming="CharacterEllipsis" />
                                                  <TextBlock Text="{Binding ExecutionSupportMessage}"
                                                             Foreground="{StaticResource SecondaryBrush}"
                                                             FontSize="9"
                                                             TextWrapping="Wrap"
                                                             Margin="0,2,0,0"
                                                             Visibility="{Binding HasExecutionSupportNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                              </Grid>
                                            </Border>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </ScrollViewer>
                          </Grid>
                        </DataTemplate>
                      </TabControl.ContentTemplate>
                    </TabControl>
                  </Border>

                </Grid>
              </Grid>

              <Grid Visibility="{Binding IsWorkspaceAiPageActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0"
                            ItemsSource="{Binding WorkspaceAiConversations}"
                            SelectedItem="{Binding SelectedWorkspaceAiConversation, Mode=TwoWay}"
                            SelectionChanged="WorkspaceTabsSelectionChanged"
                            Background="{StaticResource PanelBrush}"
                            BorderThickness="0"
                            Margin="0,0,0,7">
                  <TabControl.Template>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                      <Border Background="{StaticResource PanelBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="0,0,0,1">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      PanningMode="HorizontalOnly"
                                      Focusable="False">
                          <StackPanel Orientation="Horizontal"
                                      Margin="0,0,0,0">
                            <TabPanel x:Name="HeaderPanel"
                                      IsItemsHost="True" />
                            <Button Style="{StaticResource TerminalTabAddButtonStyle}"
                                    Click="CreateWorkspaceAiConversationClick"
                                    ToolTip="New AI conversation">
                              <Path Data="M 7 0 L 7 14 M 0 7 L 14 7"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                    StrokeThickness="1.7"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round" />
                            </Button>
                          </StackPanel>
                        </ScrollViewer>
                      </Border>
                    </ControlTemplate>
                  </TabControl.Template>
                  <TabControl.ItemContainerStyle>
                    <Style TargetType="{x:Type TabItem}"
                           BasedOn="{StaticResource {x:Type TabItem}}">
                      <Setter Property="MinHeight" Value="36" />
                      <Setter Property="MaxWidth" Value="142" />
                    </Style>
                  </TabControl.ItemContainerStyle>
                  <TabControl.ItemTemplate>
                    <DataTemplate>
                      <Grid MinHeight="36"
                            Background="Transparent">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayTitle}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                                   FontFamily="{StaticResource TerminalTabChromeFontFamily}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="11,0,5,0" />
                        <Button Grid.Column="1"
                                Style="{StaticResource TerminalTabCloseButtonStyle}"
                                Click="CloseWorkspaceAiConversationClick"
                                ToolTip="Close conversation">
                          <Path Data="M 0 0 L 8 8 M 8 0 L 0 8"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                StrokeThickness="1.5"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </TabControl.ItemTemplate>
                </TabControl>

                <Grid Grid.Row="1"
                      Margin="0,0,0,7">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="MODEL"
                             Foreground="{StaticResource MutedForegroundBrush}"
                             FontSize="8"
                             Margin="1,0,0,2" />
                  <ComboBox Grid.Row="1"
                            ItemsSource="{Binding WorkspaceAiAssistant.ProviderModelOptions}"
                            SelectedItem="{Binding WorkspaceAiAssistant.SelectedProviderModel, Mode=TwoWay}"
                            IsEnabled="{Binding WorkspaceAiAssistant.CanChangeProvider}"
                            MaxDropDownHeight="250"
                            ToolTip="Choose model">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Grid Grid.Row="2"
                        Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding WorkspaceAiAssistant.Contexts}"
                              SelectedItem="{Binding WorkspaceAiAssistant.SelectedContext, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              IsEnabled="{Binding WorkspaceAiAssistant.CanChangeContext}"
                              MaxDropDownHeight="250"
                              ToolTip="AI context" />
                    <Button Grid.Column="1"
                            Content="+"
                            Click="CreateWorkspaceAiContextClick"
                            IsEnabled="{Binding WorkspaceAiAssistant.CanChangeContext}"
                            Width="34"
                            Height="31"
                            Margin="6,0,3,0"
                            FontSize="19"
                            Padding="0"
                            ToolTip="Create context" />
                    <Button Grid.Column="2"
                            Content="⚙"
                            Click="EditWorkspaceAiContextClick"
                            IsEnabled="{Binding WorkspaceAiAssistant.CanChangeContext}"
                            Width="34"
                            Height="31"
                            Padding="0"
                            FontSize="15"
                            ToolTip="Edit selected context" />
                    <ToggleButton x:Name="DesktopLiveAssistToggle"
                                  Grid.Column="3"
                                  Command="{Binding WorkspaceAiAssistant.ToggleDesktopLiveSessionCommand}"
                                  IsChecked="{Binding WorkspaceAiAssistant.IsDesktopLiveSessionEnabled, Mode=OneWay}"
                                  Style="{StaticResource AiLiveToggleStyle}"
                                  Margin="6,0,0,0"
                                  AutomationProperties.Name="Toggle full-desktop AI live assistance"
                                  AutomationProperties.HelpText="White means off, blue means enabled, and a blue pulse means the assistant is handling live activity."
                                  ToolTip="Live assistance" />
                    <Button Grid.Column="4"
                            Content="STOP"
                            Command="{Binding WorkspaceAiAssistant.StopComputerControlCommand}"
                            Visibility="{Binding WorkspaceAiAssistant.IsComputerControlActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="6,0,0,0"
                            Padding="9,0"
                            Foreground="#FFFF7B72"
                            BorderBrush="#FFFF7B72"
                            ToolTip="Stop control" />
                  </Grid>
                  <TextBlock Grid.Row="3"
                             Text="PROJECT"
                             Foreground="{StaticResource MutedForegroundBrush}"
                             FontSize="8"
                             Margin="1,9,0,2" />
                  <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                      <TextBox Text="{Binding WorkspaceAiAssistant.WorkingDirectoryDisplay, Mode=OneWay}"
                               IsReadOnly="True"
                               FontFamily="{StaticResource CodeFontFamily}"
                               FontSize="10"
                               VerticalContentAlignment="Center"
                               ToolTip="Project path" />
                      <TextBlock Text="Choose project"
                                 Foreground="{StaticResource MutedForegroundBrush}"
                                 FontFamily="{StaticResource CodeFontFamily}"
                                 FontSize="10"
                                 Margin="8,0"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                        <TextBlock.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding WorkspaceAiAssistant.HasWorkingDirectory}"
                                           Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                    <Button Grid.Column="1"
                            Click="BrowseWorkspaceAiWorkingDirectoryClick"
                            IsEnabled="{Binding WorkspaceAiAssistant.CanChangeWorkingDirectory}"
                            Width="34"
                            Height="31"
                            Margin="6,0,3,0"
                            Padding="0"
                            ToolTip="Choose project">
                      <TextBlock Text="&#xE8B7;"
                                 FontFamily="Segoe Fluent Icons"
                                 FontSize="14"
                                 Foreground="{StaticResource ForegroundBrush}" />
                    </Button>
                    <Button Grid.Column="2"
                            Content="×"
                            Click="ClearWorkspaceAiWorkingDirectoryClick"
                            IsEnabled="{Binding WorkspaceAiAssistant.CanChangeWorkingDirectory}"
                            Width="34"
                            Height="31"
                            Padding="0"
                            FontSize="16"
                            ToolTip="Clear project" />
                  </Grid>
                </Grid>

                <ScrollViewer x:Name="WorkspaceAiMessagesScrollViewer"
                              Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              IsVisibleChanged="WorkspaceAiMessagesScrollViewerIsVisibleChanged"
                              Margin="0,2,0,7">
                  <ItemsControl ItemsSource="{Binding WorkspaceAiAssistant.Messages}"
                                Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="4,5,8,5">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4*" />
                          </Grid.ColumnDefinitions>
                          <Border x:Name="MessageSurface"
                                  Grid.ColumnSpan="2"
                                  Padding="5,8"
                                  Background="Transparent"
                                  BorderBrush="Transparent"
                                  BorderThickness="0"
                                  CornerRadius="0"
                                  HorizontalAlignment="Stretch">
                            <StackPanel>
                              <Grid x:Name="MessageMetadata"
                                    Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Author}"
                                           Foreground="{StaticResource SecondaryBrush}"
                                           FontFamily="{StaticResource TerminalTabChromeFontFamily}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TimestampText}"
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           FontFamily="{StaticResource TerminalTabChromeFontFamily}"
                                           FontSize="9" />
                              </Grid>
                              <TextBox Text="{Binding Text, Mode=OneWay}"
                                       IsReadOnly="True"
                                       IsReadOnlyCaretVisible="True"
                                       AcceptsReturn="True"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       Background="Transparent"
                                       BorderBrush="Transparent"
                                       BorderThickness="0"
                                       Padding="0"
                                       FontFamily="{StaticResource TerminalTabChromeFontFamily}"
                                       FontSize="12"
                                       FontWeight="Normal"
                                       TextWrapping="Wrap"
                                       HorizontalScrollBarVisibility="Disabled"
                                       VerticalScrollBarVisibility="Disabled" />
                            </StackPanel>
                          </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsUser}" Value="True">
                            <Setter TargetName="MessageSurface"
                                    Property="Grid.Column"
                                    Value="1" />
                            <Setter TargetName="MessageSurface"
                                    Property="Grid.ColumnSpan"
                                    Value="1" />
                            <Setter TargetName="MessageSurface"
                                    Property="HorizontalAlignment"
                                    Value="Right" />
                            <Setter TargetName="MessageSurface"
                                    Property="Background"
                                    Value="#252C35" />
                            <Setter TargetName="MessageSurface"
                                    Property="CornerRadius"
                                    Value="12" />
                            <Setter TargetName="MessageSurface"
                                    Property="Padding"
                                    Value="11,8" />
                            <Setter TargetName="MessageMetadata"
                                    Property="Visibility"
                                    Value="Collapsed" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter TargetName="MessageSurface"
                                    Property="Background"
                                    Value="#2A1719" />
                            <Setter TargetName="MessageSurface"
                                    Property="BorderBrush"
                                    Value="#FFFF7B72" />
                            <Setter TargetName="MessageSurface"
                                    Property="BorderThickness"
                                    Value="1" />
                            <Setter TargetName="MessageSurface"
                                    Property="CornerRadius"
                                    Value="5" />
                            <Setter TargetName="MessageSurface"
                                    Property="Padding"
                                    Value="9" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="3"
                        Margin="0,0,0,8"
                        Padding="9"
                        Background="#2B2118"
                        BorderBrush="{StaticResource SecondaryBrush}"
                        BorderThickness="1"
                        Visibility="{Binding WorkspaceAiAssistant.HasPendingReview, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <StackPanel>
                    <TextBlock Text="{Binding WorkspaceAiAssistant.PendingReview.Title}"
                               Foreground="{StaticResource SecondaryBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding WorkspaceAiAssistant.PendingReview.Summary}"
                               Foreground="{StaticResource ForegroundBrush}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding WorkspaceAiAssistant.PendingReview.Target, StringFormat=Target: {0}}"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               FontFamily="{StaticResource CodeFontFamily}"
                               FontSize="9"
                               TextWrapping="Wrap"
                               Margin="0,5,0,3" />
                    <TextBox Text="{Binding WorkspaceAiAssistant.PendingReview.Preview, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="{StaticResource CodeFontFamily}"
                             FontSize="11"
                             MinHeight="70"
                             MaxHeight="230"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Button Content="Approve"
                              Click="ApproveWorkspaceAiReviewClick"
                              IsEnabled="{Binding WorkspaceAiAssistant.CanReview}"
                              Padding="10,6"
                              Margin="0,0,4,0"
                              Background="{StaticResource AccentHoverBrush}" />
                      <Button Grid.Column="1"
                              Content="Reject"
                              Click="RejectWorkspaceAiReviewClick"
                              IsEnabled="{Binding WorkspaceAiAssistant.CanReview}"
                              Padding="10,6"
                              Margin="4,0,0,0" />
                    </Grid>
                  </StackPanel>
                </Border>

                <StackPanel Grid.Row="4">
                  <Border Margin="0,0,0,7"
                          Padding="9,7"
                          Background="#2B2118"
                          BorderBrush="{StaticResource SecondaryBrush}"
                          BorderThickness="1"
                          CornerRadius="4"
                          Visibility="{Binding WorkspaceAiAssistant.HasComposerBlocker, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right"
                                  Orientation="Horizontal"
                                  Margin="10,0,0,0">
                        <Button Content="Enable"
                                Command="{Binding WorkspaceAiAssistant.EnableSelectedOpenAiCommand}"
                                Visibility="{Binding WorkspaceAiAssistant.CanEnableSelectedOpenAi, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Padding="9,4"
                                Margin="0,0,5,0"
                                Background="{StaticResource AccentHoverBrush}" />
                        <Button Content="Settings"
                                Click="OpenWorkspaceAiSettingsClick"
                                Padding="9,4" />
                      </StackPanel>
                      <TextBlock Text="{Binding WorkspaceAiAssistant.ComposerBlockerMessage}"
                                 Foreground="{StaticResource ForegroundBrush}"
                                 FontFamily="{StaticResource TerminalTabChromeFontFamily}"
                                 FontSize="10"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center" />
                    </DockPanel>
                  </Border>
                  <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding WorkspaceAiAssistant.Prompt, UpdateSourceTrigger=PropertyChanged}"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="64"
                           MaxHeight="130"
                           VerticalScrollBarVisibility="Auto"
                           PreviewKeyDown="WorkspaceAiPromptPreviewKeyDown" />
                  <Button Grid.Column="1"
                          Command="{Binding WorkspaceAiAssistant.SendCommand}"
                          Margin="6,0,0,0"
                          Padding="0"
                          ToolTip="Send">
                    <Button.Style>
                      <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding WorkspaceAiAssistant.IsBusy}"
                                       Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                          </Trigger>
                          <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#202A35" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="Opacity" Value="0.7" />
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <Path Data="M 2 3 L 11 10 L 2 17 M 11 10 L 0 10"
                          Stroke="{StaticResource ForegroundBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                  </Button>
                  <Button Grid.Column="1"
                          Command="{Binding WorkspaceAiAssistant.StopWorkCycleCommand}"
                          Visibility="{Binding WorkspaceAiAssistant.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Margin="6,0,0,0"
                          Padding="0"
                          Background="#3A2022"
                          Foreground="{StaticResource AttentionBrush}"
                          BorderBrush="{StaticResource AttentionBrush}"
                          BorderThickness="1"
                          AutomationProperties.Name="Stop current AI work cycle"
                          AutomationProperties.HelpText="Cancels the active model request, tool loop, and computer-control action. Completed actions are not undone."
                          ToolTip="Stop AI">
                    <Button.Template>
                      <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="StopSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                          <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StopSurface"
                                    Property="Background"
                                    Value="#593034" />
                          </Trigger>
                          <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StopSurface"
                                    Property="Background"
                                    Value="#6B3439" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                    <Rectangle Width="12"
                               Height="12"
                               RadiusX="1"
                               RadiusY="1"
                               Fill="{StaticResource AttentionBrush}" />
                  </Button>
                  </Grid>
                </StackPanel>

                <Grid Grid.Row="5" Margin="0,7,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Effort"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               FontSize="8"
                               Margin="1,0,0,2" />
                    <ComboBox ItemsSource="{Binding WorkspaceAiAssistant.ReasoningEfforts}"
                              SelectedItem="{Binding WorkspaceAiAssistant.ActiveReasoningEffort, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Verbosity"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               FontSize="8"
                               Margin="1,0,0,2" />
                    <ComboBox ItemsSource="{Binding WorkspaceAiAssistant.TextVerbosities}"
                              SelectedItem="{Binding WorkspaceAiAssistant.ActiveTextVerbosity, Mode=TwoWay}" />
                  </StackPanel>
                </Grid>
              </Grid>

              <controls:NetworkObservatoryView
                  DataContext="{Binding NetworkObservatory}"
                  Visibility="{Binding DataContext.IsNetworkObservatoryPageActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
          </DockPanel>
        </Grid>
      </Border>
      </controls:WorkspacePanelHost>

      <Thumb x:Name="CommandBuilderResizeThumb"
             DockPanel.Dock="Right"
             Style="{StaticResource DockedPanelResizeThumbStyle}"
             Visibility="Collapsed"
             ToolTip="Resize tools"
             DragDelta="CommandBuilderResizeDragDelta"
             DragCompleted="CommandBuilderResizeDragCompleted" />

      <Grid x:Name="BottomPanelContainer"
            DockPanel.Dock="Bottom"
            Height="320"
            Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="5" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Thumb Grid.Row="0"
               Height="5"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Cursor="SizeNS"
               DragDelta="BottomPanelResizeDragDelta"
               DragCompleted="BottomPanelResizeDragCompleted">
          <Thumb.Template>
            <ControlTemplate TargetType="{x:Type Thumb}">
              <Border Background="{StaticResource BorderBrush}" />
            </ControlTemplate>
          </Thumb.Template>
        </Thumb>
        <controls:WorkspacePanelHost x:Name="BottomPanelHost"
                                     Grid.Row="1"
                                     CurrentSlot="Bottom" />
      </Grid>

      <Grid x:Name="WorkspaceSurface"
            Background="{StaticResource AppBackgroundBrush}">
        <!-- Reopen controls belong to the title chrome, not separate popup windows.
             The tab header reserves their width while the document keeps its full area. -->
        <Border x:Name="FileExplorerEdgeRevealHost"
                Width="39" Height="38"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Panel.ZIndex="10" ClipToBounds="True"
                Visibility="{Binding ShouldShowFileExplorerReopenButton, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Button x:Name="FileExplorerReopenButton"
                  Margin="4,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Command="{Binding ToggleFileExplorerCommand}"
                  Style="{StaticResource WorkspaceSidebarToggleButtonStyle}"
                   AutomationProperties.Name="Show left sidebar"
                   ToolTip="Show left sidebar">
            <Path Data="{StaticResource WorkspaceDoubleChevronGeometry}"
                   Width="14"
                   Height="16"
                  Stretch="Uniform"
                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                   StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform>
                <RotateTransform Angle="180" />
              </Path.RenderTransform>
            </Path>
          </Button>
        </Border>

        <TabControl x:Name="WorkspaceTabs"
                    ItemsSource="{Binding WorkspaceTabs}"
                    SelectedItem="{Binding ActiveWorkspaceTab}"
                    SelectionChanged="WorkspaceTabsSelectionChanged"
                    Background="{StaticResource AppBackgroundBrush}"
                    BorderThickness="0">
          <TabControl.Template>
            <ControlTemplate TargetType="{x:Type TabControl}">
              <Grid KeyboardNavigation.TabNavigation="Local"
                    SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" MinHeight="46" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="#0F141A"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="0,0,0,1">
                  <Grid>
                    <Grid.Style>
                      <Style TargetType="{x:Type Grid}">
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ShouldShowFileExplorerReopenButton}" Value="True">
                            <Setter Property="Margin" Value="39,0,0,0" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ShouldShowCommandBuilderReopenButton}" Value="True">
                            <Setter Property="Margin" Value="0,0,39,0" />
                          </DataTrigger>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding ShouldShowFileExplorerReopenButton}" Value="True" />
                              <Condition Binding="{Binding ShouldShowCommandBuilderReopenButton}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Margin" Value="39,0,39,0" />
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="CoreWorkspaceHeader" Margin="8,5,4,0">
                      <Grid.Style>
                        <Style TargetType="Grid">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVisualPageStudioActive}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Grid.Style>
                      <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Disabled"
                                    PanningMode="HorizontalOnly"
                                    Focusable="False">
                        <StackPanel Orientation="Horizontal"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                          <TabPanel x:Name="HeaderPanel"
                                    IsItemsHost="True" />
                          <Button Style="{StaticResource TerminalTabAddButtonStyle}"
                                  Click="OpenNewItemMenu"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="New tab"
                                  ToolTip="New tab">
                            <Button.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Terminal"
                                          Click="OpenNewTerminalDialog" />
                                <MenuItem Header="Remote"
                                          Click="OpenNewRemoteTerminalDialog" />
                                <MenuItem Header="Browser"
                                          Click="NewBrowserClick" />
                                <Separator />
                                <MenuItem Header="Hyperpage Studio"
                                          ToolTip="Create or open a project"
                                          Click="NewStudioProjectClick" />
                                <Separator />
                                <MenuItem Header="Text"
                                          InputGestureText="Ctrl+N"
                                          Click="NewDocumentClick" />
                                <MenuItem Header="Open file"
                                          InputGestureText="Ctrl+O"
                                          Click="OpenDocumentClick" />
                              </ContextMenu>
                            </Button.ContextMenu>
                            <Path Data="M 7 0 L 7 14 M 0 7 L 14 7"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                          </Button>
                        </StackPanel>
                      </ScrollViewer>
                    </Grid>

                    <DockPanel x:Name="StudioWorkspaceHeader" Margin="8,0,4,0"
                               shell:WindowChrome.IsHitTestVisibleInChrome="True"
                               Visibility="{Binding IsVisualPageStudioActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <Button DockPanel.Dock="Left"
                              Style="{StaticResource HeaderIconButtonStyle}" Width="34" Height="36"
                              Visibility="{Binding IsHypershellWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Click="ReturnToHypershellClick" AutomationProperties.Name="Return to Hypershell"
                              ToolTip="Return to Hypershell">
                        <Path Data="M 14 6 L 2 6 M 7 1 L 2 6 L 7 11" Stroke="{StaticResource ForegroundBrush}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      </Button>
                      <ScrollViewer x:Name="StudioHeaderScrollViewer"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Disabled"
                                    PanningMode="HorizontalOnly" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                          <ListBox x:Name="StudioObjectTabs" ItemsSource="{Binding StudioWorkspaceTabs}"
                                   SelectedItem="{Binding ActiveStudioWorkspaceTab, Mode=TwoWay}" IsSynchronizedWithCurrentItem="False"
                                   Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Stretch"
                                   AutomationProperties.Name="Project tabs">
                            <ListBox.Template>
                              <ControlTemplate TargetType="{x:Type ListBox}">
                                <ItemsPresenter />
                              </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                              <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="2,3,2,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="ToolTip" Value="{Binding DisplayTitle}" />
                                <Setter Property="Template">
                                  <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                      <Border x:Name="ObjectTab" Background="{StaticResource PanelBrush}" BorderBrush="Transparent"
                                              BorderThickness="0,0,0,2" CornerRadius="6,6,0,0" Padding="12,5,6,5">
                                        <ContentPresenter />
                                      </Border>
                                      <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ObjectTab" Property="Background" Value="{StaticResource PanelRaisedBrush}" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                          <Setter TargetName="ObjectTab" Property="Background" Value="{StaticResource SecondaryTintBrush}" />
                                          <Setter TargetName="ObjectTab" Property="BorderBrush" Value="{StaticResource SecondaryVividBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ObjectTab" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                                      </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                  </Setter.Value>
                                </Setter>
                              </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding StudioDisplayTitle}" Foreground="{StaticResource ForegroundBrush}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                  <TextBlock Text=" •" Foreground="{StaticResource AttentionBrush}" Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" />
                                  <Button Content="×" Style="{StaticResource HeaderIconButtonStyle}" Width="26" Height="27" Margin="5,0,0,0"
                                          Click="CloseWorkspaceTabClick" ToolTip="Close" AutomationProperties.Name="Close Studio tab" />
                                </StackPanel>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                          <Button x:Name="NewStudioTabButton" Style="{StaticResource TerminalTabAddButtonStyle}" Focusable="True"
                                  Click="NewStudioProjectClick" VerticalAlignment="Center"
                                  AutomationProperties.Name="New project tab" ToolTip="Create or open a project">
                            <Path Data="M 7 0 L 7 14 M 0 7 L 14 7" Stroke="{StaticResource ForegroundBrush}" StrokeThickness="1.7" />
                          </Button>
                        </StackPanel>
                      </ScrollViewer>
                    </DockPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                      <TextBlock Text="{Binding AutosaveStatusText}"
                                 Width="68"
                                 Visibility="{Binding ShowSaveStatusInTitleBar, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 VerticalAlignment="Center"
                                 TextAlignment="Right"
                                 Margin="6,0,8,0"
                                 FontSize="11"
                                 FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding AutosaveStatusText}" Value="Unsaved">
                                <Setter Property="Foreground" Value="{StaticResource AttentionBrush}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding AutosaveStatusText}" Value="Saving">
                                <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding AutosaveStatusText}" Value="Saved">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <Button x:Name="ProfileAccountMenuButton"
                              Click="OpenProfileAccountMenuClick"
                              Style="{StaticResource HeaderIconButtonStyle}"
                              Width="40"
                              Height="45"
                              AutomationProperties.Name="Account and sign-in menu"
                              AutomationProperties.HelpText="{Binding ProfileSyncTitleToolTip}"
                              ToolTip="Account status">
                        <Button.ContextMenu>
                          <ContextMenu MinWidth="210"
                                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{Binding ProfileSyncAccountLabel}"
                                      IsEnabled="False" />
                            <MenuItem x:Name="ChooseProfileImageMenuItem"
                                      Header="Choose"
                                      Click="ChooseProfileImageClick"
                                      ToolTip="Choose image" />
                            <MenuItem x:Name="RemoveProfileImageMenuItem"
                                      Header="Remove"
                                      Click="RemoveProfileImageClick"
                                      IsEnabled="{Binding HasProfileAvatarImage}"
                                      ToolTip="Remove image" />
                            <Separator />
                            <MenuItem x:Name="ProfileSignInMenuItem"
                                      Header="Login"
                                      Click="ShowProfileLoginGateClick"
                                      IsEnabled="{Binding CanProfileSyncSignIn}"
                                      ToolTip="Open login">
                              <MenuItem.Style>
                                <Style TargetType="{x:Type MenuItem}"
                                       BasedOn="{StaticResource {x:Type MenuItem}}">
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProfileSyncSignedIn}"
                                                 Value="True">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </MenuItem.Style>
                            </MenuItem>
                            <MenuItem x:Name="ProfileSignOutMenuItem"
                                      Header="Logout"
                                      Click="SignOutProfileSyncFromHeaderClick"
                                      IsEnabled="{Binding CanProfileSyncSignOut}">
                              <MenuItem.Style>
                                <Style TargetType="{x:Type MenuItem}"
                                       BasedOn="{StaticResource {x:Type MenuItem}}">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProfileSyncSignedIn}"
                                                 Value="True">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </MenuItem.Style>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Account"
                                      Click="OpenProfileSyncSettingsClick" />
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30"
                              Height="30">
                          <Grid Width="26"
                                Height="26"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Ellipse Fill="#FF2F6FCE"
                                     Stroke="#80FFFFFF"
                                     StrokeThickness="1" />
                            <TextBlock Text="{Binding ProfileAvatarInitials}"
                                       Foreground="White"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Ellipse Stroke="#80FFFFFF"
                                     StrokeThickness="1">
                              <Ellipse.Style>
                                <Style TargetType="{x:Type Ellipse}">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasProfileAvatarImage}"
                                                 Value="True">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Ellipse.Style>
                              <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding ProfileAvatarImageSource}"
                                            Stretch="UniformToFill" />
                              </Ellipse.Fill>
                            </Ellipse>
                          </Grid>
                        </Grid>
                      </Button>
                      <Button x:Name="SettingsButton"
                              Click="OpenSettingsWindowClick"
                              Style="{StaticResource HeaderIconButtonStyle}"
                              Width="40"
                              Height="45"
                              AutomationProperties.Name="Open settings"
                              ToolTip="Settings (Ctrl+,)">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="17"
                                   Foreground="{StaticResource ForegroundBrush}" />
                      </Button>
                      <Button x:Name="StudioMinimizeWindowButton" Click="MinimizeWindowClick"
                              Style="{StaticResource WindowControlButtonStyle}"
                              Height="45"
                              ToolTip="Minimize">
                        <Path Data="M 0 0 L 12 0"
                              Stroke="{StaticResource ForegroundBrush}"
                              StrokeThickness="1" />
                      </Button>
                      <Button x:Name="StudioMaximizeRestoreWindowButton" Click="MaximizeRestoreWindowClick"
                              Style="{StaticResource WindowControlButtonStyle}"
                              Height="45"
                              ToolTip="Maximize or restore">
                        <Rectangle Width="11"
                                   Height="9"
                                   Stroke="{StaticResource ForegroundBrush}"
                                   StrokeThickness="1" />
                      </Button>
                      <Button x:Name="StudioCloseWindowButton" Click="CloseWindowClick"
                              Style="{StaticResource CloseWindowButtonStyle}"
                              Height="45"
                              ToolTip="Close">
                        <Path Data="M 0 0 L 10 10 M 10 0 L 0 10"
                              Stroke="{StaticResource ForegroundBrush}"
                              StrokeThickness="1" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                  <Grid>
                  <ContentPresenter x:Name="PART_SelectedContentHost"
                                    Margin="0"
                                    ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                    ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                    <ContentPresenter.Style>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="Content" Value="{Binding SelectedContent, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Style.Triggers>
                          <!-- Standalone windows hide the shell TabPanel before it can generate TabItems.
                               Present the active workspace directly instead of depending on those hidden containers. -->
                          <DataTrigger Binding="{Binding DataContext.IsStandaloneStudio, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter Property="Content" Value="{Binding DataContext.ActiveWorkspaceTab, RelativeSource={RelativeSource TemplatedParent}}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ContentPresenter.Style>
                  </ContentPresenter>
                  <Border x:Name="StandaloneStudioHome" Background="{StaticResource AppBackgroundBrush}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding IsStandaloneStudio}" Value="True" />
                              <Condition Binding="{Binding WorkspaceTabs.Count}" Value="0" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="32">
                      <TextBlock Text="{Binding StandaloneAppName}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding StandaloneDescription}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,14,0,24" />
                      <WrapPanel HorizontalAlignment="Center">
                        <Button Content="Start a project" Click="NewStudioProjectClick" Padding="16,10" Margin="4" />
                      </WrapPanel>
                      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,20,0,0" />
                    </StackPanel>
                  </Border>
                  </Grid>
                </Border>
              </Grid>
            </ControlTemplate>
          </TabControl.Template>
          <TabControl.ItemContainerStyle>
            <Style TargetType="{x:Type TabItem}">
              <Setter Property="FontFamily" Value="{StaticResource TerminalTabChromeFontFamily}" />
              <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
              <Setter Property="Background" Value="{StaticResource PanelBrush}" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="Padding" Value="3,0" />
              <Setter Property="MinHeight" Value="40" />
              <Setter Property="VerticalAlignment" Value="Stretch" />
              <!-- TabControl also copies these alignments to the selected workspace body. -->
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="VerticalContentAlignment" Value="Stretch" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="ToolTip" Value="{Binding DisplayTitle}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="TabBorder"
                            Margin="2,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="5,5,0,0"
                            SnapsToDevicePixels="True">
                      <Grid>
                        <ContentPresenter x:Name="ContentSite"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Opacity="0.78"
                                          ContentSource="Header"
                                          RecognizesAccessKey="True" />
                        <Border x:Name="SelectionMarker"
                                Height="2"
                                Margin="10,0"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="1"
                                Visibility="Collapsed" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="TabBorder" Property="Background" Value="#1D2731" />
                        <Setter TargetName="ContentSite" Property="Opacity" Value="1" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Panel.ZIndex" Value="2" />
                        <Setter TargetName="TabBorder" Property="Background" Value="#222E39" />
                        <Setter TargetName="ContentSite" Property="Opacity" Value="1" />
                        <Setter TargetName="SelectionMarker" Property="Visibility" Value="Visible" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="SelectionMarker" Property="Background" Value="{StaticResource SecondaryVividBrush}" />
                        <Setter TargetName="SelectionMarker" Property="Visibility" Value="Visible" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </TabControl.ItemContainerStyle>
          <TabControl.ItemTemplate>
            <DataTemplate>
              <Grid MinHeight="36"
                    Background="Transparent"
                    ContextMenuOpening="WorkspaceTabContextMenuOpening"
                    MouseLeftButtonDown="WorkspaceTabHeaderMouseLeftButtonDown">
                <Grid.ContextMenu>
                  <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Settings"
                              Click="EditTerminalTabClick"
                              ToolTip="Tab settings">
                      <MenuItem.Style>
                        <Style TargetType="{x:Type MenuItem}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}"
                                         Value="{x:Static viewModels:WorkspaceTabKind.Terminal}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="Save"
                              InputGestureText="Ctrl+S"
                              Click="SaveDocumentClick">
                      <MenuItem.Style>
                        <Style TargetType="{x:Type MenuItem}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}"
                                         Value="{x:Static viewModels:WorkspaceTabKind.Document}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="Save"
                              InputGestureText="Ctrl+S"
                              Click="SaveVisualPageProjectClick">
                      <MenuItem.Style>
                        <Style TargetType="{x:Type MenuItem}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}"
                                         Value="{x:Static viewModels:WorkspaceTabKind.VisualPage}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="Detach"
                              Click="DetachVisualPageStudioClick">
                      <MenuItem.Style>
                        <Style TargetType="{x:Type MenuItem}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}"
                                         Value="{x:Static viewModels:WorkspaceTabKind.VisualPage}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="Save"
                              InputGestureText="Ctrl+Shift+S"
                              Click="SaveDocumentAsClick">
                      <MenuItem.Style>
                        <Style TargetType="{x:Type MenuItem}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}"
                                         Value="{x:Static viewModels:WorkspaceTabKind.Document}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="Export…"
                              IsEnabled="{Binding CanExport}"
                              Click="ExportDocumentClick">
                      <MenuItem.Style>
                        <Style TargetType="{x:Type MenuItem}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}"
                                         Value="{x:Static viewModels:WorkspaceTabKind.Document}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </MenuItem.Style>
                    </MenuItem>
                    <Separator>
                      <Separator.Style>
                        <Style TargetType="{x:Type Separator}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}"
                                         Value="{x:Static viewModels:WorkspaceTabKind.Terminal}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}"
                                         Value="{x:Static viewModels:WorkspaceTabKind.Document}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Separator.Style>
                    </Separator>
                    <MenuItem Header="Close"
                              Click="CloseWorkspaceTabClick" />
                  </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TabTitleText"
                           Grid.Column="1"
                           Text="{Binding DisplayTitle}"
                           Foreground="{Binding TabForegroundBrush}"
                           FontFamily="{StaticResource TerminalTabChromeFontFamily}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="7,0,6,0"
                           MaxWidth="190"
                           TextTrimming="CharacterEllipsis"
                           TextOptions.TextFormattingMode="Display"
                           TextOptions.TextRenderingMode="ClearType">
                  <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="FontWeight" Value="Normal" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                                     Value="True">
                          <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBox x:Name="TabTitleEditor"
                         Grid.Column="1"
                         Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="TerminalTabTitleEditorPreviewKeyDown"
                         LostKeyboardFocus="TerminalTabTitleEditorLostKeyboardFocus"
                         Visibility="Collapsed"
                         MinWidth="100"
                         MinHeight="0"
                         Height="28"
                         VerticalAlignment="Center"
                         Margin="7,0"
                         Padding="5,1"
                         BorderBrush="{StaticResource SecondaryBrush}"
                         Background="#ED0D1117"
                         Foreground="{Binding TabForegroundBrush}"
                         CaretBrush="{StaticResource SecondaryBrush}"
                         FontFamily="{StaticResource TerminalTabChromeFontFamily}"
                         FontSize="13"
                         FontWeight="Normal" />
                <Button Grid.Column="2"
                        Style="{StaticResource TerminalTabCloseButtonStyle}"
                        Click="CloseWorkspaceTabClick"
                        AutomationProperties.Name="Close tab"
                        ToolTip="Close tab">
                  <Path Data="M 0 0 L 8 8 M 8 0 L 0 8"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                </Button>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                  <Setter TargetName="TabTitleText" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="TabTitleEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.Resources>
            <DataTemplate DataType="{x:Type viewModels:TerminalTabViewModel}">
              <Grid ClipToBounds="True">
                <Border Background="{Binding Settings.BackgroundBrush}" />
                <Image Source="{Binding Settings.BackgroundImagePath}"
                       Stretch="UniformToFill" />
                <Grid Margin="14,12,14,24">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <RichTextBox x:Name="TerminalTranscriptText"
                               Grid.Row="0"
                               IsReadOnly="True"
                               IsReadOnlyCaretVisible="True"
                               IsInactiveSelectionHighlightEnabled="True"
                               IsUndoEnabled="False"
                               AcceptsTab="False"
                               BorderThickness="0"
                               Padding="0"
                               Background="Transparent"
                               Foreground="{Binding Settings.ForegroundBrush}"
                               CaretBrush="{StaticResource SecondaryBrush}"
                               SelectionBrush="{StaticResource AccentBrush}"
                               SelectionOpacity="0.55"
                               FontFamily="{Binding Settings.TerminalFontFamily}"
                               FontSize="{Binding Settings.TerminalFontSize}"
                               FontWeight="{Binding Settings.TerminalFontWeight}"
                               FontStyle="{Binding Settings.TerminalFontStyle}"
                               VerticalScrollBarVisibility="Auto"
                               HorizontalScrollBarVisibility="Disabled"
                               TextOptions.TextFormattingMode="Display"
                                TextOptions.TextRenderingMode="Aliased"
                                Loaded="TerminalTranscriptLoaded"
                                Unloaded="TerminalTranscriptUnloaded"
                                DataContextChanged="TerminalTranscriptDataContextChanged"
                                PreviewKeyDown="TerminalTranscriptPreviewKeyDown">
                    <RichTextBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Copy"
                                  InputGestureText="Ctrl+C"
                                  Click="TerminalCopyMenuItemClick" />
                        <MenuItem Header="Paste"
                                  InputGestureText="Ctrl+Shift+V"
                                  Click="TerminalPasteMenuItemClick" />
                        <Separator />
                        <MenuItem Header="Select"
                                  InputGestureText="Ctrl+A"
                                  Click="TerminalSelectAllMenuItemClick" />
                      </ContextMenu>
                    </RichTextBox.ContextMenu>
                    <FlowDocument PagePadding="0" />
                  </RichTextBox>
                  <Border Grid.Row="1"
                            Margin="0,6,0,0"
                            Padding="7,3"
                            Background="{Binding Settings.InputBackdropBrush}"
                            BorderBrush="{Binding Settings.InputBackdropBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Prompt}"
                                   Foreground="{Binding Settings.AccentBrush}"
                                   FontFamily="{Binding Settings.TerminalFontFamily}"
                                   FontSize="{Binding Settings.TerminalFontSize}"
                                   FontWeight="{Binding Settings.TerminalFontWeight}"
                                   FontStyle="{Binding Settings.TerminalFontStyle}"
                                   TextOptions.TextFormattingMode="Display"
                                   TextOptions.TextRenderingMode="Aliased"
                                   VerticalAlignment="Top"
                                   Margin="0,1,8,0" />
                        <TextBox x:Name="InlineTerminalInput"
                                 Grid.Column="1"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="TerminalInputPreviewKeyDown"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Hidden"
                                 MinHeight="26"
                                 MaxHeight="120"
                                 Padding="0,1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{Binding Settings.ForegroundBrush}"
                                 CaretBrush="{StaticResource SecondaryBrush}"
                                 FontFamily="{Binding Settings.TerminalFontFamily}"
                                 FontSize="{Binding Settings.TerminalFontSize}"
                                 FontWeight="{Binding Settings.TerminalFontWeight}"
                                 FontStyle="{Binding Settings.TerminalFontStyle}"
                                 TextOptions.TextFormattingMode="Display"
                                 TextOptions.TextRenderingMode="Aliased"
                                 SpellCheck.IsEnabled="False" />
                        <TextBlock Grid.Column="2"
                                   Text="▰ RUN"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Foreground="{StaticResource SecondaryBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   VerticalAlignment="Top"
                                   Margin="10,5,0,0" />
                        <Button Grid.Column="3"
                                Command="{Binding ReconnectCommand}"
                                Style="{StaticResource HeaderIconButtonStyle}"
                                Width="30"
                                Height="30"
                                Margin="9,0,0,0"
                                VerticalAlignment="Top"
                                Visibility="{Binding IsRemote, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="Connection status">
                          <TextBlock Text="↻"
                                     FontSize="17"
                                     Foreground="{StaticResource SecondaryBrush}" />
                        </Button>
                        <ToggleButton x:Name="TerminalAiLiveAssistToggle"
                                      Grid.Column="4"
                                      IsChecked="{Binding IsAiLiveAssistEnabled, Mode=OneWay}"
                                      Click="WorkspaceTabLiveAssistClick"
                                      Style="{StaticResource AiLiveToggleStyle}"
                                      VerticalAlignment="Top"
                                      Margin="10,0,0,0"
                                      AutomationProperties.Name="Toggle AI live assistance for this terminal"
                                      AutomationProperties.HelpText="White means off, blue means enabled, and a blue pulse means the assistant is handling live activity."
                                      ToolTip="Live assistance" />
                      </Grid>
                  </Border>
                </Grid>

              </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:DocumentTabViewModel}">
              <Grid Background="#FF0D1117"
                    ClipToBounds="True">
                <Grid.RowDefinitions>
                  <RowDefinition Height="44" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="26" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#FF161B22"
                        BorderBrush="#FF30363D"
                        BorderThickness="0,0,0,1">
                  <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayTitle}"
                                 Foreground="{StaticResource ForegroundBrush}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding StatusText}"
                                 Foreground="{StaticResource MutedForegroundBrush}"
                                 FontSize="9"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding LanguageId, Mode=OneWay}"
                              SelectionChanged="DocumentLanguageSelectionChanged"
                              Height="32"
                              Width="112"
                              Margin="10,0,6,0"
                              Padding="8,2"
                              FontSize="10"
                              ToolTip="Document language">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="3"
                            CommandParameter="{Binding ElementName=DocumentEditor}"
                            Click="OpenNewItemMenu"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            Width="Auto"
                            Height="32"
                            Padding="10,0"
                            Margin="0,0,4,0"
                            Visibility="{Binding IsMarkdownDocument, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Markdown formatting">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Paragraph"
                                    Tag="paragraph"
                                    Click="MarkdownFormatClick" />
                          <MenuItem Header="H1"
                                    Tag="heading1"
                                    Click="MarkdownFormatClick" />
                          <MenuItem Header="H2"
                                    Tag="heading2"
                                    Click="MarkdownFormatClick" />
                          <MenuItem Header="H3"
                                    Tag="heading3"
                                    Click="MarkdownFormatClick" />
                          <Separator />
                          <MenuItem Header="Bold"
                                    InputGestureText="Ctrl+B"
                                    Tag="bold"
                                    Click="MarkdownFormatClick" />
                          <MenuItem Header="Italic"
                                    InputGestureText="Ctrl+I"
                                    Tag="italic"
                                    Click="MarkdownFormatClick" />
                          <MenuItem Header="Strikethrough"
                                    Tag="strikethrough"
                                    Click="MarkdownFormatClick" />
                          <MenuItem Header="Code"
                                    Tag="inlineCode"
                                    Click="MarkdownFormatClick" />
                          <MenuItem Header="Link"
                                    Tag="link"
                                    Click="MarkdownFormatClick" />
                          <Separator />
                          <MenuItem Header="Bullets"
                                    Tag="bulletList"
                                    Click="MarkdownFormatClick" />
                          <MenuItem Header="Numbers"
                                    Tag="numberedList"
                                    Click="MarkdownFormatClick" />
                          <MenuItem Header="Quote"
                                    Tag="quote"
                                    Click="MarkdownFormatClick" />
                          <MenuItem Header="Block"
                                    Tag="codeBlock"
                                    Click="MarkdownFormatClick" />
                          <MenuItem Header="Rule"
                                    Tag="horizontalRule"
                                    Click="MarkdownFormatClick" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <TextBlock Text="FORMAT  ▾"
                                 Foreground="{StaticResource SecondaryBrush}"
                                 FontSize="10"
                                 FontWeight="Bold" />
                    </Button>

                    <Button Grid.Column="4"
                            CommandParameter="{Binding ElementName=DocumentEditor}"
                            Click="OpenNewItemMenu"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            Width="Auto"
                            Height="32"
                            Padding="10,0"
                            Margin="0,0,4,0"
                            ToolTip="Editor settings">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Edit"
                                    Tag="Edit"
                                    Click="DocumentViewModeClick" />
                          <MenuItem Header="Split"
                                    Tag="Split"
                                    Click="DocumentViewModeClick" />
                          <MenuItem Header="Preview"
                                    Tag="Preview"
                                    Click="DocumentViewModeClick" />
                          <Separator />
                          <MenuItem Header="Wrap"
                                    Click="ToggleDocumentWordWrapClick" />
                          <MenuItem Header="Lines"
                                    Click="ToggleDocumentLineNumbersClick" />
                          <MenuItem Header="Minimap"
                                    Click="ToggleDocumentMinimapClick" />
                          <Separator />
                          <MenuItem Header="JetBrains"
                                    Tag="JetBrains Mono"
                                    Click="DocumentFontFamilyClick" />
                          <MenuItem Header="Cascadia"
                                    Tag="Cascadia Mono"
                                    Click="DocumentFontFamilyClick" />
                          <MenuItem Header="Consolas"
                                    Tag="Consolas"
                                    Click="DocumentFontFamilyClick" />
                          <Separator />
                          <MenuItem Header="12"
                                    Tag="12"
                                    Click="DocumentFontSizeClick" />
                          <MenuItem Header="14"
                                    Tag="14"
                                    Click="DocumentFontSizeClick" />
                          <MenuItem Header="16"
                                    Tag="16"
                                    Click="DocumentFontSizeClick" />
                          <MenuItem Header="18"
                                    Tag="18"
                                    Click="DocumentFontSizeClick" />
                          <MenuItem Header="22"
                                    Tag="22"
                                    Click="DocumentFontSizeClick" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <TextBlock Foreground="{StaticResource ForegroundBrush}"
                                 FontSize="10"
                                 FontWeight="Bold">
                        <Run Text="{Binding EditorViewModeLabel, Mode=OneWay}" />
                        <Run Text="  ▾" />
                      </TextBlock>
                    </Button>

                    <Button Grid.Column="5"
                            CommandParameter="{Binding ElementName=DocumentEditor}"
                            Click="OpenNewItemMenu"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            Width="Auto"
                            Height="32"
                            Padding="10,0"
                            ToolTip="Document actions">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="New"
                                    Click="NewDocumentClick" />
                          <MenuItem Header="Open"
                                    InputGestureText="Ctrl+O"
                                    Click="OpenDocumentClick" />
                          <Separator />
                          <MenuItem Header="Save"
                                    InputGestureText="Ctrl+S"
                                    Click="SaveDocumentClick" />
                          <MenuItem Header="Save"
                                    InputGestureText="Ctrl+Shift+S"
                                    Click="SaveDocumentAsClick" />
                          <MenuItem Header="Run"
                                    Click="RunDocumentClick"
                                    IsEnabled="{Binding PlacementTarget.DataContext.CanRunDocument, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                          <MenuItem Header="&#x25B6;  Preview"
                                    Click="PreviewDocumentInBrowserClick"
                                    IsEnabled="{Binding PlacementTarget.DataContext.CanPreviewInBrowser, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                          <MenuItem Header="Export"
                                    Click="ExportDocumentClick" />
                          <Separator />
                          <MenuItem Header="Find"
                                    InputGestureText="Ctrl+F"
                                    Click="FindDocumentClick" />
                          <MenuItem Header="Replace"
                                    InputGestureText="Ctrl+H"
                                    Click="ReplaceDocumentClick" />
                          <MenuItem Header="Goto"
                                    InputGestureText="Ctrl+G"
                                    Click="GoToLineDocumentClick" />
                          <MenuItem Header="Format"
                                    InputGestureText="Ctrl+Shift+F"
                                    Click="FormatDocumentClick" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <TextBlock Text="DOCUMENT  ▾"
                                 Foreground="{StaticResource ForegroundBrush}"
                                 FontSize="10"
                                 FontWeight="Bold" />
                    </Button>

                    <ToggleButton x:Name="DocumentAiLiveAssistToggle"
                                  Grid.Column="6"
                                  IsChecked="{Binding IsAiLiveAssistEnabled, Mode=OneWay}"
                                  Click="WorkspaceTabLiveAssistClick"
                                  Style="{StaticResource AiLiveToggleStyle}"
                                  Height="32"
                                  Margin="7,0,0,0"
                                  AutomationProperties.Name="Toggle AI live assistance for this document"
                                  AutomationProperties.HelpText="White means off, blue means enabled, and a blue pulse means the assistant is handling live activity."
                                  ToolTip="Live assistance" />

                  </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Background="#FF0D1117">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding EditorPaneWidth}" />
                    <ColumnDefinition Width="{Binding PreviewSplitterWidth}" />
                    <ColumnDefinition Width="{Binding PreviewPaneWidth}" />
                  </Grid.ColumnDefinitions>

                  <controls:MonacoEditorControl x:Name="DocumentEditor"
                                                 Grid.Column="0"
                                                 Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 LanguageId="{Binding LanguageId}"
                                                 EditorOptions="{Binding EditorSettings}"
                                                 ViewState="{Binding EditorViewState, Mode=TwoWay}"
                                                 NewDocumentRequested="DocumentEditorNewDocumentRequested"
                                                 OpenDocumentRequested="DocumentEditorOpenDocumentRequested"
                                                 SaveRequested="DocumentEditorSaveRequested"
                                                 SaveAsRequested="DocumentEditorSaveAsRequested"
                                                 FormatRequested="DocumentEditorFormatRequested"
                                                 EditorCommandCompleted="DocumentEditorCommandCompleted" />

                  <GridSplitter Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="#FF30363D"
                                ResizeBehavior="PreviousAndNext"
                                ResizeDirection="Columns"
                                ShowsPreview="True" />

                  <controls:MarkdownPreviewControl Grid.Column="2"
                                                   Markdown="{Binding Content}"
                                                   DocumentTitle="{Binding DisplayTitle}"
                                                   Visibility="{Binding IsMarkdownDocument, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <Border Grid.Row="2"
                        Background="#FF161B22"
                        BorderBrush="#FF30363D"
                        BorderThickness="0,1,0,0"
                        Padding="8,0">
                  <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                      <TextBlock Text="{Binding DocumentStatisticsText}"
                                 Foreground="{StaticResource MutedForegroundBrush}"
                                 FontSize="10" />
                      <TextBlock Text="  ·  "
                                 Foreground="{StaticResource BorderBrush}"
                                 FontSize="10" />
                      <TextBlock Text="{Binding IndentationStatus}"
                                 Foreground="{StaticResource MutedForegroundBrush}"
                                 FontSize="10" />
                      <TextBlock Text="  ·  "
                                 Foreground="{StaticResource BorderBrush}"
                                 FontSize="10" />
                      <ComboBox ItemsSource="{Binding EncodingOptions}"
                                SelectedValuePath="Kind"
                                SelectedValue="{Binding EncodingKind, Mode=TwoWay}"
                                Height="22"
                                MinWidth="84"
                                Padding="5,0"
                                FontSize="9"
                                ToolTip="Document encoding">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock Text="  ·  "
                                 Foreground="{StaticResource BorderBrush}"
                                 FontSize="10" />
                      <ComboBox ItemsSource="{Binding LineEndingOptions}"
                                SelectedValuePath="Kind"
                                SelectedValue="{Binding LineEndingKind, Mode=TwoWay}"
                                Height="22"
                                MinWidth="66"
                                Padding="5,0"
                                FontSize="9"
                                ToolTip="Line endings">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock Text="  ·  "
                                 Foreground="{StaticResource BorderBrush}"
                                 FontSize="10" />
                      <TextBlock Text="{Binding LanguageId}"
                                 Foreground="{StaticResource MutedForegroundBrush}"
                                 FontSize="10" />
                    </StackPanel>
                    <TextBlock Text="{Binding ProviderStatusText}"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="Provider status" />
                  </DockPanel>
                </Border>
              </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:PdfDocumentTabViewModel}">
              <ContentControl Content="{Binding PdfView}" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:BrowserTabViewModel}">
              <ContentControl Content="{Binding BrowserView}" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:NetworkClientTabViewModel}">
              <ContentControl Content="{Binding NetworkView}" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:VisualPageStudioTabViewModel}">
              <ContentControl Content="{Binding StudioView}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:StudioProjectStartTabViewModel}">
              <studio:StudioProjectStartView />
            </DataTemplate>
          </TabControl.Resources>
        </TabControl>

        <Border x:Name="CommandBuilderEdgeRevealHost"
                Width="39" Height="38"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Panel.ZIndex="10" ClipToBounds="True"
                Visibility="{Binding ShouldShowCommandBuilderReopenButton, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Button x:Name="CommandBuilderReopenButton"
                   Margin="4,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Command="{Binding ToggleCommandBuilderCommand}"
                  Style="{StaticResource WorkspaceSidebarToggleButtonStyle}"
                   AutomationProperties.Name="Show right sidebar"
                   ToolTip="Show right sidebar">
            <Path Data="{StaticResource WorkspaceDoubleChevronGeometry}"
                   Width="14"
                   Height="16"
                  Stretch="Uniform"
                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                   StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
          </Button>
        </Border>
      </Grid>
    </DockPanel>

    <Grid x:Name="StartupProfileLoginGate"
          Panel.ZIndex="1000"
          Background="#FF081226"
          Visibility="{Binding IsProfileLoginGateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="46" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Background="#FF091329"
              BorderBrush="#FF25324D"
              BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Click="MinimizeWindowClick"
                    Style="{StaticResource WindowControlButtonStyle}"
                    Height="45"
                    ToolTip="Minimize">
              <Path Data="M 0 0 L 12 0"
                    Stroke="#FFE8ECF1"
                    StrokeThickness="1" />
            </Button>
            <Button Click="CloseWindowClick"
                    Style="{StaticResource CloseWindowButtonStyle}"
                    Height="45"
                    ToolTip="Close">
              <Path Data="M 0 0 L 10 10 M 10 0 L 0 10"
                    Stroke="#FFE8ECF1"
                    StrokeThickness="1" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1"
            ClipToBounds="True">
        <Viewbox Stretch="UniformToFill"
                 IsHitTestVisible="False"
                 Opacity="0.34">
          <Canvas Width="1180"
                  Height="760">
            <Rectangle Width="1180"
                       Height="760"
                       Fill="#FF081226" />
            <Ellipse Canvas.Left="225"
                     Canvas.Top="-20"
                     Width="730"
                     Height="730"
                     Stroke="#243C5684"
                     StrokeThickness="1" />
            <Ellipse Canvas.Left="310"
                     Canvas.Top="65"
                     Width="560"
                     Height="560"
                     Stroke="#2A3C5684"
                     StrokeThickness="1" />
            <Ellipse Canvas.Left="395"
                     Canvas.Top="150"
                     Width="390"
                     Height="390"
                     Stroke="#303C5684"
                     StrokeThickness="1" />
          </Canvas>
        </Viewbox>

        <ScrollViewer HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="28">
          <StackPanel Width="360">
            <TextBlock Text="A T L A S   U N I V E R S A L I S"
                       Foreground="#D9EDF3FF"
                       FontFamily="Montserrat, Segoe UI Light"
                       FontSize="16"
                       FontWeight="Light"
                       TextAlignment="Center" />
            <TextBlock Text="H Y P E R D E S K"
                       Foreground="#FF8191B2"
                       FontFamily="Montserrat, Segoe UI"
                       FontSize="9"
                       FontWeight="Light"
                       TextAlignment="Center"
                       Margin="0,8,0,0" />

            <Button Content="Login"
                    Click="BeginProfileLoginClick"
                    IsEnabled="{Binding CanBeginProfileLogin}"
                    Height="42"
                    Margin="40,24,40,0"
                    Foreground="#FFF4F7FF"
                    Background="#FF315DAD"
                    BorderBrush="#FF5A8DFF"
                    BorderThickness="1"
                    FontFamily="Segoe UI Variable Text, Segoe UI"
                    FontSize="12"
                    FontWeight="SemiBold" />
            <Button Content="Offline"
                    Click="ContinueWithoutProfileLoginClick"
                    IsEnabled="{Binding CanContinueWithoutProfileLogin}"
                    Height="30"
                    Margin="80,7,80,0"
                    Foreground="#FF8191B2"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="10" />

            <Border Margin="0,20,0,0"
                    Padding="13,11"
                    Background="#CC101D39"
                    BorderBrush="#FF2A3958"
                    BorderThickness="1"
                    CornerRadius="5"
                    Visibility="{Binding HasPendingProfileLoginAuthorization, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel>
                <TextBlock Text="BROWSER SIGN-IN"
                           Foreground="#FF8191B2"
                           FontSize="8"
                           TextAlignment="Center" />
                <TextBlock Text="Complete sign-in."
                           Foreground="#FFEDF3FF"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="10"
                           FontWeight="Normal"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="4,5,4,0" />
                <TextBlock Text="Fallback address"
                           Foreground="#FF8191B2"
                           FontSize="8"
                           TextAlignment="Center"
                           Margin="0,9,0,0" />
                <TextBlock Text="{Binding PendingProfileLoginUri}"
                           Foreground="#FF8191B2"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="9"
                           FontWeight="Normal"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0" />
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding ProfileLoginStatus}"
                       Foreground="#FF9AA8C4"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="10"
                       FontWeight="Normal"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="4,14,4,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <Trigger Property="Text" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ProgressBar Height="2"
                         IsIndeterminate="True"
                         Foreground="#FF5A8DFF"
                         Background="#FF172542"
                         Margin="40,10,40,0"
                         Visibility="{Binding IsProfileLoginFlowActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="Cancel"
                    Click="CancelProfileLoginClick"
                    IsEnabled="{Binding CanCancelProfileLogin}"
                    Visibility="{Binding CanCancelProfileLogin, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Height="30"
                    Margin="80,9,80,0"
                    Foreground="#FFB8C3D9"
                    Background="Transparent"
                    BorderBrush="#FF2A3958" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Grid x:Name="WorkspaceCustomizationOverlay"
          Panel.ZIndex="500"
          Margin="0,46,0,0"
          Visibility="Collapsed">
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="12"
              Padding="10,8"
              Background="#F5161B22"
              BorderBrush="{StaticResource SecondaryBrush}"
              BorderThickness="1"
              CornerRadius="5">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right"
                      Orientation="Horizontal"
                      Margin="18,0,0,0">
            <Button Content="Settings"
                    Click="OpenWorkspaceLayoutSettingsFromCustomizationClick"
                    Margin="0,0,6,0"
                    Padding="10,4"
                    ToolTip="Open settings" />
            <Button Content="Cancel"
                    Click="CancelWorkspaceCustomizationClick"
                    Margin="0,0,6,0"
                    Padding="10,4"
                    ToolTip="Restore layout" />
            <Button Content="Done"
                    Click="FinishWorkspaceCustomizationClick"
                    Margin="0,0,6,0"
                    Padding="10,4"
                    ToolTip="Keep session" />
            <Button Content="Save"
                    Click="SaveWorkspaceCustomizationClick"
                    Padding="10,4"
                    Background="{StaticResource SecondaryHoverBrush}"
                    BorderBrush="{StaticResource SecondaryBrush}"
                    ToolTip="Save layout" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="WORKSPACE CUSTOMIZATION"
                       Foreground="{StaticResource SecondaryVividBrush}"
                       FontSize="10"
                       FontWeight="Bold" />
            <TextBlock x:Name="WorkspaceCustomizationStatusText"
                       Text="Drag a panel."
                       Foreground="{StaticResource MutedForegroundBrush}"
                       FontSize="10"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="440" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border x:Name="WorkspaceDropPalette"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="650"
              Padding="18"
              Background="#F5161B22"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="7">
        <StackPanel>
          <TextBlock Text="MOVE PANEL"
                     Foreground="{StaticResource SecondaryVividBrush}"
                     FontSize="11"
                     FontWeight="Bold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Choose a host."
                     Foreground="{StaticResource MutedForegroundBrush}"
