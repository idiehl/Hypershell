<Window x:Class="Hypershell.ExplorerTextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="590"
        Height="245"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}">
  <Border Background="{StaticResource PanelBrush}"
          BorderBrush="#2E5D86"
          BorderThickness="1"
          CornerRadius="10"
          ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="56" />
        <RowDefinition Height="*" />
        <RowDefinition Height="58" />
      </Grid.RowDefinitions>
      <Border Background="#10151B"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
        <Grid Margin="16,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="HeadingText"
                     FontSize="17"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Click="CancelClick"
                  Style="{StaticResource HeaderIconButtonStyle}"
                  Width="34"
                  Height="34">
            <Path Data="M 3 3 L 13 13 M 13 3 L 3 13"
                  Stroke="{StaticResource ForegroundBrush}"
                  StrokeThickness="1.5" />
          </Button>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="22,18,22,12">
        <TextBlock x:Name="PromptText"
                   FontSize="10"
                   FontWeight="Bold"
                   Foreground="{StaticResource SecondaryBrush}"
                   Margin="0,0,0,5" />
        <TextBox x:Name="ValueTextBox"
                 MinHeight="34" />
        <TextBlock x:Name="StatusText"
                   Foreground="#FFFF7B72"
                   Margin="1,6,0,0" />
      </StackPanel>
      <Border Grid.Row="2"
              Background="#10151B"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="18,9">
          <Button Content="Cancel"
                  Click="CancelClick"
                  Padding="16,7"
                  Margin="0,0,8,0" />
          <Button x:Name="AcceptButton"
                  Click="AcceptClick"
                  Padding="18,7"
                  Background="{StaticResource AccentHoverBrush}"
                  IsDefault="True" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
