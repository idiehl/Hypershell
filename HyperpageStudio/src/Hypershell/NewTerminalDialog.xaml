<Window x:Class="Hypershell.NewTerminalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Tab"
        Width="560"
        Height="690"
        MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <Style x:Key="SectionNumberStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="HintStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="1,4,0,0" />
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource PanelBrush}"
          BorderBrush="#2E5D86"
          BorderThickness="1"
          CornerRadius="10"
          ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24"
                        ShadowDepth="8"
                        Opacity="0.58"
                        Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Background="#10151B"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
        <Grid Margin="16,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="&gt;_"
                     FontFamily="{StaticResource TerminalFontFamily}"
                     FontSize="27"
                     Foreground="{StaticResource SecondaryBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="DialogTitleText"
                       Text="New Tab"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ForegroundBrush}" />
            <TextBlock x:Name="DialogSubtitleText"
                       Text="Terminal options"
                       FontSize="9.5"
                       Foreground="{StaticResource MutedForegroundBrush}" />
          </StackPanel>
          <Button Grid.Column="2"
                  Click="CancelClick"
                  Style="{StaticResource HeaderIconButtonStyle}"
                  Width="34"
                  Height="34"
                  ToolTip="Cancel">
            <Path Data="M 3 3 L 13 13 M 13 3 L 3 13"
                  Stroke="{StaticResource ForegroundBrush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,20">
          <TextBlock Text="01  SHELL" Style="{StaticResource SectionNumberStyle}" />
          <ComboBox x:Name="ShellProfileComboBox"
                    SelectionChanged="ShellProfileSelectionChanged">
            <ComboBox.ItemContainerStyle>
              <Style TargetType="{x:Type ComboBoxItem}"
                     BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
              </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding DisplayName}" />
                  <TextBlock Text="{Binding AvailabilityMessage}"
                             FontSize="9"
                             Foreground="{StaticResource MutedForegroundBrush}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="02  NAME"
                     Style="{StaticResource SectionNumberStyle}"
                     Margin="0,14,0,4" />
          <TextBox x:Name="TitleTemplateTextBox" />
          <TextBlock Text="Name freely"
                     Style="{StaticResource HintStyle}" />

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="03  ACCENT" Style="{StaticResource SectionNumberStyle}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="34" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Width="31"
                        Height="31"
                        Padding="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Click="ChooseTabColorClick"
                        ToolTip="Tab color">
                  <Border x:Name="TabColorPreview"
                          CornerRadius="5"
                          BorderBrush="#7A838F"
                          BorderThickness="1" />
                </Button>
                <TextBox x:Name="TabColorTextBox"
                         Grid.Column="1"
                         IsReadOnly="True"
                         TextChanged="ColorTextChanged" />
              </Grid>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="04  COLOR" Style="{StaticResource SectionNumberStyle}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="34" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Width="31"
                        Height="31"
                        Padding="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Click="ChooseTerminalColorClick"
                        ToolTip="Terminal color">
                  <Border x:Name="BackgroundColorPreview"
                          CornerRadius="5"
                          BorderBrush="#7A838F"
                          BorderThickness="1" />
                </Button>
                <TextBox x:Name="BackgroundColorTextBox"
                         Grid.Column="1"
                         IsReadOnly="True"
                         TextChanged="ColorTextChanged" />
              </Grid>
            </StackPanel>
          </Grid>

          <TextBlock Text="05  IMAGE"
                     Style="{StaticResource SectionNumberStyle}"
                     Margin="0,14,0,4" />
          <TextBox x:Name="BackgroundImagePathTextBox"
                   IsReadOnly="True" />
          <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <Button Content="CHOOSE" Click="ChooseBackgroundImageClick" />
            <Button Content="CLEAR" Click="ClearBackgroundImageClick" Margin="6,0,0,0" />
          </StackPanel>

          <TextBlock Text="06  FONT" Style="{StaticResource SectionNumberStyle}" Margin="0,14,0,4" />
          <ComboBox x:Name="FontFamilyComboBox"
                    ItemTemplate="{StaticResource FontFamilyPreviewTemplate}"
                    MaxDropDownHeight="420" />

          <TextBlock Text="07  LAUNCH"
                     Style="{StaticResource SectionNumberStyle}"
                     Margin="0,14,0,4" />
          <TextBox x:Name="StartupCommandTextBox"
                   Height="72"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   FontFamily="{StaticResource CodeFontFamily}" />
          <TextBlock x:Name="StartupCommandHintText"
                     Text="Runs once"
                     Style="{StaticResource HintStyle}" />

          <CheckBox x:Name="SaveDefaultsCheckBox"
                    Visibility="Collapsed"
                    IsChecked="False" />
          <TextBlock x:Name="ProfileDefaultsHintText"
                     Text="Tab override"
                     Style="{StaticResource HintStyle}" />

          <TextBlock x:Name="ValidationText"
                     Foreground="{StaticResource AttentionBrush}"
                     TextWrapping="Wrap"
                     MinHeight="18"
                     Margin="0,10,0,0" />

          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="CANCEL"
                    Click="CancelClick"
                    Padding="12,8"
                    Margin="0,0,5,0"
                    IsCancel="True" />
            <Button x:Name="CreateButton"
                    Grid.Column="1"
                    Content="Create"
                    Click="CreateClick"
                    Padding="12,8"
                    Margin="5,0,0,0"
                    Background="{StaticResource SecondaryHoverBrush}"
                    IsDefault="True" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
