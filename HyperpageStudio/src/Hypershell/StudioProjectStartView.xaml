<UserControl x:Class="Hypershell.StudioProjectStartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hypershell"
             Background="{StaticResource AppBackgroundBrush}"
             Foreground="{StaticResource ForegroundBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <UserControl.Resources>
    <Style x:Key="StartLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <Style x:Key="StartCardStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="MinHeight" Value="178" />
    </Style>
    <Style x:Key="StartPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource SecondaryHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="20,10" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border x:Name="ProjectStartHeading" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
            Visibility="{Binding ShowFoundationChoices, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid Margin="28,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="25" FontWeight="SemiBold">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Start a project" /><Style.Triggers><DataTrigger Binding="{Binding IsWizardVisible}" Value="True"><Setter Property="Text" Value="Build your site" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock TextWrapping="Wrap" Margin="0,6,20,0" Foreground="{StaticResource MutedForegroundBrush}">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="One project per upper tab. Files and the canvas stay together inside it." /><Style.Triggers><DataTrigger Binding="{Binding IsWizardVisible}" Value="True"><Setter Property="Text" Value="Shape your Work landing page, then build reusable Page templates. Add article content afterward." /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <Button Grid.Column="1" x:Name="OpenProjectButton" Click="OpenProjectClick" IsEnabled="{Binding IsEditable}"
                VerticalAlignment="Center" Padding="15,10" ToolTip="Choose an existing project folder"
                AutomationProperties.Name="Open existing Studio project">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryVividBrush}" />
            <TextBlock Text="Open project" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <ScrollViewer x:Name="StartContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding ShowFoundationChoices, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel Margin="28,24" MaxWidth="1120" HorizontalAlignment="Stretch" IsEnabled="{Binding IsEditable}">
        <StackPanel Visibility="{Binding ShowFoundationChoices, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Text="Choose your project type" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15" />
          <UniformGrid Columns="3" Margin="0,0,0,24">
            <Button x:Name="HyperlibProjectCard" Command="{Binding ChooseHyperlibCommand}" Margin="0,0,10,0" AutomationProperties.Name="Create Hyperlib Work project">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StartCardStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsHyperlibSelected}" Value="True"><Setter Property="Background" Value="{StaticResource SecondaryTintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
              <StackPanel>
                <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="25" Foreground="{StaticResource SecondaryVividBrush}" Margin="0,0,0,18" />
                <TextBlock Text="Hyperlib Work" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="A Work landing page and reusable Page layouts, with content authored in Studio." TextWrapping="Wrap" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,8,0,0" LineHeight="19" />
              </StackPanel>
            </Button>
            <Button x:Name="RazorProjectCard" Command="{Binding ChooseRazorCommand}" Margin="0,0,10,0" AutomationProperties.Name="Create Razor Pages project">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StartCardStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsRazorSelected}" Value="True"><Setter Property="Background" Value="{StaticResource SecondaryTintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
              <StackPanel>
                <TextBlock Text="&#xE943;" FontFamily="Segoe Fluent Icons" FontSize="25" Foreground="{StaticResource SecondaryVividBrush}" Margin="0,0,0,18" />
                <TextBlock Text="Razor Pages" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="A working ASP.NET Core web app with a shared layout and responsive pages." TextWrapping="Wrap" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,8,0,0" LineHeight="19" />
              </StackPanel>
            </Button>
            <Button x:Name="HtmlProjectCard" Command="{Binding ChooseHtmlCommand}" AutomationProperties.Name="Create HTML project">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StartCardStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsHtmlSelected}" Value="True"><Setter Property="Background" Value="{StaticResource SecondaryTintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
              <StackPanel>
                <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="25" Foreground="{StaticResource SecondaryVividBrush}" Margin="0,0,0,18" />
                <TextBlock Text="HTML" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="A complete website with HTML, CSS, JavaScript, and a local preview." TextWrapping="Wrap" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,8,0,0" LineHeight="19" />
              </StackPanel>
            </Button>
          </UniformGrid>
        </StackPanel>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,22">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="Project name" Style="{StaticResource StartLabelStyle}" />
              <TextBox x:Name="ProjectNameTextBox" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" MinHeight="37" AutomationProperties.Name="New project name" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Create in" Style="{StaticResource StartLabelStyle}" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="ProjectLocationTextBox" Text="{Binding ParentDirectory, UpdateSourceTrigger=PropertyChanged}" MinHeight="37" AutomationProperties.Name="New project parent folder" />
                <Button Grid.Column="1" Click="ChooseLocationClick" Margin="8,0,0,0" Width="38" ToolTip="Choose location" AutomationProperties.Name="Choose project location">
                  <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="17" />
                </Button>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>
        <TextBlock Text="{Binding ProjectDirectoryPreview}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectDirectoryPreview}"
                   Foreground="{StaticResource MutedForegroundBrush}" FontSize="11" Margin="1,-13,0,9" />
        <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource AttentionBrush}" TextWrapping="Wrap" Margin="0,0,0,15"
                   Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </StackPanel>
    </ScrollViewer>
    <local:HyperlibWorkWizardView x:Name="WorkWizard" Grid.Row="1" Margin="24,16" DataContext="{Binding Wizard}"
                                 IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType={x:Type local:StudioProjectStartView}}}"
                                 Visibility="{Binding DataContext.IsWizardVisible, RelativeSource={RelativeSource AncestorType={x:Type local:StudioProjectStartView}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <local:StudioProjectTemplateGalleryView x:Name="TemplateGallery" Grid.Row="1" Margin="24,16" DataContext="{Binding Gallery}"
                                 IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType={x:Type local:StudioProjectStartView}}}"
                                 Visibility="{Binding DataContext.IsTemplateGalleryVisible, RelativeSource={RelativeSource AncestorType={x:Type local:StudioProjectStartView}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,15">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource AttentionBrush}" Margin="0,0,0,10"
                     Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Text="{Binding CompatibilityMessage}" TextWrapping="Wrap" Foreground="{StaticResource AttentionBrush}" Margin="0,0,0,10"
                     Visibility="{Binding HasCompatibilityError, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
        <DockPanel Grid.Row="1" LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsEditable}" Visibility="{Binding IsWizardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Button x:Name="WizardBackButton" Content="Back" Command="{Binding Wizard.BackCommand}" Padding="17,10" Margin="0,0,8,0" />
              <Button x:Name="WizardNextButton" Content="{Binding Wizard.NextLabel}" Command="{Binding Wizard.NextCommand}" Style="{StaticResource StartPrimaryButtonStyle}" Margin="0,0,8,0"
                      Visibility="{Binding Wizard.ShowNext, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <Button x:Name="CreateProjectButton" Content="{Binding CreateLabel}" Command="{Binding CreateCommand}" Style="{StaticResource StartPrimaryButtonStyle}"
                    Visibility="{Binding ShowCreate, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <Button Content="Project settings" HorizontalAlignment="Left" Command="{Binding ChangeProjectTypeCommand}" Background="Transparent" Padding="0,7"
                    Foreground="{StaticResource MutedForegroundBrush}" Visibility="{Binding ShowBackToSetup, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryVividBrush}" />
          </StackPanel>
        </DockPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
