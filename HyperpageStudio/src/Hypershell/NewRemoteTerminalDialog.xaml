<Window x:Class="Hypershell.NewRemoteTerminalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Terminal"
        Width="540"
        Height="590"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <Style x:Key="RemoteFieldLabelStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource PanelBrush}"
          BorderBrush="#2E5D86"
          BorderThickness="1"
          CornerRadius="10"
          ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24"
                        ShadowDepth="8"
                        Opacity="0.58"
                        Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Background="#10151B"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
        <Grid Margin="16,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="⌁"
                     FontSize="25"
                     Foreground="{StaticResource SecondaryBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,11,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Remote Terminal"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ForegroundBrush}" />
            <TextBlock Text="Remote shell"
                       FontSize="9.5"
                       Foreground="{StaticResource MutedForegroundBrush}" />
          </StackPanel>
          <Button Grid.Column="2"
                  Click="CancelClick"
                  Style="{StaticResource HeaderIconButtonStyle}"
                  Width="34"
                  Height="34"
                  ToolTip="Cancel">
            <Path Data="M 3 3 L 13 13 M 13 3 L 3 13"
                  Stroke="{StaticResource ForegroundBrush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="22,18,22,20">
        <TextBlock Text="DEVICE" Style="{StaticResource RemoteFieldLabelStyle}" />
        <ComboBox x:Name="HostComboBox"
                  SelectionChanged="HostSelectionChanged">
          <ComboBox.ItemContainerStyle>
            <Style TargetType="{x:Type ComboBoxItem}"
                   BasedOn="{StaticResource {x:Type ComboBoxItem}}">
              <Setter Property="IsEnabled" Value="{Binding CanConnect}" />
            </Style>
          </ComboBox.ItemContainerStyle>
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding DisplayName}" />
                <TextBlock Text="{Binding Status}"
                           FontSize="9"
                           Foreground="{StaticResource MutedForegroundBrush}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="SHELL" Style="{StaticResource RemoteFieldLabelStyle}" />
            <ComboBox x:Name="ShellComboBox"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="ShellSelectionChanged" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="DIRECTORY"
                       Style="{StaticResource RemoteFieldLabelStyle}" />
            <TextBox x:Name="WorkingDirectoryTextBox" />
          </StackPanel>
        </Grid>

        <TextBlock Text="SHELL"
                   Style="{StaticResource RemoteFieldLabelStyle}"
                   Margin="0,14,0,4" />
        <TextBox x:Name="ShellCommandTextBox"
                 FontFamily="{StaticResource CodeFontFamily}" />

        <TextBlock Text="NAME"
                   Style="{StaticResource RemoteFieldLabelStyle}"
                   Margin="0,14,0,4" />
        <TextBox x:Name="TitleTextBox" />

        <TextBlock Text="LAUNCH"
                   Style="{StaticResource RemoteFieldLabelStyle}"
                   Margin="0,14,0,4" />
        <TextBox x:Name="StartupCommandTextBox"
                 Height="76"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="{StaticResource CodeFontFamily}" />

        <TextBlock x:Name="ValidationText"
                   Foreground="{StaticResource AttentionBrush}"
                   TextWrapping="Wrap"
                   MinHeight="35"
                   Margin="0,10,0,0" />

        <Grid Margin="0,5,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Content="CANCEL"
                  Click="CancelClick"
                  Padding="12,8"
                  Margin="0,0,5,0"
                  IsCancel="True" />
          <Button Grid.Column="1"
                  Content="CONNECT"
                  Click="ConnectClick"
                  Padding="12,8"
                  Margin="5,0,0,0"
                  Background="{StaticResource SecondaryHoverBrush}"
                  IsDefault="True" />
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>
