<Window x:Class="Hypershell.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose color"
        Width="480"
        Height="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <Style x:Key="ColorLabelStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource PanelBrush}"
          BorderBrush="#5A4230"
          BorderThickness="1"
          CornerRadius="10"
          ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24"
                        ShadowDepth="8"
                        Opacity="0.58"
                        Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Background="#10151B"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
        <Grid Margin="16,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="▦"
                     FontFamily="{StaticResource TerminalFontFamily}"
                     FontSize="25"
                     Foreground="{StaticResource SecondaryBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="PickerTitleText"
                       Text="COLOR SELECTOR"
                       FontSize="16"
                       FontWeight="Bold" />
            <TextBlock Text="Choose color"
                       FontSize="9.5"
                       Foreground="{StaticResource MutedForegroundBrush}" />
          </StackPanel>
          <Button Grid.Column="2"
                  Click="CancelClick"
                  Style="{StaticResource HeaderIconButtonStyle}"
                  Width="34"
                  Height="34"
                  ToolTip="Cancel">
            <Path Data="M 3 3 L 13 13 M 13 3 L 3 13"
                  Stroke="{StaticResource ForegroundBrush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="20,18,20,20">
        <Border x:Name="SelectedColorPreview"
                Height="76"
                CornerRadius="7"
                BorderBrush="#69717D"
                BorderThickness="1">
          <TextBlock x:Name="SelectedColorText"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontFamily="{StaticResource CodeFontFamily}"
                     FontSize="19"
                     FontWeight="Bold" />
        </Border>

        <TextBlock Text="PALETTE"
                   Style="{StaticResource ColorLabelStyle}"
                   Margin="0,15,0,6" />
        <ItemsControl x:Name="PaletteItemsControl">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Click="PaletteColorClick"
                      Tag="{Binding}"
                      Height="31"
                      Padding="2"
                      Margin="2"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      ToolTip="{Binding}">
                <Border Background="{Binding}"
                        CornerRadius="4"
                        BorderBrush="#7A838F"
                        BorderThickness="1" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="TUNE"
                   Style="{StaticResource ColorLabelStyle}"
                   Margin="0,15,0,7" />
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="38" />
            <RowDefinition Height="38" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="42" />
          </Grid.ColumnDefinitions>

          <TextBlock Text="R" Foreground="#FF7B72" FontWeight="Bold" VerticalAlignment="Center" />
          <Slider x:Name="RedSlider"
                  Grid.Column="1"
                  Minimum="0"
                  Maximum="255"
                  ValueChanged="RgbSliderValueChanged"
                  VerticalAlignment="Center" />
          <TextBlock x:Name="RedValueText"
                     Grid.Column="2"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     FontFamily="{StaticResource CodeFontFamily}" />

          <TextBlock Grid.Row="1" Text="G" Foreground="#7EE787" FontWeight="Bold" VerticalAlignment="Center" />
          <Slider x:Name="GreenSlider"
                  Grid.Row="1"
                  Grid.Column="1"
                  Minimum="0"
                  Maximum="255"
                  ValueChanged="RgbSliderValueChanged"
                  VerticalAlignment="Center" />
          <TextBlock x:Name="GreenValueText"
                     Grid.Row="1"
                     Grid.Column="2"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     FontFamily="{StaticResource CodeFontFamily}" />

          <TextBlock Grid.Row="2" Text="B" Foreground="#79C0FF" FontWeight="Bold" VerticalAlignment="Center" />
          <Slider x:Name="BlueSlider"
                  Grid.Row="2"
                  Grid.Column="1"
                  Minimum="0"
                  Maximum="255"
                  ValueChanged="RgbSliderValueChanged"
                  VerticalAlignment="Center" />
          <TextBlock x:Name="BlueValueText"
                     Grid.Row="2"
                     Grid.Column="2"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     FontFamily="{StaticResource CodeFontFamily}" />
        </Grid>

        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Content="CANCEL"
                  Click="CancelClick"
                  Padding="12,8"
                  Margin="0,0,5,0"
                  IsCancel="True" />
          <Button Grid.Column="1"
                  Content="USE"
                  Click="UseColorClick"
                  Padding="12,8"
                  Margin="5,0,0,0"
                  Background="{StaticResource SecondaryHoverBrush}"
                  IsDefault="True" />
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>
