<Window x:Class="Hypershell.HyperpageAssetImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asset"
        Width="440"
        Height="300"
        MinWidth="380"
        MinHeight="270"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}"
        Foreground="{StaticResource ForegroundBrush}">
  <Border Background="{StaticResource PanelBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="10"
          ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
        <RowDefinition Height="58" />
      </Grid.RowDefinitions>

      <Border Background="{StaticResource AppBackgroundBrush}"
              MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
        <Grid Margin="16,0,8,0">
          <TextBlock Text="Asset"
                     FontSize="17"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <Button HorizontalAlignment="Right"
                  Click="CancelClick"
                  Style="{StaticResource HeaderIconButtonStyle}"
                  Width="34"
                  Height="34"
                  AutomationProperties.Name="Cancel"
                  ToolTip="Cancel">
            <Path Data="M 3 3 L 13 13 M 13 3 L 3 13"
                  Stroke="{StaticResource ForegroundBrush}"
                  StrokeThickness="1.5" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="18,14,18,10">
        <TextBlock Text="Name" FontWeight="SemiBold" />
        <TextBox x:Name="AssetNameTextBox"
                 Margin="0,5,0,12"
                 MaxLength="120"
                 ToolTip="Asset name" />
        <TextBlock Text="Alt" FontWeight="SemiBold" />
        <TextBox x:Name="AltTextBox"
                 Margin="0,5,0,0"
                 MinHeight="62"
                 MaxLength="500"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 ToolTip="Alt text" />
      </StackPanel>

      <Grid Grid.Row="2" Margin="18,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText"
                   Foreground="{StaticResource AttentionBrush}"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Content="Cancel"
                Click="CancelClick"
                Margin="0,0,8,0"
                MinWidth="78" />
        <Button Grid.Column="2"
                Content="Import"
                Click="ImportClick"
                MinWidth="78"
                Background="{StaticResource AccentHoverBrush}" />
      </Grid>
    </Grid>
  </Border>
</Window>
