<Window x:Class="Hypershell.HyperpageTemplateCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Template"
        Width="720"
        Height="720"
        MinWidth="600"
        MinHeight="590"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}"
        Foreground="{StaticResource ForegroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Border Background="{StaticResource PanelBrush}"
          BorderBrush="#2E5D86"
          BorderThickness="1"
          CornerRadius="10"
          ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.58" Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="*" />
        <RowDefinition Height="70" />
      </Grid.RowDefinitions>

      <Border Background="#10151B"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
        <Grid Margin="18,0,9,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="8"
                  Background="{StaticResource SecondaryTintBrush}"
                  BorderBrush="{StaticResource SecondaryBrush}"
                  BorderThickness="1"
                  Margin="0,0,12,0">
            <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons"
                       FontSize="18" Foreground="{StaticResource SecondaryVividBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Template" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Choose source"
                       FontSize="11" Foreground="{StaticResource MutedForegroundBrush}" />
          </StackPanel>
          <Button Grid.Column="2" Click="CloseClick"
                  Style="{StaticResource HeaderIconButtonStyle}"
                  Width="36" Height="36"
                  AutomationProperties.Name="Close template creation"
                  ToolTip="Close">
            <Path Data="M 3 3 L 13 13 M 13 3 L 3 13"
                  Stroke="{StaticResource ForegroundBrush}" StrokeThickness="1.5" />
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,18">
          <TextBlock Text="CREATE FROM" FontSize="10" FontWeight="Bold"
                     Foreground="{StaticResource SecondaryVividBrush}" />
          <ComboBox x:Name="SourceComboBox"
                    Margin="0,5,0,14"
                    MinHeight="36"
                    ItemsSource="{Binding SourceOptions}"
                    DisplayMemberPath="Name"
                    SelectionChanged="SourceSelectionChanged"
                    ToolTip="Template source" />

          <Grid x:Name="DetailsPanel" Margin="0,0,0,14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
              <TextBlock Text="TEMPLATE NAME" FontSize="10" FontWeight="Bold"
                         Foreground="{StaticResource SecondaryVividBrush}" />
              <TextBox x:Name="TemplateNameTextBox" MinHeight="36" Margin="0,5,0,0"
                       Text="New template" ToolTip="Template name" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="LIBRARY" FontSize="10" FontWeight="Bold"
                         Foreground="{StaticResource SecondaryVividBrush}" />
              <ComboBox x:Name="LibraryComboBox" MinHeight="36" Margin="0,5,0,0"
                        ItemsSource="{Binding LibraryOptions}"
                        DisplayMemberPath="Name"
                        ToolTip="Template library" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,13,0,0">
              <TextBlock Text="DESCRIPTION" FontSize="10" FontWeight="Bold"
                         Foreground="{StaticResource SecondaryVividBrush}" />
              <TextBox x:Name="DescriptionTextBox" MinHeight="58" Margin="0,5,0,0"
                       AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       ToolTip="Template description" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,13,0,0">
              <TextBlock Text="TEMPLATE TYPE" FontSize="10" FontWeight="Bold"
                         Foreground="{StaticResource SecondaryVividBrush}" />
              <ComboBox x:Name="ScopeComboBox" MinHeight="36" Margin="0,5,0,0"
                        ItemsSource="{Binding ScopeOptions}"
                        DisplayMemberPath="Name"
                        ToolTip="Template type" />
            </StackPanel>
          </Grid>

          <TextBlock x:Name="InputLabel" Text="CODE" FontSize="10" FontWeight="Bold"
                     Foreground="{StaticResource SecondaryVividBrush}" />
          <TextBox x:Name="InputTextBox"
                   MinHeight="150"
                   MaxHeight="260"
                   Margin="0,5,0,14"
                   Padding="9"
                   AcceptsReturn="True"
                   AcceptsTab="True"
                   TextWrapping="NoWrap"
                   FontFamily="{StaticResource CodeFontFamily}"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   AutomationProperties.Name="Template source"
                   ToolTip="Template source" />

          <TextBlock x:Name="OutputLabel" Text="CONVERTED OUTPUT" FontSize="10" FontWeight="Bold"
                     Foreground="{StaticResource SecondaryVividBrush}" />
          <TextBox x:Name="OutputTextBox"
                   MinHeight="145"
                   MaxHeight="300"
                   Margin="0,5,0,0"
                   Padding="9"
                   AcceptsReturn="True"
                   AcceptsTab="True"
                   TextWrapping="NoWrap"
                   FontFamily="{StaticResource CodeFontFamily}"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   AutomationProperties.Name="Converted template output"
                   ToolTip="Converted output" />
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2"
              Background="#10151B"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,1,0,0">
        <Grid Margin="18,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText"
                     Foreground="{StaticResource MutedForegroundBrush}"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Margin="0,0,12,0" />
          <Button Grid.Column="1"
                  Content="Close"
                  Click="CloseClick"
                  MinWidth="82"
                  Margin="0,0,8,0"
                  ToolTip="Close" />
          <Button x:Name="AnalyzeButton" Grid.Column="2"
                  Content="Analyze"
                  Click="AnalyzeClick"
                  MinWidth="92"
                  Margin="0,0,8,0"
                  ToolTip="Analyze template" />
          <Button x:Name="CreateButton" Grid.Column="3"
                  Content="Create"
                  Click="CreateClick"
                  MinWidth="102"
                  Background="{StaticResource AccentHoverBrush}"
                  BorderBrush="{StaticResource AccentBrush}"
                  FontWeight="SemiBold"
                  ToolTip="Create template" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
