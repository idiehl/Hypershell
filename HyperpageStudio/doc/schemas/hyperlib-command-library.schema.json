{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hypershell:schema:hyperlib-command-library:1",
  "title": "Hypershell Hyperlib command and guide library",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "id",
    "displayName",
    "description",
    "language",
    "kind",
    "isExecutionSupported",
    "createStandaloneProfile",
    "executionTarget",
    "commands"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentVersion": { "$ref": "#/$defs/semanticVersion" },
    "id": { "$ref": "#/$defs/localId" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "language": { "type": "string", "minLength": 1, "maxLength": 80 },
    "category": { "type": "string", "maxLength": 120 },
    "kind": {
      "enum": ["Content", "Language", "Module", "Package", "Extension"]
    },
    "parentLibraryId": { "type": "string", "maxLength": 128 },
    "frameworkName": { "type": "string", "maxLength": 120 },
    "frameworkVersion": { "type": "string", "maxLength": 80 },
    "targetFramework": { "type": "string", "maxLength": 80 },
    "isExecutionSupported": { "type": "boolean" },
    "executionSupportMessage": { "type": "string", "maxLength": 500 },
    "referenceAssemblyCount": { "type": "integer", "minimum": 0 },
    "isStarterLibrary": { "type": "boolean" },
    "createStandaloneProfile": { "type": "boolean" },
    "keywords": { "$ref": "#/$defs/stringSet" },
    "executionTarget": { "enum": ["PowerShell", "CSharp", "External"] },
    "actionDescriptions": { "$ref": "#/$defs/textMap" },
    "objectDescriptions": { "$ref": "#/$defs/textMap" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/command" }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "localId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]+$"
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "textMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "displayName", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "placeholder": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "typeName": { "type": "string", "maxLength": 160 },
        "defaultValue": { "type": "string", "maxLength": 1000 },
        "isRequired": { "type": "boolean" },
        "isSwitch": { "type": "boolean" },
        "includeByDefault": { "type": "boolean" }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "code", "explanation"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "code": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 6000 },
        "imagePath": { "$ref": "#/$defs/relativePath" },
        "imageAltText": { "type": "string", "maxLength": 500 }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "displayName",
        "description",
        "definition",
        "template",
        "examples"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "definition": { "type": "string", "minLength": 1, "maxLength": 6000 },
        "moduleName": { "type": "string", "maxLength": 160 },
        "commandType": { "type": "string", "maxLength": 80 },
        "preferredShellKind": {
          "enum": [
            "PowerShell",
            "WindowsPowerShell",
            "CommandPrompt",
            "WslBash",
            "GitBash",
            "Python",
            "NodeJs",
            "TypeScript",
            "Java",
            "CSharp",
            "DockerCli",
            "DockerContainer",
            "MySql",
            "DeveloperPowerShell",
            "AzureCloudShell",
            "External"
          ]
        },
        "action": { "type": "string", "maxLength": 120 },
        "actionDescription": { "type": "string", "maxLength": 2000 },
        "object": { "type": "string", "maxLength": 120 },
        "objectDescription": { "type": "string", "maxLength": 2000 },
        "namespaceName": { "type": "string", "maxLength": 300 },
        "typeName": { "type": "string", "maxLength": 300 },
        "memberName": { "type": "string", "maxLength": 300 },
        "memberKind": { "type": "string", "maxLength": 120 },
        "overloadSignature": { "type": "string", "maxLength": 1000 },
        "documentationUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 500
        },
        "keywords": { "$ref": "#/$defs/stringSet" },
        "template": { "type": "string", "minLength": 1, "maxLength": 6000 },
        "compositionMode": { "enum": ["Auto", "Pipeline", "Statement"] },
        "parameters": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/parameter" }
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/example" }
        }
      }
    }
  }
}
