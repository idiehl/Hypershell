{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypershell.dev/schemas/hyperlib-command-guide-shard-v2.schema.json",
  "title": "Hyperlib command guide shard v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "libraryId", "guides"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "libraryId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "guides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entryId", "definition", "parameters", "examples"],
        "properties": {
          "entryId": { "type": "string", "minLength": 1, "maxLength": 240 },
          "definition": { "type": "string", "minLength": 1, "maxLength": 6000 },
          "parameters": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "hyperlib-command-library-v2.schema.json#/$defs/parameter"
            }
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "$ref": "hyperlib-command-library-v2.schema.json#/$defs/example"
            }
          }
        }
      }
    }
  }
}
